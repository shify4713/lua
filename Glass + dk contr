local function updateDynamicUI(flow)
    text(12, 5, string.format("%-9s", formatNum(lastE)), C.TEXT_WHITE)
    text(12, 6, string.format("%-9s", formatNum(cfg.target)), C.TEXT_MAIN)
    text(12, 7, string.format("%-9s", formatNum(filVal)), C.TEXT_DIM)
    text(3, h - 2, string.format("OUT: %s RF/t", formatNum(flow)), C.TEXT_MAIN)
    
    local maxE = (rf and rf.getMaxEnergyStored and rf.getMaxEnergyStored()) or 1
    local pct = clamp(maxE > 0 and (lastE / maxE) or 0, 0, 1)
    local barX, barY, barH = col1_w - 3, 9, h - 17
    local fillLines = math.floor(pct * barH)
    if pct > 0 and fillLines == 0 then fillLines = 1 end
    local emptyLines = barH - fillLines
    if emptyLines > 0 then gpu.setBackground(C.FRAME_DIM); gpu.fill(barX, barY, 2, emptyLines, " ") end
    if fillLines > 0 then gpu.setBackground(C.TEXT_MAIN); gpu.fill(barX, barY + emptyLines, 2, fillLines, " ") end
    gpu.setBackground(C.BG)

    if chatUpdated then
        local cx = col1_w + 4
        gpu.setBackground(C.BG); gpu.fill(cx, 4, col2_w - 4, h - 5, " ")
        for i, line in ipairs(chatLog) do drawColoredText(cx, 3 + i, line, C.TEXT_WHITE) end
        chatUpdated = false
    end
    
    local rx = col1_w + col2_w + 5
    local ry = 5
    text(rx, ry, "SCAN COMPLETE.", C.TEXT_DIM)
    text(rx, ry + 2, "CONTACTS IN RANGE: " .. #nearbyPlayers, C.TEXT_WHITE)
    for i=1, 5 do
        if nearbyPlayers[i] then text(rx, ry + 3 + i, "> " .. string.sub(nearbyPlayers[i], 1, 24), C.ALERT)
        else text(rx, ry + 3 + i, string.rep(" ", 24), C.BG) end
    end
    
    local my = math.floor(h/2) + 5
    local meStatus = me and "LINKED" or "OFFLINE"
    text(rx, my, "ADAPTER: " .. meStatus, me and C.OK or C.ALERT)
    text(rx, my + 2, "TRACKING: VIS", C.TEXT_DIM)
    text(rx, my + 4, "Храниться: " .. formatNum(matter_current), C.TEXT_WHITE)
    local rateSign = matter_rate >= 0 and "+" or ""
    local rateColor = matter_rate > 0 and C.OK or (matter_rate < 0 and C.ALERT or C.TEXT_WHITE)
    -- На мониторе тоже меняем на /min
    text(rx, my + 6, string.format("STATUS: %s%s / min", rateSign, formatNum(matter_rate)), rateColor)
    
    local sx = w - col4_w + 3
    local bridgeStatus = ar_error and "API ERROR" or (opb and "LINKED" or "OFFLINE")
    text(sx, 5, "AR BRIDGE: " .. bridgeStatus, ar_error and C.ALERT or (opb and C.OK or C.TEXT_DIM))
    
    drawButton("tog_chat", sx, 7, 12, 1, cfg.ar_chat_enabled and "[CHT:ON]" or "[CHT:OFF]",
        cfg.ar_chat_enabled and C.BTN_ON or C.BTN_OFF, cfg.ar_chat_enabled and C.TEXT_MAIN or C.TEXT_DIM)
    drawButton("tog_radar", sx + 14, 7, 12, 1, cfg.ar_radar_enabled and "[RDR:ON]" or "[RDR:OFF]",
        cfg.ar_radar_enabled and C.BTN_ON or C.BTN_OFF, cfg.ar_radar_enabled and C.ALERT or C.TEXT_DIM)
    drawButton("tog_me", sx, 9, 12, 1, cfg.ar_me_enabled and "[ ME:ON]" or "[ ME:OFF]",
        cfg.ar_me_enabled and C.BTN_ON or C.BTN_OFF, cfg.ar_me_enabled and C.OK or C.TEXT_DIM)

    if tick_counter % 2 == 0 then
        local bin = string.format("%04X-%04X", math.random(0, 65535), math.random(0, 65535))
        text(sx, h - 4, "SYS TICK: " .. bin, C.TEXT_DIM)
        text(sx, h - 3, "CPU LOAD: " .. math.random(12, 34) .. "%", C.TEXT_DIM)
    end
end

