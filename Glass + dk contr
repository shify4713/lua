local lastStats, lastScan = 0, 0
gpu.setResolution(w, h); gpu.setBackground(C.BG); gpu.fill(1, 1, w, h, " ")

while true do
    local ev, addr, arg1, arg2, arg3, arg4 = event.pull(0.5)
    if ev == "chat_message" then addChatMessage(arg1, arg2)
    elseif ev == "touch" then
        local x, y = arg1, arg2
        if showFlowMenu then
            local b = buttons
            if b["f_close"] and x >= b["f_close"].x and x < b["f_close"].x + b["f_close"].w and y == b["f_close"].y then
                showFlowMenu = false; needFullRedraw = true
            elseif b["f_minus10m"] and x >= b["f_minus10m"].x and x < b["f_minus10m"].x + b["f_minus10m"].w and y == b["f_minus10m"].y then
                cfg.flowMax = clamp(cfg.flowMax - 10000000, cfg.flowMin, 40000000)
            elseif b["f_minus1m"] and x >= b["f_minus1m"].x and x < b["f_minus1m"].x + b["f_minus1m"].w and y == b["f_minus1m"].y then
                cfg.flowMax = clamp(cfg.flowMax - 1000000, cfg.flowMin, 40000000)
            elseif b["f_plus1m"] and x >= b["f_plus1m"].x and x < b["f_plus1m"].x + b["f_plus1m"].w and y == b["f_plus1m"].y then
                cfg.flowMax = clamp(cfg.flowMax + 1000000, cfg.flowMin, 40000000)
            elseif b["f_plus10m"] and x >= b["f_plus10m"].x and x < b["f_plus10m"].x + b["f_plus10m"].w and y == b["f_plus10m"].y then
                cfg.flowMax = clamp(cfg.flowMax + 10000000, cfg.flowMin, 40000000)
            end
            if showFlowMenu then drawFlowMenu() end
        else
            local b = buttons
            if b["tplus"] and x >= b["tplus"].x and x < b["tplus"].x + b["tplus"].w and y == b["tplus"].y then
                local step = keyboard.isShiftDown() and (100 * 10^9) or (keyboard.isControlDown() and (50 * 10^9) or 10^9)
                cfg.target = cfg.target + step
            elseif b["tminus"] and x >= b["tminus"].x and x < b["tminus"].x + b["tminus"].w and y == b["tminus"].y then
                local step = keyboard.isShiftDown() and (100 * 10^9) or (keyboard.isControlDown() and (50 * 10^9) or 10^9)
                cfg.target = math.max(0, cfg.target - step)
            elseif b["flowcfg"] and x >= b["flowcfg"].x and x < b["flowcfg"].x + b["flowcfg"].w and y == b["flowcfg"].y then
                showFlowMenu = true; drawFlowMenu()
            elseif b["tog_chat"] and x >= b["tog_chat"].x and x < b["tog_chat"].x + b["tog_chat"].w and y == b["tog_chat"].y then
                cfg.ar_chat_enabled = not cfg.ar_chat_enabled; updateAR()
            elseif b["tog_radar"] and x >= b["tog_radar"].x and x < b["tog_radar"].x + b["tog_radar"].w and y == b["tog_radar"].y then
                cfg.ar_radar_enabled = not cfg.ar_radar_enabled; updateAR()
            elseif b["tog_me"] and x >= b["tog_me"].x and x < b["tog_me"].x + b["tog_me"].w and y == b["tog_me"].y then
                cfg.ar_me_enabled = not cfg.ar_me_enabled; updateAR()
            end
        end
        lastStats = 0
    end

    local now = computer.uptime()
    if now - lastScan >= 2 then
        scanEnvironment(); lastScan = now
    end

    if now - lastStats >= 1 then
        tick_counter = tick_counter + 1
        if rf and gate then
            local cur = rf.getEnergyStored()
            currentFlow = gate.getFlow() or 0
            filVal = filVal + ((cur - lastE) - filVal) * 0.3
            local desired = currentFlow
            if cur > cfg.target then
                if filVal > -cfg.maxDiff then desired = currentFlow + cfg.step end
            else
                if filVal < cfg.maxDiff and currentFlow > cfg.flowMin then desired = currentFlow - cfg.step end
            end
            desired = clamp(desired, cfg.flowMin, cfg.flowMax)
            if desired ~= currentFlow then pcall(gate.setSignalLowFlow, desired) end
            lastE = cur
        end
        matter_current = fetchMatterAmount()
        if now - me_timer >= 10 then
            if me_timer > 0 then
                -- Логика: (разница за 10 сек) * 6 = результат за 60 секунд (минуту)
                matter_rate = (matter_current - matter_last) * 6
            end
            matter_last = matter_current
            me_timer = now
            updateAR()
        end
        if needFullRedraw then drawStaticUI() end
        if not showFlowMenu then updateDynamicUI(currentFlow) end
        lastStats = now
    end
end
