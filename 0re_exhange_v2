        lastStatusUpdate = currentTime
    end
end

local function find_ore(stack)
    if not stack then return nil end
    for _,v in ipairs(items) do
        if stack.id == v.oreId and tostring(stack.dmg or stack.damage or 0) == v.oreDmg then
            return v
        end
    end
    return nil
end

-- УЛУЧШЕННАЯ: Безопасное сохранение адаптеров
local function save_adapters()
    local data = {}
    for k, v in pairs(adapters) do
        if v and v.address then
            data[k] = v.address
        end
    end
    
    -- Создаем папку если не существует
    local path = fs.path(save_file)
    if path and path ~= "" and not fs.exists(path) then
        fs.makeDirectory(path)
    end
    
    local serialized = ser.serialize(data)
    local file = io.open(save_file, "w")
    if file then
        file:write(serialized)
        file:close()
        add_log("Адаптеры сохранены в " .. save_file, COLOR_OK)
    else
        add_log("Ошибка сохранения адаптеров!", COLOR_ERROR)
    end
end

-- УЛУЧШЕННАЯ: Безопасная загрузка адаптеров с автовыбором
local function load_adapters()
    if fs.exists(save_file) then
        local file = io.open(save_file, "r")
        if file then
            local content = file:read("*a")
            file:close()
            
            local success, data = pcall(ser.unserialize, content)
            if success and type(data) == "table" then
                local loaded = false
                for k, v in pairs(data) do
                    if com.isAvailable(v) then
                        adapters[k] = com.proxy(v)
                        add_log("Загружен адаптер: " .. k .. " (" .. v:sub(1, 8) .. ")", COLOR_OK)
                        loaded = true
                    else
                        add_log("Адаптер " .. k .. " недоступен, адрес: " .. (v:sub(1, 8) or "?"), COLOR_ALERT)
                        adapters[k] = nil -- Сбрасываем если недоступен
                    end
                end
                if loaded then
                    return true -- Адаптеры загружены успешно
                end
            else
                add_log("Ошибка чтения файла адаптеров", COLOR_ALERT)
            end
        end
    else
        add_log("Файл адаптеров не найден, будет создан новый", COLOR_ALERT)
    end
    return false -- Адаптеры не загружены
end

-- НОВАЯ: Оптимизированная проверка буфера
local function is_buffer_full()
    if not adapters.buffer then return false end
    local bufSize = adapters.buffer.getInventorySize()
    if not bufSize or bufSize <= 0 then return false end
    
    for slot = 1, bufSize do
        local stack = adapters.buffer.getStackInSlot(slot)
        if not stack then
            return false
        end
    end
    return true
end

-- НОВАЯ: Оптимизированная функция обмена с предварительными проверками
local function give_items_with_logs(ore, qty)
    if not are_adapters_available() then
        add_log("Ошибка: отсутствуют необходимые компоненты", COLOR_ERROR)
        return false
    end
    
    local give = math.floor(tonumber(ore.count) * qty)
    if give <= 0 then
        add_log("Ошибка: некорректное количество для обмена", COLOR_ERROR)
        return false
    end
    
    -- Проверяем наличие предметов в системе (используем кэш)
    local status = get_item_status(ore)
    if not status.available or status.quantity < give then
        return false -- Не логируем сообщение о недостатке
    end
    
    -- Выполняем обмен с защитой от ошибок
    local success, result = pcall(function()
        db.clear(1)
        adapters.interface.store({name = ore.productId, damage = tonumber(ore.productDmg)}, db.address, 1)
        adapters.interface.setInterfaceConfiguration(1, db.address, 1, give)
        
        local left = give
        local maxTries = 50 -- Уменьшили количество попыток
        local tries = 0
        
        while left > 0 and tries < maxTries do
            if is_buffer_full() then
                -- Буфер полон, отменяем операцию
                error("Буфер полон, невозможно выдать предметы")
            else
                local given = adapters.interface.pushItem("UP", 1, left)
                if given and given > 0 then
                    left = left - given
                    tries = 0
                else
                    tries = tries + 1
                    os.sleep(0.1) -- Уменьшили задержку
                end
            end
        end
        
        if left > 0 then
            error(string.format("Не удалось выдать все предметы (осталось %d)", left))
        end
        
        adapters.interface.setInterfaceConfiguration(1, db.address, 1, 0)
        return true
    end)
    
    if success and result then
        add_log(string.format("Обмен: %dx %s → %dx %s", 
            qty, ore.displayNameOre, give, ore.displayNameProduct), COLOR_OK)
        stats.exchanged[ore.displayNameOre] = (stats.exchanged[ore.displayNameOre] or 0) + qty
        
        -- Обновляем кэш статусов
        local key = ore.productId .. ":" .. ore.productDmg
        if itemStatusCache[key] then
            itemStatusCache[key].quantity = itemStatusCache[key].quantity - give
            itemStatusCache[key].available = itemStatusCache[key].quantity >= tonumber(ore.count)
        end
        
        needRedrawMain = true -- Обновляем статусы после обмена
        return true
    else
        add_log("Ошибка при обмене: " .. tostring(result), COLOR_ERROR)
        -- Пытаемся очистить конфигурацию в случае ошибки
        pcall(function() adapters.interface.setInterfaceConfiguration(1, db.address, 1, 0) end)
        return false
    end
end

-- УЛУЧШЕННАЯ: Функция выбора адаптера с сохранением
local function drawChooseAdapter(kind, ctype, title, exclude_address)
    gpu.setBackground(COLOR_BG)
    gpu.fill(1,1,w,h," ")
    gpu.setForeground(COLOR_HEADER)
    gpu.set(5, 2, title)
    local currY = 4
    local options = {}
    
    for address, t in com.list(ctype) do
        if not exclude_address or address ~= exclude_address then
            local showtype = tostring(t)
            local short_address = address:sub(1,8)
            local label = string.format("%s [%s]", short_address, showtype)
            gpu.setForeground(COLOR_TEXT)
            gpu.set(5, currY, label)
            options[#options+1] = {x1=5, y1=currY, x2=5+unicode.len(label)-1, y2=currY, address=address}
            currY = currY + 2
        end
    end
    
    if #options == 0 then
        gpu.setForeground(COLOR_ERROR)
        gpu.set(5, currY+2, "Нет доступных устройств типа "..ctype)
        os.sleep(2)
        return drawChooseAdapter(kind, ctype, title, exclude_address)
    end
    
    while true do
        local _,_,x,y = event.pull("touch")
        for _, opt in ipairs(options) do
            if x >= opt.x1 and x <= opt.x2 and y == opt.y1 then
                adapters[kind] = com.proxy(opt.address)
                save_adapters() -- Сохраняем после выбора
                needRedrawMain = true -- Обновляем экран
                return true
            end
        end
    end
end

-- Функция проверки и инициализации недостающих адаптеров
local function init_missing_adapters()
    local adapter_types = {
        buffer = {type = "crystal", name = "буфер (crystal сундук)"},
        check = {type = "diamond", name = "проверочный (diamond сундук)"},
        interface = {type = "me_interface", name = "ME интерфейс"}
    }
    
    local missing = false
    for k, info in pairs(adapter_types) do
        if not adapters[k] or not adapters[k].address then
            missing = true
            if not drawChooseAdapter(k, info.type, "Выберите " .. info.name) then
                add_log("Не удалось выбрать адаптер: " .. k, COLOR_ERROR)
                return false
            end
        end
    end
    
    if missing then
        needRedrawMain = true -- Обновляем экран после выбора адаптеров
    end
    
    return true
end

-- Безопасное получение стака
local function safe_get_stack(adapter, slot)
    if not adapter or not adapter.getStackInSlot then
        return nil
    end
    local success, stack = pcall(adapter.getStackInSlot, slot)
    if success then
        return stack
    else
        return nil
    end
end

-- НОВАЯ: Оптимизированная обработка буфера - НЕ берем руду если нет ресурсов
local function process_buffer()
    if not adapters.buffer or not adapters.check or not adapters.interface then
        return false
    end
    
    local eventHappened = false
    local bufSize = adapters.buffer.getInventorySize()
    if not bufSize or bufSize <= 0 then return false end
    
    -- Обновляем кэш статусов перед обработкой
    update_item_status_cache()
    
    for slot = 1, bufSize do
        local stack = safe_get_stack(adapters.buffer, slot)
        if stack then
            local ore = find_ore(stack)
            if ore then
                local qty = stack.qty or stack.size or stack.count or 1
                if qty > 0 then
                    -- Проверяем наличие ресурсов ДО перемещения
                    if check_resources_available(ore, qty) then
                        -- Проверяем, не полон ли буфер на приемной стороне
                        local checkSize = adapters.check.getInventorySize()
                        local checkFree = false
                        if checkSize then
                            for checkSlot = 1, checkSize do
                                local checkStack = safe_get_stack(adapters.check, checkSlot)
                                if not checkStack then
                                    checkFree = true
                                    break
                                end
                            end
                        end
                        
                        if checkFree then
                            local pushed = adapters.buffer.pushItem("DOWN", slot, qty)
                            if pushed and pushed > 0 then
                                eventHappened = true
                                add_log(string.format("Перемещено в обработку: %dx %s", qty, ore.displayNameOre), COLOR_OK)
                            end
                        else
                            -- Проверочный сундук полон, не перемещаем
                            add_log("Проверочный сундук полон, ожидание...", COLOR_ALERT)
                        end
                    end
                    -- Если ресурсов нет - просто ничего не делаем (не логируем, не перемещаем)
                end
            end
        end
    end
    
    return eventHappened
end

-- НОВАЯ: Оптимизированная обработка проверочного сундука
local function process_check_chest()
    if not adapters.check or not adapters.interface or not adapters.buffer then
        return false
    end
    
    local eventHappened = false
    local checkSize = adapters.check.getInventorySize()
    if not checkSize or checkSize <= 0 then return false end
    
    for slot = 1, checkSize do
        local stack = safe_get_stack(adapters.check, slot)
        if stack then
            local ore = find_ore(stack)
            local qty = stack.qty or stack.size or stack.count or 1
            
            if qty > 0 then
                if ore then
                    -- Двойная проверка: есть ли ресурсы
                    if check_resources_available(ore, qty) then
                        -- Пытаемся выполнить обмен
                        if give_items_with_logs(ore, qty) then
                            -- Если обмен успешен, удаляем руду из проверочного сундука
                            adapters.check.pushItem("DOWN", slot, qty)
                            eventHappened = true
                        else
                            -- Если обмен не удался, возвращаем руду в буфер
                            adapters.check.pushItem("UP", slot, qty)
                            add_log("Возвращено в буфер из-за ошибки обмена: " .. ore.displayNameOre, COLOR_ALERT)
                            eventHappened = true
                        end
                    else
                        -- Ресурсов нет, возвращаем в буфер
                        adapters.check.pushItem("UP", slot, qty)
                        eventHappened = true
                        -- Не логируем сообщение о недостатке ресурсов
                    end
                else
                    -- Неизвестный предмет - возвращаем
                    adapters.check.pushItem("UP", slot, qty)
                    local label = stack.label or stack.id or "unknown"
                    add_log(string.format("Вернул: %dx %s", qty, label), COLOR_ALERT)
                    stats.returned[label] = (stats.returned[label] or 0) + qty
                    eventHappened = true
                end
            end
        end
    end
    
    return eventHappened
end

-- Основной цикл с улучшенной безопасностью
local function main_exchange_loop()
    while true do
        -- Рисуем текущий экран
        if showTab then
            if needRedrawLogs then
                draw_logs()
            end
        else
            print_items(false) -- false = не форсируем перерисовку если не нужно
        end

        -- Обработка буфера и проверочного сундука
        local bufferEvent = process_buffer()
        local checkEvent = process_check_chest()
        
        if bufferEvent or checkEvent then
            -- Обновляем кэш статусов после событий
            update_item_status_cache()
        end

        -- Обработка событий ввода
        local ev = {event.pull(0.3)} -- Уменьшили время ожидания
        
        if ev[1] == "touch" then
            local x, y = ev[3], ev[4]
            if showTab then
                local tabList = drawLogsTabs()
                for _,tab in ipairs(tabList) do
                    if x >= tab.x1 and x <= tab.x2 and y == tab.y then
                        showTab = tab.key
                        needRedrawLogs = true
                        break
                    end
                end
                local btn = drawLogsButton()
                if x >= btn.x1 and x <= btn.x2 and y == btn.y1 then
                    showTab = nil
                    needRedrawMain = true -- Перерисовываем основной экран при выходе из логов
                end
                if showTab=="events" then
                    if y == h-3 then logScroll = logScroll + 3; needRedrawLogs = true end
                    if y == 4 then logScroll = logScroll - 3; needRedrawLogs = true end
                end
            else
                local btnText = "[Логи]"
                local btnY = h-2
                local btnX = math.floor(w/2 - unicode.len(btnText)/2)
                if x >= btnX and x <= btnX+unicode.len(btnText)-1 and y == btnY then
                    showTab = "events"
                    needRedrawLogs = true
                end
            end
        elseif ev[1] == "scroll" and showTab=="events" then
            local _, _, _, y, dir = table.unpack(ev)
            if dir < 0 then logScroll = logScroll + 3; needRedrawLogs = true end
            if dir > 0 then logScroll = logScroll - 3; needRedrawLogs = true end
        end
    end
end

