local function flushDraw()
  local nextPrev={}
  local changed=0
  for y=1,height do
    local row=guiRowsNow[y] or {}
    local sigPieces={}
    for _,o in ipairs(row) do
      if o.k=='f' then
        sigPieces[#sigPieces+1]='f'..o.x..','..o.w..','..o.bg..';'
      else
        sigPieces[#sigPieces+1]='s'..o.x..','..o.fg..','..o.bg..','..o.txt..';'
      end
    end
    local sig=table.concat(sigPieces)
    nextPrev[y]=sig
    if guiRowsPrevious[y]~=sig then
      changed=changed+1
      gpu.setBackground(COLOR.bg)
      gpu.fill(1,y,width,1,' ')
      for _,o in ipairs(row) do
        gpu.setBackground(o.bg)
        if o.k=='f' then gpu.fill(o.x,y,o.w,1,' ')
        else gpu.setForeground(o.fg);gpu.set(o.x,y,o.txt) end
      end
    end
  end
  guiRowsPrevious=nextPrev
  return changed
end
