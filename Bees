 BeeMaster GUI v4 (Minecraft 1.7.10, OpenOS 1.6.x, Lua 5.2)
-- No fixed component addresses. Click buttons on the OC screen.
-- Exporting bees/adding labware/taking the result require confirmation.
local component = require("component")
local event = require("event")
local unicode = require("unicode")

local gpu = assert(component.gpu, "GPU not found")
local prevW, prevH = gpu.getResolution()
local prevFG, prevBG = gpu.getForeground(), gpu.getBackground()
local maxW, maxH = gpu.maxResolution()
local W, H = math.min(maxW, 90), math.min(maxH, 25)
assert(W >= 70 and H >= 25, "Need GPU/screen with at least 70x25")
gpu.setResolution(W, H)

local colors = {bg=0x101820, fg=0xE6E6E6, blue=0x5EE7E0,
  green=0x65EC89, gray=0x99A8B4, yellow=0xFFD27A, red=0xFF6E79}
local directions = {"UP", "DOWN", "NORTH", "SOUTH", "WEST", "EAST"}
local reverse = {UP="DOWN", DOWN="UP", NORTH="SOUTH", SOUTH="NORTH", WEST="EAST", EAST="WEST"}
local names = {UP="ВВЕРХ", DOWN="ВНИЗ", NORTH="СЕВЕР", SOUTH="ЮГ", WEST="ЗАПАД", EAST="ВОСТОК"}
local logPath = "/home/beemaster_v4.log"
local mes, muts, deviceInfo = {}, {}, {}
local meIndex, mutIndex, sideIndex = 1, 1, 0
local beesP, beesD, supplies = {}, {}, {}
local pIndex, dIndex, pPage, dPage = 1, 1, 1, 1
local page, awaiting, quit = "main", nil, false
local buttons = {}
local message, note, messageColor = "Поиск оборудования...", "", colors.gray
local inventoryWarnings = ""

local function shorten(value, count)
  return unicode.sub(tostring(value or ""), 1, math.max(0, count))
end
local function log(line)
  local f = io.open(logPath, "a")
  if f then f:write(tostring(line), "\n"); f:close() end
end
local function say(text, color, extra)
  message = tostring(text)
  note = tostring(extra or "")
  messageColor = color or colors.fg
  log(message .. (note ~= "" and (" | " .. note) or ""))
end
local function invoke(proxy, method, ...)
  local args = {...}
  return pcall(function()
    return proxy[method](table.unpack(args))
  end)
end
local function selectedME() return mes[meIndex] end
local function selectedMut() return muts[mutIndex] end
local function selectedSide()
  local m = selectedME()
  if not m then return nil end
  return m.sides[sideIndex]
end
local function readSlot(index)
  local m = selectedMut()
  if not m then return nil end
  local ok, item = invoke(m.proxy, "getStackInSlot", index)
  if not ok then error("Невозможно прочитать слот " .. index .. ": " .. tostring(item)) end
  if type(item) ~= "table" or next(item) == nil then return nil end
  return item
end
local function itemTitle(item)
  if not item then return "пусто" end
  local ind = type(item.individual) == "table" and item.individual or {}
  return tostring(item.label or item.display_name or ind.displayName or item.name or item.id or "?")
end
local function role(itemId)
  local id = tostring(itemId or ""):lower()
  if id:find("beeprincess", 1, true) then return "p" end
  if id:find("beedrone", 1, true) then return "d" end
  if id:find("beequeen", 1, true) then return "q" end
end
local function sideWorks(proxy, direction)
  for _, arg in ipairs({direction, direction:lower()}) do
    local ok, v = invoke(proxy, "canExport", arg)
    if ok and v == true then return arg end
  end
  return nil
end
local function identify()
  mes, muts, deviceInfo = {}, {}, {}
  for address, kind in component.list() do
    local item = {address=address, kind=kind, state=""}
    deviceInfo[#deviceInfo+1] = item
    if kind == "me_interface" or kind == "peripheral" then
      local ok, proxy = pcall(component.proxy, address)
      if not ok then
        item.state = "proxy: " .. tostring(proxy)
      elseif kind == "me_interface" then
        -- Do NOT depend on component.methods(): OpenPeripheral may expose aliases differently.
        local readOK, stacks = invoke(proxy, "getAvailableItems")
        if readOK and type(stacks) == "table" then
          local m = {address=address, proxy=proxy, data=stacks, sides={}, confirmed=0}
          mes[#mes+1] = m
          local exported = false
          for _, d in ipairs(directions) do
            local v = sideWorks(proxy, d)
            if v then
              m.sides[#m.sides+1] = {name=d, arg=v, confirmed=true}
              m.confirmed = m.confirmed + 1
              exported = true
            end
          end
          if not exported then
            -- Unknown neighbours: still allow manual selection for testing.
            for _, d in ipairs(directions) do
              m.sides[#m.sides+1] = {name=d, arg=d, confirmed=false}
            end
          end
          item.state = "МЭ OK, записей: " .. tostring(#stacks) .. ", направлений: " .. tostring(m.confirmed)
        else
          item.state = "МЭ API error: " .. tostring(stacks)
        end
      else
        local sizeOK, size = invoke(proxy, "getInventorySize")
        if sizeOK and tonumber(size) == 10 then
          local slotOK = invoke(proxy, "getStackInSlot", 1)
          if slotOK then
            muts[#muts+1] = {address=address, proxy=proxy}
            item.state = "МУТАТРОН? инвентарь 10 слотов"
          else
            item.state = "10 слотов, нет доступа к слоту 1"
          end
        elseif sizeOK then
          item.state = "Инвентарь: " .. tostring(size)
        else
          item.state = "Нет размера инвентаря"
        end
      end
    else
      item.state = "другой компонент"
    end
    log(kind .. " " .. address .. " -> " .. item.state)
  end
  table.sort(mes, function(a,b) return a.address < b.address end)
  table.sort(muts, function(a,b) return a.address < b.address end)
  if meIndex > #mes or meIndex < 1 then meIndex = 1 end
  if mutIndex > #muts or mutIndex < 1 then mutIndex = 1 end
  sideIndex = 0
  local m = selectedME()
  if m then
    if m.confirmed == 1 then sideIndex = 1 end
  end
end
local function refreshBees()
  beesP, beesD, supplies = {}, {}, {}
  local m = selectedME()
  if not m then
    say("МЭ не обнаружена. Открой ДИАГНОСТИКУ.", colors.red)
    return
  end
  local ok, entries = invoke(m.proxy, "getAvailableItems")
  if not ok or type(entries) ~= "table" then
    say("Ошибка чтения МЭ: " .. tostring(entries), colors.red)
    return
  end
  m.data = entries
  for _, entry in pairs(entries) do
    if type(entry) == "table" then
      local fp = entry.fingerprint
      if type(fp) == "table" and type(fp.id) == "string" then
        local id = fp.id:lower()
        local count = tonumber(entry.size) or 0
        if count > 0 then
          local r = role(id)
          if r == "p" then
            beesP[#beesP+1] = entry
          elseif r == "d" then
            beesD[#beesD+1] = entry
          elseif id:find("labware", 1, true) then
            supplies[#supplies+1] = entry
          end
        end
      end
    end
  end
  local function sorter(a,b)
    local ac, bc = tonumber(a.size) or 0, tonumber(b.size) or 0
    if ac ~= bc then return ac > bc end
    return tostring(a.fingerprint.nbt_hash or "") < tostring(b.fingerprint.nbt_hash or "")
  end
  table.sort(beesP, sorter)
  table.sort(beesD, sorter)
  table.sort(supplies, sorter)
  pIndex, dIndex, pPage, dPage = 1,1,1,1
  say("МЭ прочитана: " .. #beesP .. " вариантов принцесс, " .. #beesD .. " трутней", colors.green)
end
local function itemLabel(entry)
  if not entry then return "?" end
  if entry._bm_label then return entry._bm_label end
  local fp = entry.fingerprint
  local str = tostring(fp.id or "?") .. " (NBT " .. tostring(fp.nbt_hash or "нет"):sub(1,7) .. ")"
  local m = selectedME()
  if m then
    local ok, info = invoke(m.proxy, "getItemDetail", fp, false)
    if ok and type(info) == "table" then
      str = itemTitle(info)
      local ind = type(info.individual) == "table" and info.individual or {}
      if ind.ident then str = str .. " / " .. tostring(ind.ident) end
    end
  end
  entry._bm_label = str
  return str
end
local function paint(x,y,str,color)
  if x > W or y < 1 or y > H then return end
  gpu.setForeground(color or colors.fg)
  gpu.set(x, y, shorten(str, W-x+1))
end
local function bar(y,text,color)
  gpu.setBackground(colors.bg)
  gpu.fill(1,y,W,1," ")
  paint(2,y,text,color)
end
local function button(x,y,text,key,clr)
  local label = "[" .. text .. "]"
  paint(x,y,label,clr or colors.blue)
  buttons[#buttons+1] = {x=x, y=y, len=unicode.len(label), key=key}
end
local function listing(rows, pageNumber, current, baseY)
  for k=1,5 do
    local idx = (pageNumber-1)*5+k
    local v=rows[idx]
    if v then
      local qty = tonumber(v.size) or 0
      local str = (current == idx and "> " or "  ") .. idx .. ". " ..
        shorten(itemLabel(v), W-24) .. "  x" .. qty
      paint(2,baseY+k-1,str,current==idx and colors.green or colors.fg)
    end
  end
end
