function BIOME.allUpgrades(api)
  local ret,emulations={},{}
  local emuCount=0
  for i=3,6 do
    local x=stack(api.p,i)
    if x then
      local id=norm(itemid(x))
      local dmg=tonumber(x.damage or x.dmg)
      ret[#ret+1]=(UPGRADES[dmg] or title(x))..' x'..math.max(1,qty(x))
      if dmg and BIOME.emulations[dmg] then
        local emu=BIOME.emulations[dmg]
        if not emulations[emu] then emuCount=emuCount+1 end
        emulations[emu]=true
      end
    end
  end
  return ret,emulations,emuCount
end

local function scanApiaries()
  missed={}
  for i,api in ipairs(devices.api) do
    local ups,emus,c=BIOME.allUpgrades(api)
    api.upgrades=ups
    api.emulations=emus
    api.emulationCount=c
    api.queen=stack(api.p,1)
    api.drone=stack(api.p,2)
    if c>1 then
      missed[#missed+1]='Пасека '..i..': НЕСКОЛЬКО ЭМУЛЯЦИЙ, выбери одну'
    end
  end
  for _,m in ipairs(graph) do
    if type(m.conditions)=='table' and next(m.conditions) then
      local info=serialization.serialize(m.conditions)
      if info and #info>0 then
        missed[#missed+1]='Условие мутации: '..m.result..' '..info:sub(1,45)
        if #missed>=25 then break end
      end
    end
  end
end

function BIOME.climate(uid)
  if type(uid)~='string' or uid=='' then return nil,nil,'нет UID вида' end
  if BIOME.overrides[uid] then
    local v=BIOME.overrides[uid]
    return v[1],v[2],'ручное правило'
  end
  local sp=catalog[uid]
  if sp then
    for _,entry in ipairs(sp.entries or {}) do
      local ind=entry.detail and entry.detail.individual
      local species=ind and ind.active and ind.active.species
      if type(species)=='table' and species.temperature and species.humidity then
        local temp=norm(species.temperature):upper()
        local hum=norm(species.humidity):upper()
        if ({HELLISH=true,HOT=true,WARM=true,NORMAL=true,COLD=true,ICY=true})[temp] and ({ARID=true,NORMAL=true,DAMP=true})[hum] then return temp,hum,'геном Forestry' end
      end
    end
  end
  local key=norm(uid)
  local extra=key:match('^extrabees%.species%.?([%w_]+)$')
  if extra and EXTRA_SPECIES[extra] then
    local t=EXTRA_SPECIES[extra]
    return t[1],t[2],'Extra Bees 1.7.10'
  end
  local native=key:match('^forestry%.species%.?([%w_]+)$')
  if native and FORESTRY_CLIMATES[native] then
    local t=FORESTRY_CLIMATES[native]
    return t[1],t[2],'Forestry 1.7.10'
  end
  return nil,nil,'вид не изучен / нет данных в реестре'
end

function BIOME.classify(t,h)
  if not t or not h then return 'unknown' end
  if t=='HELLISH' and h=='ARID' then return 'hell' end
  if t=='HOT' and h=='ARID' then return 'desert' end
  if t=='WARM' and h=='DAMP' then return 'jungle' end
  if (t=='COLD' or t=='ICY') and h=='NORMAL' then return 'winter' end
  if t=='NORMAL' and h=='NORMAL' then return 'normal' end
  if t=='NORMAL' and h=='DAMP' then return 'damp' end
  return 'unknown'
end

function BIOME.needed(task)
  return (task.kind=='stone' and task.source) or task.uid
end

function phenotypeClimate(task)
  local worker=BIOME.needed(task)
  local t,h,source=BIOME.climate(worker)
  local bee=(catalog[worker] or {}).name or worker
  return t,h,source,bee
end

function actualClimate(api)
  if not api.emulations then return nil,nil,'Улучшения не прочитаны' end
  local id
  for emu in pairs(api.emulations) do
    if id then return nil,nil,'Несколько эмуляций: условия неоднозначны' end
    id=emu
  end
  if id=='hell' then return 'HELLISH','ARID',id end
  if id=='desert' then return 'HOT','ARID',id end
  if id=='jungle' then return 'WARM','DAMP',id end
  if id=='winter' then return 'COLD','NORMAL',id end
  if id=='ocean' then return 'NORMAL','NORMAL',id end
  if id=='plains' then return 'NORMAL','NORMAL',id end
  return CFG.baseApiaryTemp,CFG.baseApiaryHumidity,'base'
end

function readTolerance(task)
  local worker=BIOME.needed(task)
  local e=task.queen or task.p
  local ind=e and e.detail and e.detail.individual
  if not ind or ind.ident~=worker then return nil,nil end
  local active=ind.active
  if type(active)~='table' then return nil,nil end
  return active.temperatureTolerance,active.humidityTolerance
end

function tolRange(value)
  local s=norm(value):upper():gsub('[ -]','_')
  if s=='' or s=='NONE' or s=='NO_TOLERANCE' then return 0,0 end
  local n=tonumber(s:match('(%d+)')) or 0
  if s:find('BOTH',1,true) then return n,n end
  if s:find('UP',1,true) then return 0,n end
  if s:find('DOWN',1,true) then return n,0 end
  return 0,0
end

function BIOME.ok(task,api)
  if not CFG.strictSpecialBiomes then return true end
  local temp,hum,source,bee=phenotypeClimate(task)
  if not temp or not hum then
    return false,'НЕИЗВЕСТЕН КЛИМАТ: '..bee..' ('..tostring(source)..')'
  end
  local atm,ahm,id=actualClimate(api)
  if not atm then return false,'Нельзя определить климат пасеки: '..tostring(id) end
  local target=BIOME.classify(temp,hum)
  if target=='unknown' then return false,'Неизвестная комбинация '..temp..'/'..hum..' для '..bee end

  if target=='normal' then
    if id=='base' or id=='plains' then return true end
    if id=='ocean' then return true end
    return false,'ОЧЕРЕДЬ ОБЫЧНОЙ ПАСЕКИ: '..bee..' (не '..(BIOME.title[id] or id)..')'
  end

  local needed=(target=='damp') and 'ВЛАЖНАЯ ПАСЕКА' or (BIOME.title[target] or target)
  if temp==atm and hum==ahm then return true end
  local specialMatch=(target==id)
  if temp=='ICY' and atm=='COLD' and target=='winter' then
    local tt=readTolerance(task)
    local down,up=tolRange(tt)
    if up>=1 then return true end
    if tt==nil then
      local native=norm(BIOME.needed(task)):match('^forestry%.species%.?([%w_]+)$')
      if native and ({wintry=true,icy=true,glacial=true})[native] then return true end
      if native and ({merry=true,tipsy=true})[native] then return true end
    end
    return false,'ЗИМА НАЙДЕНА, НО ПЧЕЛЕ '..bee..' нужен ICY, а Тайга COLD: требуется устойчивость +1'
  end
  if target=='damp' then
    if atm=='WARM' and ahm=='DAMP' then
      local tt=readTolerance(task)
      local down,up=tolRange(tt)
      if up>=1 then return true end
      if tt==nil then
        local native=norm(BIOME.needed(task)):match('^forestry%.species%.?([%w_]+)$')
        if native and ({marshy=true,miry=true,boggy=true})[native] then return true end
      end
    end
    return false,'Для '..bee..' нужен NORMAL/DAMP: влажная пасека или Джунгли с +1 к теплу'
  end
  if specialMatch then
    return false,'Эмуляция '..needed..' есть, но климат не совпадает: '..temp..'/'..hum..' vs '..atm..'/'..ahm
  end
  return false,'Для '..bee..' требуется '..needed..' ['..temp..'/'..hum..']'
end
local function hasVariant(kind)
  local list=devices[kind] or {}
  return #list==1
