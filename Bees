-- The inventory of EACH export interface must be consulted. A fingerprint seen
-- through another interface may be stale or may belong to a different AE network.
-- If an exact bee disappeared, only another individual of THE SAME bee species
-- and bee role may be selected, never an unrelated genotype or gene template.
local function beeSpeciesFor(fp,me)
  if not fp then return nil end
  local key=fingerprintKey(fp)
  local detail=detailCache[key]
  if not detail and me then
    local ok,d=invoke(me.p,'getItemDetail',fp,false)
    if ok and type(d)=='table' then detail=d;detailCache[key]=d end
  end
  return type(detail)=='table' and type(detail.individual)=='table'
     and detail.individual.ident or nil
end
local function liveFingerprint(route,request,n,strict)
  if not route or not route.me then return nil,'Не выбран МЭ-интерфейс' end
  local fp=request and request.fingerprint
  if type(fp)~='table' or not fp.id then return nil,'Некорректный отпечаток предмета' end
  local ok,items=pcall(getList,route.me.p)
  if not ok then return nil,'МЭ интерфейс '..route.me.addr:sub(1,8)..' не отвечает: '..tostring(items) end
  local required=math.max(1,tonumber(n) or 1)
  local key=fingerprintKey(fp)
  local count=0
  for _,item in pairs(items) do
    if type(item)=='table' and type(item.fingerprint)=='table'
       and fingerprintKey(item.fingerprint)==key then
      count=qty(item)
      if count>=required then return item end
    end
  end
  -- Strict when sending an ALREADY imprinted bee: never silently substitute an
  -- untreated individual of the same species.
  if strict then return nil,'Обработанная в импринтере пчела больше не найдена по точному NBT' end
  -- This fallback applies only to bees, not genetic templates/samples.
  local wantedKind=role({id=fp.id})
  local wantedSpecies=beeSpeciesFor(fp)
  if wantedKind and wantedSpecies then
    for _,item in pairs(items) do
      if type(item)=='table' and type(item.fingerprint)=='table' and qty(item)>=required
         and role({id=item.fingerprint.id})==wantedKind then
        local sp=beeSpeciesFor(item.fingerprint,route.me)
        if sp==wantedSpecies then
          log('Fresh fingerprint found for '..wantedKind..' '..sp)
          return item
        end
      end
    end
  end
  return nil,string.format('Пчела/предмет отсутствует в МЭ %s (доступно %d вместо %d). '..
    'Возможно, предмет уже забрали, NBT изменился или интерфейсы подключены к РАЗНЫМ МЭ-сетям.',
    route.me.addr:sub(1,8),count,required)
end
-- Mutation consumes parents irreversibly, so count the *whole species*
-- in the exporting ME before touching either parent.
local function physicalSpeciesCount(route,uid,beeRole)
  if not uid then return 0 end
  local ok,items=pcall(getList,route.me.p)
  if not ok then return 0 end
  local total=0
  for _,v in pairs(items) do
    if type(v)=='table' and type(v.fingerprint)=='table' and qty(v)>0
       and role({id=v.fingerprint.id})==beeRole then
      if beeSpeciesFor(v.fingerprint,route.me)==uid then total=total+qty(v) end
    end
  end
  return total
end
local function debitInventory(fp,n)
  local key=fingerprintKey(fp)
  for _,v in pairs(available) do
    if type(v)=='table' and type(v.fingerprint)=='table' and fingerprintKey(v.fingerprint)==key then
      local new=math.max(0,qty(v)-n)
      if v.size~=nil then v.size=new end
      if v.qty~=nil then v.qty=new end
    end
  end
  for _,sp in pairs(catalog) do
    for _,e in ipairs(sp.entries) do
      if fingerprintKey(e.fp)==key then
        local change=math.min(e.count,n)
        e.count=e.count-change
        local k= e.role=='P' and 'p' or (e.role=='D' and 'd' or 'q')
        sp[k]=math.max(0,(sp[k] or 0)-change)
      end
    end
  end
end
local function exactMeExport(route,entry,n,slot,strict)
  if not route or not entry or not entry.fingerprint then
    return false,'Не указан МЭ-интерфейс для этой машины'
  end
  local ok,yes=invoke(route.me.p,'canExport','DOWN')
  if ok and not yes then
    return false,'У выбранного МЭ-интерфейса нет инвентаря СНИЗУ'
  end
  local current,why=liveFingerprint(route,entry,n,strict)
  if not current then
    exportFailureCount=exportFailureCount+1
    stockWarning=tostring(why)
    return false,tostring(why)
  end
  local called,r=invoke(route.me.p,'exportItem',current.fingerprint,'DOWN',n,slot)
  if not called then
    exportFailureCount=exportFailureCount+1
    return false,tostring(r)
  end
  if r==nil or r==false then
    exportFailureCount=exportFailureCount+1
    return false,'МЭ не передала предмет (целевой слот занят, предмет не принимается или сеть недоступна)'
  end
  local amount=type(r)=='table' and tonumber(r.size or r.qty)
  if amount and amount<1 then
    exportFailureCount=exportFailureCount+1
    return false,'Передано 0: машина/слот не принимает предмет или нет запаса'
  end
  local delivered=amount or n
  if delivered<n then return false,'Передано только '..delivered..' из '..n..' предметов' end
  debitInventory(current.fingerprint,delivered)
  stockWarning=''
  return true,r,current.fingerprint
end
local function acquireRoute()
  rebuildRoutes()
  if not routes.mut then log('МУТ: выбери МЭ-интерфейс в настройках') end
  if #devices.imp>0 and not routes.imp then
    log('ИМП: выбери МЭ-интерфейс в настройках')
  end
end
local function refill(machine,route,slot)
  if not machine or not route then return false end
  local current=stack(machine.p,slot)
  if current and not norm(itemid(current)):find('labware',1,true) then return false end
  local have=current and qty(current) or 0
  if have>=CFG.targetLabware then return true end
  local lab=getResource('labware')
  if not lab then return false end
  local count=math.min(CFG.targetLabware-have,qty(lab))
  if count<=0 then return false end
  local ok=exactMeExport(route,lab,count,slot)
  if not ok then return false end
  local after=stack(machine.p,slot)
  return after and norm(itemid(after)):find('labware',1,true)~=nil
end
local function supplyMachine(machine,route,slot,label)
  if not route then
    supplyStatus[label]='МЭ НЕ ВЫБРАН'
    return false
  end
  local before=stack(machine.p,slot)
  local oldqty=qty(before)
  if oldqty>=CFG.targetLabware then
    supplyStatus[label]='64/64'
    return true
  end
  local ok=refill(machine,route,slot)
  local after=stack(machine.p,slot)
  local count=qty(after)
  if ok and count>oldqty then lastPhysicalRoute[machine.addr]=route.me.addr end
  supplyStatus[label]=ok and (tostring(count)..'/64') or ('НЕ ДОСТАВЛЕНО '..tostring(count)..'/64')
  return ok
end
local function supplyAll(now)
  if now<supplyAt then return end
  supplyAt=now+90
  local m=devices.mut[1]
  if m then supplyMachine(m,routes.mut,4,'МУТ') end
  local im=devices.imp[1]
  if im then supplyMachine(im,routes.imp,2,'ИМП') end
  for _,aux in ipairs(devices.other) do
    local b=bindings[aux.addr]
    if b and (b.role=='SAM' or b.role=='TRN') then
      supplyMachine(aux,routes['aux-'..aux.addr],2,b.role..':'..aux.addr:sub(1,5))
    end
  end
end
local function input(machine,route,fp,slot,mayConsume)
  assert(not stack(machine.p,slot),'Слот уже занят: '..slot)
  local ok,r,actual=exactMeExport(route,{fingerprint=fp},1,slot)
  if not ok then error('МЭ -> слот '..slot..': '..tostring(r)) end
  if not mayConsume then
    assert(stack(machine.p,slot),'Предмет не появился в слоте '..slot..'. Проверь назначенный МЭ')
  end
  return actual
end
local function meCount(fp)
  if not fp then return 0 end
  local t=getList();local key=fingerprintKey(fp)
  for _,e in pairs(t) do
    if e.fingerprint and fingerprintKey(e.fingerprint)==key then return qty(e) end
  end
  return 0
end
local function isStoneMutationSource(uid,name)
  local a=norm(uid..' '..tostring(name or ''))
  return a:find('rocky',1,true)~=nil or a:find('stone',1,true)~=nil or
         a:find('камен',1,true)~=nil
end
local function findRecipe()
  local opts={}
  for _,m in ipairs(graph) do
    local aUid=nameToUid[norm(m.a)] or m.a
    local bUid=nameToUid[norm(m.b)] or m.b
    local rUid=nameToUid[norm(m.result)] or m.result
    local dest=catalog[rUid]
    local alreadyGrowing=false
    for _,w in pairs(apiJobs) do
      if w.uid==rUid then alreadyGrowing=true;break end
    end
    if not alreadyGrowing and (not dest or (dest.p+dest.q)==0) then
      for _,pair in ipairs({{aUid,bUid},{bUid,aUid}}) do
        local p,d=catalog[pair[1]],catalog[pair[2]]
        local neededPrincess=CFG.allowLastPrincess and 1 or CFG.minPrincessReserve+1
        local neededDrone=CFG.allowLastDrone and 1 or CFG.minDroneReserve+1
        if p and d and p.p>=neededPrincess and d.d>=neededDrone
           and not (CFG.protectStoneMutations and isStoneMutationSource(pair[1],p.name)) then
          local key=norm(m.a)..'+'..norm(m.b)..'='..norm(m.result)
          if (failures[key] or 0)<CFG.maxFailedPerRecipe then
            local pe,de
            for _,v in ipairs(p.entries) do if v.role=='P' then pe=v;break end end
            for _,v in ipairs(d.entries) do if v.role=='D' then de=v;break end end
            if pe and de then
              opts[#opts+1]={m=m,key=key,p=pe,d=de,wanted=rUid,
                priority=(m.chance or 0)+math.min(p.p,10)}
            end
          end
        end
      end
    end
  end
  table.sort(opts,function(a,b)
    if a.priority==b.priority then return a.key<b.key end
    return a.priority>b.priority
  end)
  return opts[1]
end
local function recipeStockInfo()
  local ready,waiting,examples=0,0,{}
  local seen={}
  for _,m in ipairs(graph) do
    local result=nameToUid[norm(m.result)] or m.result
    local dest=catalog[result]
    if not dest or (dest.p+dest.q)==0 then
      local k=norm(m.a)..'|'..norm(m.b)..'='..norm(m.result)
      if not seen[k] then
        seen[k]=true
        local parentA=nameToUid[norm(m.a)] or m.a
        local parentB=nameToUid[norm(m.b)] or m.b
        local best=99
        local hint=''
        for _,pair in ipairs({{parentA,parentB},{parentB,parentA}}) do
          local p=catalog[pair[1]]
          local d=catalog[pair[2]]
          local pc=p and p.p or 0
          local dc=d and d.d or 0
          local missing=math.max(0,2-pc)+math.max(0,5-dc)
          if p and isStoneMutationSource(pair[1],p.name) then missing=missing+100 end
          if missing<best then
            best=missing
            local pName=p and p.name or tostring(pair[1])
            local dName=d and d.name or tostring(pair[2])
            hint=tostring(m.result)..': '..pName..' П='..pc..'/2, '..dName..' Т='..dc..'/5'
          end
        end
        if best==0 then ready=ready+1 else
          waiting=waiting+1
          if #examples<12 then examples[#examples+1]={n=best,msg=hint} end
        end
      end
    end
  end
  table.sort(examples,function(a,b)return a.n<b.n end)
  graphInfo={ready=ready,waiting=waiting,possible=ready+waiting,example=examples[1] and examples[1].msg or ''}
end
local function planMutation()
  if #graph==0 then notice('Нет дерева мутаций: подключи промышленную пасеку к адаптеру.',true);return end
  local route,m=routes.mut,devices.mut[1]
  if not (route and m) then notice('Нет маршрута МЭ -> обычный мутатрон.',true);return end
  if stack(m.p,1) or stack(m.p,2) or stack(m.p,3) then
    notice('Мутатрон занят. Не загружаю других пчёл.',true);return
  end
  local recipe=findRecipe()
  if not recipe then
    mode='Мутаций пока нет: пасеки растят родителей'
    return
  end
  local allowed={}
  for _,rule in ipairs(graph) do
    if (norm(rule.a)==norm(recipe.m.a) and norm(rule.b)==norm(recipe.m.b)) or
       (norm(rule.b)==norm(recipe.m.a) and norm(rule.a)==norm(recipe.m.b)) then
      allowed[nameToUid[norm(rule.result)] or rule.result]=true
    end
  end
  -- Check the ACTUAL exporting ME before reserving or moving anything.
  local liveP,errP=liveFingerprint(route,{fingerprint=recipe.p.fp},1)
  local liveD,errD=liveFingerprint(route,{fingerprint=recipe.d.fp},1)
  if not liveP or not liveD then
    stockWarning='Мутатрон ждёт родителей: '..tostring(errP or errD)
    mode='Ожидание: МЭ обновляется после изменения запасов'
    nextMutationPlanAt=computer.uptime()+45
    pendingApiaryRefresh=true
    return
  end
  local princessSpecies=beeSpeciesFor(liveP.fingerprint,route.me)
  local droneSpecies=beeSpeciesFor(liveD.fingerprint,route.me)
  local princeNeed=CFG.allowLastPrincess and 1 or CFG.minPrincessReserve+1
  local droneNeed=CFG.allowLastDrone and 1 or CFG.minDroneReserve+1
  local princessStock=physicalSpeciesCount(route,princessSpecies,'P')
  local droneStock=physicalSpeciesCount(route,droneSpecies,'D')
  if princessStock<princeNeed or droneStock<droneNeed then
    stockWarning='Не трогаю резерв родителей в МЭ над мутатроном: принцесс '..
      princessStock..'/'..princeNeed..', трутней '..droneStock..'/'..droneNeed
    mode='Жду размножения родителей до безопасного запаса'
    nextMutationPlanAt=computer.uptime()+60
    pendingApiaryRefresh=true
    return
  end
  job={recipe=recipe.key,wanted=recipe.wanted,pfp=liveP.fingerprint,dfp=liveD.fingerprint,
    name=recipe.m.result,started=computer.uptime(),step='mutation',
    allowed=allowed,baseline=queenSnapshot()}
  stage='mutation';save()
  if not supplyMachine(m,route,4,'МУТ') and not stack(m.p,4) then error('Нет посуды в мутатроне: проверь МЭ над ним и DOWN') end
  job.pfp=input(m,route,job.pfp,1) or job.pfp
  job.dfp=input(m,route,job.dfp,2,true) or job.dfp
  mode='Скрещивание: '..job.name
  log('Breeding target '..job.name)
  save()
end
local function nextAfterQueen()
  if job.result==job.wanted then
    known[job.result]=true
    created[job.result]=true
    log('BREED OK '..job.resultTitle)
  else
    failures[job.recipe]=(failures[job.recipe] or 0)+1
    log('OTHER mutation '..job.resultTitle..' (attempt '..failures[job.recipe]..')')
  end
  -- All individuals, including queens from this Mutatron, are imprinted
  -- by the APIARY admission pipeline. Do not imprint only this queen here.
  -- This ensures ME princesses and drones pass through the SAME rule.
  job.step='post_queen';stage='post_queen'
  save()
end
local function observeNewQueen()
  local matches={}
  for _,m in ipairs(newQueens(job.baseline or {})) do
    if not job.allowed or job.allowed[m.uid] then matches[#matches+1]=m end
  end
  if #matches>1 then
    notice('Несколько новых маток в МЭ одновременно. Нужна ручная проверка.',true)
    return
  end
  if #matches==1 then
    local e=matches[1]
    job.result=e.uid;job.resultTitle=e.name
    job.queenFP=e.entry.fp
    log('Queen imported: '..e.name)
    nextAfterQueen()
  end
end
local function processMutation(now)
  local m=devices.mut[1]
  if not m then notice('Мутатрон исчез из сети.',true);return end
  local output=stack(m.p,3)
  if output and role(output)~='Q' then
    notice('Мутатрон выдал не матку: '..title(output),true);return
  end
  if now-lastME>=CFG.busyScan or pendingRefresh then
    pendingRefresh=false;meInventory();observeNewQueen()
  end
  if stage=='mutation' and now-job.started>CFG.timeout then
    notice('Мутация слишком долгая. Проверь мутаген, питание и шину импорта.',true)
  end
end
local function processImprint(now)
  local imp=devices.imp[1]
  if not imp or not routes.imp then job.step='post_queen';stage='post_queen';return end
  if job.step=='imprint_start' then
    if stack(imp.p,3) or stack(imp.p,4) then
      notice('Импринтер занят (слоты 3/4).',true);return
    end
    if not supplyMachine(imp,routes.imp,2,'ИМП') and not stack(imp.p,2) then
      notice('Нет посуды в импринтере. Проверь его МЭ и DOWN.',true);return
    end
    if not stack(imp.p,1) then
      if not template then
        notice('В импринтере нет шаблона, а в МЭ не найден единственный заполненный шаблон.',true);return
      end
      input(imp,routes.imp,template.fp,1)
    end
    local bee=chooseQueen(job.result)
    if not bee then notice('Матка для импринтера не найдена в МЭ.',true);return end
    job.queenFP=bee.fp
    job.imprintPrevCount=meCount(bee.fp)
    job.baseline=queenSnapshot() -- Baseline BEFORE exporting; output may reimport instantly.
    input(imp,routes.imp,bee.fp,3,true)
    job.step='imprint_wait';job.started=now
    save()
  elseif job.step=='imprint_wait' then
    local out=stack(imp.p,4)
    if out and role(out)~='Q' then
      notice('Импринтер выдал отходы/не матку; возможна гибель пчелы!',true);return
    end
    if now-lastME>=CFG.busyScan or pendingRefresh then
      pendingRefresh=false;meInventory()
      local matches={}
      for _,m in ipairs(newQueens(job.baseline or {})) do
        if m.uid==job.result then matches[#matches+1]=m end
      end
      -- A no-op imprint can yield an identical fingerprint. At zero latency the
      -- item may have reentered ME before we observe the decreased inventory.
      if #matches==0 and job.queenFP and
          meCount(job.queenFP)>=(job.imprintPrevCount or math.huge) then
        local x=chooseQueen(job.result)
        if x and fingerprintKey(x.fp)==fingerprintKey(job.queenFP) then
          matches[1]={uid=job.result,entry=x,name=job.resultTitle}
        end
      end
      if #matches==1 then
        job.queenFP=matches[1].entry.fp
        job.step='post_queen';stage='post_queen'
        log('Imprinted queen returned: '..matches[1].name)
        save()
      elseif #matches>1 then notice('Несколько маток после импринтера: проверь вручную.',true) end
    end
    if stage=='imprint' and now-job.started>CFG.timeout then
      notice('Импринтер не завершил работу: посуда/энергия/импорт.',true)
    end
  end
end
local function processPostQueen()
  local uid=job and job.result
  job=nil;stage='idle';save()
  if uid then
    pendingApiaryRefresh=true
    log('Species '..uid..' ready for apiary management')
  end
end
-- INDUSTRIAL APIARY ENGINE
-- One independent task per connected industrial apiary. All products are returned
-- to ME by the player's AE import buses or item pipes (never by blind pushing).
-- The first princess/drone transfer also discovers which physical apiary a ME
-- export side actually touches; no fixed OC component address is configured.
local function specimen(uid,wantedRole,excludeFp)
  local sp=catalog[uid]
  if not sp then return nil end
  local best
  for _,e in ipairs(sp.entries) do
    if e.role==wantedRole and e.count>0 and
       (not excludeFp or fingerprintKey(e.fp)~=excludeFp) then
      if not best or e.count>best.count then best=e end
    end
  end
  return best
end
local function speciesAmount(uid,k)
  local x=catalog[uid]
  return x and (x[k] or 0) or 0
end
local function inProgressTarget(uid,kind)
  for _,w in pairs(apiJobs) do
    if w.uid==uid and (not kind or w.kind==kind) then return true end
  end
  if apiPrep and apiPrep.uid==uid and (not kind or apiPrep.kind==kind) then return true end
  return false
end
local function workersCount()
  local n=0;for _ in pairs(apiJobs) do n=n+1 end;return n
end
local function motherUid()
  local list={}
  for uid,x in pairs(catalog) do
    if isStoneMutationSource(uid,x.name) and x.p>0 then list[#list+1]=uid end
  end
  table.sort(list,function(a,b)return speciesAmount(a,'p')>speciesAmount(b,'p') end)
  return list[1]
end
local function recipeNeeds(uid)
  for _,m in ipairs(graph) do
    local child=nameToUid[norm(m.result)] or m.result
    local mother=nameToUid[norm(m.a)] or m.a
    local father=nameToUid[norm(m.b)] or m.b
    if speciesAmount(child,'p')==0 and speciesAmount(child,'q')==0 and
       (mother==uid or father==uid) then return true end
  end
  return false
end
local function chooseApiaryTask()
  local choices={}
  local stone=motherUid()
  for uid,sp in pairs(catalog) do
    if not inProgressTarget(uid) then
      local d=specimen(uid,'D')
      local p=specimen(uid,'P')
      local q=specimen(uid,'Q')
      local needs=recipeNeeds(uid)
      -- Queen straight from Mutatron: put in an apiary to get renewable princesses and drones.
      if q and sp.p<2 and not (job and job.result==uid and stage~='post_queen' and stage~='idle') then
        choices[#choices+1]={kind='queen',uid=uid,queen=q,priority=500+(needs and 250 or 0)}
      end
      -- Species can be sustained without Stone princesses as soon as a princess and drone exist.
      if p and d and sp.d<=CFG.minDroneReserve then
        choices[#choices+1]={kind='farm',uid=uid,p=p,d=d,priority=300+(needs and 160 or 0)+(CFG.minDroneReserve+1-sp.d)*15}
      end
      -- Missing second species princess: mate one of the spare Stone princesses
      -- with a target drone. This can produce the missing lineage.
      if d and sp.d>=2 and sp.p<2 and sp.q==0 and stone and uid~=stone and
        speciesAmount(stone,'p')>CFG.stonePrincessReserve then
        local key='stone:'..uid
        local attempts=failures[key] or 0
        local source=specimen(stone,'P')
        if source and attempts<CFG.maxStoneCrossAttempts then
          choices[#choices+1]={kind='stone',uid=uid,p=source,d=d,
            source=stone,key=key,priority=140+(needs and 260 or 0)+(sp.p==0 and 20 or 0)-attempts*10}
        end
      end
      -- Replenish stone bee drones too. Stone stock is not consumed by Mutatron.
      if isStoneMutationSource(uid,sp.name) and p and d and sp.d<=CFG.minDroneReserve then
        choices[#choices+1]={kind='farm',uid=uid,p=p,d=d,priority=390}
      end
    end
  end
  table.sort(choices,function(a,b)
    if a.priority==b.priority then return a.uid<b.uid end
    return a.priority>b.priority
  end)
  return choices
end
local function busyApiary(api)
  if apiPrep and apiPrep.apiAddr==api.addr then return true end
  for _,w in pairs(apiJobs) do if w.apiAddr==api.addr then return true end end
  if stack(api.p,1) or stack(api.p,2) then return true end
  for n=7,15 do if stack(api.p,n) then return true end end
  return false
end
local function liveApiary(addr)
  for _,api in ipairs(devices.api) do if api.addr==addr then return api end end
end
local function findApiaryRoute(api)
  local knownRoute=routes['api-'..api.addr]
  if knownRoute then return knownRoute end
  -- A route cannot be identified from canExport alone; match it by observing
  -- the target apiary after an actual safe breeding operation.
  return nil
end
local function loadToApiary(task,forcedApi,strict)
  if not CFG.useApiary then return false,'Пасеки отключены' end
  local first=task.queen or task.p
  if not first then return false,'Не найдена принцесса или матка' end
  local api,route
  if forcedApi then
    api=forcedApi;route=routes['api-'..api.addr]
  else
    for _,candidate in ipairs(devices.api) do
      if not busyApiary(candidate) then
        local r=routes['api-'..candidate.addr]
        if r then api,route=candidate,r;break end
      end
    end
  end
  if not api then
    apiaryReason='Нет свободной пасеки с назначенным МЭ (ОБОРУДОВАНИЕ → ПАСЕКА → МЭ)'
    return false,apiaryReason
  end
  -- Verify the pair exists in THIS interface, not just in another ME view.
  local firstLive,missing=liveFingerprint(route,{fingerprint=first.fp},1,strict)
  if not firstLive then
    apiaryReason='В МЭ над пасекой не найден родитель: '..tostring(missing)
    stockWarning=apiaryReason
    return false,apiaryReason
  end
  local droneLive=nil
  if task.d then
    droneLive,missing=liveFingerprint(route,{fingerprint=task.d.fp},1,strict)
    if not droneLive then
      apiaryReason='Не найден трутень в МЭ над пасекой: '..tostring(missing)
      stockWarning=apiaryReason
      return false,apiaryReason
    end
  end
  local ok,why=exactMeExport(route,firstLive,1,1,strict)
  if not ok then
    apiaryReason='Пасека '..api.addr:sub(1,8)..': '..tostring(why)
    return false,apiaryReason
  end
  local bee=stack(api.p,1)
  if not bee or (role(bee)~='P' and role(bee)~='Q') then
    notice('Экспорт есть, но в указанной пасеке нет пчелы. Проверь интерфейс НАД пасекой!',true)
    return false,'Неправильная привязка пасеки к МЭ'
  end
  lastPhysicalRoute[api.addr]=route.me.addr
  apiaryReason='Пчела загружена в пасеку '..api.addr:sub(1,8)
  local w={apiAddr=api.addr,uid=task.uid,kind=task.kind,
    source=task.source,step='breeding',started=computer.uptime(),
    lastRole=role(bee),beforeP=speciesAmount(task.uid,'p'),
    beforeD=speciesAmount(task.uid,'d'),postQueen=false,importStarted=nil,
    key=task.key,targetLabel=(catalog[task.uid] or {}).name or task.uid}
  apiJobs[api.addr]=w
  save()
  if task.d then
    local sent,msg=exactMeExport(route,droneLive,1,2,strict)
    if not sent then
      notice('Пасека получила принцессу, но не получила трутня: '..tostring(msg),true)
      return false,msg
    end
    local z=stack(api.p,1)
    local dz=stack(api.p,2)
    if z and role(z)=='P' and not dz then
      notice('Не вижу трутня в пасеке после передачи. Проверь подключение!',true)
      return false,'Трутень не дошёл'
    end
  end
  apiStats.started=(apiStats.started or 0)+1
  pendingApiaryRefresh=true
  log('API '..task.kind..' '..task.uid..' => '..api.addr:sub(1,8))
  mode='Пасека: '..w.targetLabel
  save()
  return true
end
-- Every bee destined for an apiary travels through the optional Imprinter.
-- One queued apiary task is prepared at a time, independent of running apiaries.
-- No bee can bypass a configured Imprinter with unapproved/missing genes.
local function imprintEnabled()
  return CFG.useImprinter and #devices.imp==1
end
local function apiaryTaskSummary(prep)
  return prep and ((catalog[prep.uid] or {}).name or prep.uid) or '?'
end
local function queueApiaryImprint(task,api)
  local first=task.queen or task.p
  if not first then return false,'В задаче нет исходной матки или принцессы' end
  apiPrep={apiAddr=api.addr,uid=task.uid,kind=task.kind,source=task.source,
    key=task.key,firstFp=first.fp,secondFp=task.d and task.d.fp or nil,
    firstKind=role({id=first.fp.id}),secondKind=task.d and 'D' or nil,
    phase='imprint_start',part=1,started=computer.uptime()}
  apiaryReason='Импринтер: подготовка родителей для '..apiaryTaskSummary(apiPrep)
  log('Queued imprint before apiary: '..apiaryTaskSummary(apiPrep))
  save()
  return true
end
local function stockSnapshotFor(route,kind,species)
  local items=getList(route.me.p)
  local counts={}
  for _,v in pairs(items) do
    if type(v)=='table' and type(v.fingerprint)=='table' and qty(v)>0
       and role({id=v.fingerprint.id})==kind
       and beeSpeciesFor(v.fingerprint,route.me)==species then
      counts[fingerprintKey(v.fingerprint)]=qty(v)
    end
  end
  return counts
end
local function findImprintedReturn(prep,route)
  local ref=prep.currentFp
  local expected=prep.currentSpecies
  local wanted=prep.currentKind
  local before=prep.baseline or {}
  local ok,items=pcall(getList,route.me.p)
  if not ok then return nil,'МЭ импринтера недоступна: '..tostring(items) end
  local candidates={}
  local exact=nil
  for _,v in pairs(items) do
    if type(v)=='table' and type(v.fingerprint)=='table' and qty(v)>0
       and role({id=v.fingerprint.id})==wanted then
      local k=fingerprintKey(v.fingerprint)
      if k==fingerprintKey(ref) then exact=v end
      if qty(v)>(before[k] or 0) then
        -- An imprint must NOT turn the bee into another species.
        local sp=beeSpeciesFor(v.fingerprint,route.me)
        if sp==expected then
          candidates[#candidates+1]=v
        end
      end
    end
  end
  if #candidates>1 then
    return nil,'Несколько новых пчёл этого вида в МЭ: нельзя безопасно определить результат'
  end
  if #candidates==1 then return candidates[1].fingerprint end
  -- If the template did not change NBT, the original item returns with the
  -- same fingerprint and the former exact count. Waiting for free input/output
  -- slots prevents treating an unprocessed item as a finished one.
  if exact and qty(exact)>=(before[fingerprintKey(ref)] or 0) then
    return exact.fingerprint
  end
  return nil,nil
end
-- A peripheral can push only to a PHYSICALLY ADJACENT inventory.
-- In this layout the ME Interface is UP from the Imprinter. We never
-- pretend that OC can directly teleport an item to a remote apiary.
-- Once an imported item becomes visible in ME, the separate interface
-- over the apiary can export it DOWN.
local function pushImprinterOutput(imp, expectedRole, expectedSpecies)
  local out=stack(imp.p,4)
  if not out then return false end
  if role(out)~=expectedRole then
    imprintOutputStatus='ВЫХОД НЕ ПЧЕЛА: '..title(out)
    return false
  end
  local got=(out.individual or {}).ident
  if got and expectedSpecies and got~=expectedSpecies then
    imprintOutputStatus='ОПАСНО: ПОСЛЕ ПРИВИВКИ ИЗМЕНИЛСЯ ВИД'
    return false
  end
  if not CFG.autoPushImprinterOutput then
    imprintOutputStatus='Ожидание возврата через МЭ-шину импорта'
    return false
  end
  local rr=routes.imp
  if not rr or lastPhysicalRoute[imp.addr]~=rr.me.addr then
    imprintOutputStatus='Выход ожидает подтверждения МЭ над импринтером'
    return false
  end
  local ok,moved=invoke(imp.p,'pushItem',CFG.imprintOutputSide,4,1)
  if ok and tonumber(moved) and tonumber(moved)>0 then
    imprintOutputStatus='Импринтер: выдано '..tostring(moved)..' -> МЭ сверху'
    log(imprintOutputStatus)
    return true
  end
  imprintOutputStatus='Выход заблокирован: нужна МЭ-шина импорта/труба'
  return false
end

local function processApiaryImprint(now)
  local prep=apiPrep
  if not prep then return end
  local api=liveApiary(prep.apiAddr)
  if not api then notice('Пропала пасека для подготовленных пчёл',true);return end
  if prep.phase=='apiary_load' then
    local t={uid=prep.uid,kind=prep.kind,source=prep.source,key=prep.key,
      p=(prep.firstKind=='P') and {fp=prep.firstFp} or nil,
      queen=(prep.firstKind=='Q') and {fp=prep.firstFp} or nil,
      d=prep.secondFp and {fp=prep.secondFp} or nil}
    local ok,why=loadToApiary(t,api,true)
    if ok then
      apiPrep=nil
      pendingApiaryRefresh=true
      apiaryReason='После прививки пчёлы отправлены в пасеку'
      save()
    else
      -- Do not replace missing processed bees with untreated individuals.
      apiaryReason='Привитые пчёлы не доставлены: '..tostring(why)
      notice(apiaryReason,true);save()
    end
    return
  end
  local imp=devices.imp[1]
  local route=routes.imp
  if not (imp and route) then
    notice('Импринтер ожидается, но не назначен его МЭ-интерфейс',true);return
  end
  if not CFG.trustSingleFilledTemplate then
    apiaryReason='Пчёлы ждут прививки: включи ГЕНЫ в ОБОРУДОВАНИИ после проверки шаблона'
    return
  end
  if prep.phase=='imprint_start' then
    local beeFp=prep.part==1 and prep.firstFp or prep.secondFp
    if not beeFp then prep.phase='apiary_load';save();return end
    if stack(imp.p,3) or stack(imp.p,4) then
      apiaryReason='Импринтер занят / заблокирован. Проверь слоты 3 и 4.'
      return
    end
    if not stack(imp.p,1) then
      if not template then
        apiaryReason='Нет единственного заполненного шаблона генов для импринтера'
        return
      end
      local ok,msg=exactMeExport(route,{fingerprint=template.fp},1,1,true)
      if not ok then apiaryReason='Не подан шаблон: '..tostring(msg);return end
      if not stack(imp.p,1) then
        apiaryReason='Шаблон не появился в слоте 1 импринтера';return
      end
      lastPhysicalRoute[imp.addr]=route.me.addr
    end
    if not stack(imp.p,2) and not supplyMachine(imp,route,2,'ИМП') then
      apiaryReason='Не хватает посуды в импринтере'
      return
    end
    local live,why=liveFingerprint(route,{fingerprint=beeFp},1)
    if not live then apiaryReason='Родитель пока не найден в МЭ импринтера: '..tostring(why);return end
    local kind=role({id=live.fingerprint.id})
    local species=beeSpeciesFor(live.fingerprint,route.me)
    if not species or kind~=role({id=beeFp.id}) then
      apiaryReason='Неверный генетический тип кандидата для импринтера';return
    end
    local okay,base=pcall(stockSnapshotFor,route,kind,species)
    if not okay then apiaryReason='Не удалось прочитать запас МЭ перед прививкой: '..tostring(base);return end
    prep.baseline=base;prep.currentFp=live.fingerprint
    prep.currentKind=kind;prep.currentSpecies=species
    local success,msg=exactMeExport(route,live,1,3,true)
    if not success then apiaryReason='МЭ не подала пчелу в импринтер: '..tostring(msg);return end
    -- Verify the selected ME interface is the real path: a bee is in slot 3,
    -- or the machine has already processed it into slot 4.
    if stack(imp.p,3) or stack(imp.p,4) then
      lastPhysicalRoute[imp.addr]=route.me.addr
    end
    prep.phase='imprint_wait';prep.started=now;prep.lastChecked=0
    apiaryReason='Прививка: '..apiaryTaskSummary(prep)..' | '..(prep.part==1 and 'матка / принцесса' or 'трутень')
    log('Imprinter accepted '..kind..' '..species)
    save()
  elseif prep.phase=='imprint_wait' then
    local out=stack(imp.p,4)
    if out and (role(out)~=prep.currentKind) then
      notice('Импринтер выдал отходы или другой тип пчелы: '..title(out),true);return
    end
    if out then
      pushImprinterOutput(imp,prep.currentKind,prep.currentSpecies)
      out=stack(imp.p,4)
    end
    local inp=stack(imp.p,3)
    if inp or out then
      if now-prep.started>CFG.timeout then
        notice('Пчела остаётся в импринтере. '..imprintOutputStatus..'. Проверь питание и МЭ.',true)
      end
      return
    end
    if now-(prep.lastChecked or 0)<CFG.busyScan then return end
    prep.lastChecked=now
    local fp,why=findImprintedReturn(prep,route)
    if why then notice(why,true);return end
    if fp then
      if prep.part==1 then
        prep.firstFp=fp
        prep.part=2
      else prep.secondFp=fp;prep.part=3 end
      if prep.part==2 and prep.secondFp then
        prep.phase='imprint_start'
      else prep.phase='apiary_load' end
      prep.baseline=nil;prep.currentFp=nil
      prep.currentKind=nil;prep.currentSpecies=nil
      apiaryReason=prep.phase=='imprint_start' and 'Первая пчела привита, готовлю трутня' or 'Пчёлы привиты, отправляю в пасеку'
      log('Imprint returned; next phase '..prep.phase)
      pendingApiaryRefresh=true
      save()
    elseif now-prep.started>CFG.timeout then
      notice('После импринтера пчела не вернулась в МЭ. Проверь импорт',true)
    end
  end
end

local function observeApiaryJobs(now)
  local requestME=false
  local due=now-lastME>=CFG.scanInterval
  local awaitingImport=false
  for addr,w in pairs(apiJobs) do
    local api=liveApiary(addr)
    if w.importStarted==0 then w.importStarted=nil end
    if not api then notice('Потеряно подключение к пасеке с пчёлами.',true);return end
    local bee=stack(api.p,1)
    local br=role(bee)
    if br=='Q' then w.lastRole='Q' end
    local queenEnded=not bee or (w.lastRole=='Q' and br=='P')
    if queenEnded and not w.importStarted then
      w.importStarted=now
      requestME=true
      log('Apiary cycle finished: '..w.targetLabel)
      save()
    end
    -- Do not rescan whole ME while a queen is still alive.
    if w.importStarted then awaitingImport=true end
    if now-w.started>CFG.maxFarmSeconds then
      notice('Пасека '..w.targetLabel..' долго не даёт результата. Проверь биом/цветы/питание.',true)
      return
    end
  end
  if requestME or (awaitingImport and now-lastME>=CFG.busyScan) or
     (due and workersCount()>0) then
    local ok,err=pcall(meInventory)
    if not ok then notice('Не могу проверить потомство в МЭ: '..tostring(err),true);return end
  end
  for addr,w in pairs(apiJobs) do
    local d=speciesAmount(w.uid,'d')
    local p=speciesAmount(w.uid,'p')
    local isNewP=(p>w.beforeP)
    local isNewD=(d>w.beforeD)
    local good=(w.kind=='farm' and d>CFG.minDroneReserve)
         or (w.kind=='stone' and isNewP)
         or (w.kind=='queen' and isNewP)
    if good then
      apiStats.completed=(apiStats.completed or 0)+1
      if isNewP then apiStats.princesses=(apiStats.princesses or 0)+1 end
      if isNewD then apiStats.drones=(apiStats.drones or 0)+(d-w.beforeD) end
      log('API SUCCESS '..w.targetLabel..' D='..d..' P='..p)
      apiJobs[addr]=nil
      pendingApiaryRefresh=true
      nextPlanAt=0
      save()
    elseif w.importStarted and now-w.importStarted>=CFG.importTimeout then
      local api=liveApiary(addr)
      if api and (stack(api.p,1) or stack(api.p,2)) then
        -- Gendustry automatic upgrade may immediately begin another lifespan.
        w.importStarted=nil;w.started=now;w.beforeP=p;w.beforeD=d
      else
        apiStats.failed=(apiStats.failed or 0)+1
        if w.key then failures[w.key]=(failures[w.key] or 0)+1 end
        log('API no intended offspring '..w.targetLabel..' D='..d..' P='..p)
        apiJobs[addr]=nil
        pendingApiaryRefresh=true
        nextPlanAt=0
      end
      save()
    end
  end
end
local function scheduleApiaries()
  if not CFG.useApiary or #devices.api==0 or paused then return end
  if apiPrep then return end
  local t=computer.uptime()
  if t<nextApiaryPlanAt then return end
  local free=0
  for _,api in ipairs(devices.api) do if not busyApiary(api) then free=free+1 end end
  if free==0 then
    if workersCount()==0 then apiaryReason='Пасеки заняты предметами/продукцией, очисти выходные слоты' end
    return
  end
  local choices=chooseApiaryTask()
  if #choices==0 and workersCount()==0 then
    apiaryReason='Нет доступных задач: нужны матки или принцессы с трутнями в МЭ'
    if stage=='idle' then mode='Ожидание: нужны родители или запас Каменных принцесс' end
  end
  local n=0
  for _,task in ipairs(choices) do
    if n>=free then break end
    if not inProgressTarget(task.uid) then
      local ok,why
      if imprintEnabled() then
        local candidate
        for _,a in ipairs(devices.api) do
          if not busyApiary(a) and routes['api-'..a.addr] then candidate=a;break end
        end
        if not candidate then
          ok=false;why='Пасеке не назначен МЭ над ней'
        elseif not routes.imp then
          ok=false;why='Импринтер назначен, но для него не выбран МЭ'
        elseif not CFG.trustSingleFilledTemplate then
          ok=false;why='Включи ГЕНЫ в настройках, иначе запуск пасек заблокирован (без обхода импринтера)'
        else
          ok,why=queueApiaryImprint(task,candidate)
        end
      else
        ok,why=loadToApiary(task)
      end
      if ok then n=n+1
      else
        apiaryReason=tostring(why)
        log('Apiary setup: '..tostring(why))
        nextApiaryPlanAt=t+45
        pendingApiaryRefresh=true
        break
      end
      if apiPrep then break end -- One imprinted bee at a time; other active apiaries keep working.
    end
  end
end

local function cycle()
  if paused then return end
  local now=computer.uptime()
  if not primaryME() or not hasVariant('mut') then
    notice('Не хватает подключённого оборудования.',true);return
  end
  local ok,err=pcall(function()
    if pendingApiaryRefresh or now-lastME>=CFG.scanInterval then
      pendingApiaryRefresh=false
      meInventory()
      nextPlanAt=0
    end
    supplyAll(now)
    if stage=='mutation' then processMutation(now)
    elseif stage=='imprint' then processImprint(now)
    elseif stage=='post_queen' then processPostQueen()
    elseif stage=='idle' then
      if now>=nextPlanAt then
        nextPlanAt=now+CFG.perApiaryCooldown
        local m=devices.mut[1]
        if stack(m.p,1) or stack(m.p,2) or stack(m.p,3) then
          notice('Мутатрон занят: проверь его перед запуском.',true);return
        end
        if now>=nextMutationPlanAt then planMutation() end
      end
    else notice('Неизвестное состояние '..stage,true);return end
    observeApiaryJobs(now)
    if stage~='imprint' then processApiaryImprint(now) end
    if not paused then scheduleApiaries() end
  end)
  if not ok then notice('Ошибка: '..tostring(err),true);save() end
end
local function ulen(s) return unicode.len(tostring(s or '')) end
local function cut(s,n) return unicode.sub(tostring(s or ''),1,math.max(0,n)) end
local function pushDraw(y,entry)
  if not guiRowsNow or y<1 or y>height then return end
  local row=guiRowsNow[y]
  if not row then row={};guiRowsNow[y]=row end
  row[#row+1]=entry
end
local function fill(x,y,w,h,bg)
  if x<1 or y<1 or w<1 or h<1 or x>width or y>height then return end
  w=math.min(w,width-x+1);h=math.min(h,height-y+1)
  guiBg=bg
  if guiRowsNow then
    for ly=y,y+h-1 do pushDraw(ly,{k='f',x=x,w=w,bg=bg}) end
  else
    gpu.setBackground(bg);gpu.fill(x,y,w,h,' ')
  end
end
local function paint(x,y,s,fg,bg)
  if y<1 or y>height or x<1 or x>width then return end
  local value=cut(s,width-x+1)
  local background=bg or guiBg
  guiBg=background
  if guiRowsNow then
    pushDraw(y,{k='s',x=x,txt=value,fg=fg or COLOR.fg,bg=background})
  else
    gpu.setBackground(background);gpu.setForeground(fg or COLOR.fg);gpu.set(x,y,value)
  end
end
local function button(x,y,t,action,fg,bg,w)
  local label=' '..t..' '
  w=w or (ulen(label)+2)
  fill(x,y,w,1,bg or 0x192D42)
  paint(x+math.max(0,math.floor((w-ulen(label))/2)),y,label,fg or COLOR.blue,bg or 0x192D42)
  buttons[#buttons+1]={x=x,y=y,w=w,action=action}
end
local function box(x,y,w,h,title,fg)
  fill(x,y,w,h,0x142233)
  fill(x,y,w,1,0x1D3347)
  paint(x+2,y,title or '',fg or COLOR.blue,0x1D3347)
end
local function hline(y,text,fg)
  fill(1,y,width,1,COLOR.bg)
  paint(2,y,text,fg)
end
local function flushDraw()
  local nextPrev={}
  local changed=0
  for y=1,height do
    local row=guiRowsNow[y] or {}
    local sigPieces={}
    for _,o in ipairs(row) do
      if o.k=='f' then
        sigPieces[#sigPieces+1]='f'..o.x..','..o.w..','..o.bg..';'
      else
        sigPieces[#sigPieces+1]='s'..o.x..','..o.fg..','..o.bg..','..o.txt..';'
      end
    end
    local sig=table.concat(sigPieces)
    nextPrev[y]=sig
    if guiRowsPrevious[y]~=sig then
      changed=changed+1
      gpu.setBackground(COLOR.bg)
      gpu.fill(1,y,width,1,' ')
      for _,o in ipairs(row) do
        gpu.setBackground(o.bg)
        if o.k=='f' then gpu.fill(o.x,y,o.w,1,' ')
        else gpu.setForeground(o.fg);gpu.set(o.x,y,o.txt) end
      end
    end
  end
  guiRowsPrevious=nextPrev
  return changed
end
