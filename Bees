  line(height-7,'ПОСЛЕДНЕЕ СООБЩЕНИЕ',COLOR.blue)
  line(height-6,cut(alert,width-4),COLOR.yellow)
  line(height-5,'Лог: '..LOG,COLOR.gray)
  btn(2,height-3,paused and 'СТАРТ' or 'ПАУЗА','pause',paused and COLOR.green or COLOR.yellow)
  btn(23,height-3,'ОБНОВИТЬ','scan')
  btn(49,height-3,'ВЫХОД','exit',COLOR.red)
  paint(2,height,'Складывай продукцию в МЭ шинами импорта. Программа не тратит последнюю принцессу.',COLOR.gray)
