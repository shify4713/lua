function compactDetail(a)
  if type(a)~='table' then return nil end
  local ind=a.individual
  if type(ind)~='table' then return nil end
  local act=ind.active
  local climate=type(act)=='table' and act.species or nil
  local info={ident=ind.ident, displayName=ind.displayName, isAnalyzed=ind.isAnalyzed}
  if type(act)=='table' then
    info.active={temperatureTolerance=act.temperatureTolerance,humidityTolerance=act.humidityTolerance}
    if type(climate)=='table' then
      info.active.species={name=climate.name,temperature=climate.temperature,humidity=climate.humidity}
    end
  end
  return {individual=info}
end
local function lookDetail(fp)
