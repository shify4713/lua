function releaseMemory(force)
  local now=computer.uptime()
  if force or now-CFG.lastGC>=CFG.gcInterval then
    collectgarbage('collect')
    CFG.lastGC=now
  else
    collectgarbage('step', 120)
  end
  if type(computer.freeMemory)=='function' then
    local free=computer.freeMemory()
    local total=computer.totalMemory()
    CFG.memStatus=string.format('RAM %.0f/%.0f KB', free/1024,total/1024)
    if free < CFG.memoryWarningKB*1024 then
      collectgarbage('collect')
      CFG.lastGC=now
      free=computer.freeMemory()
      CFG.memStatus=string.format('RAM %.0f/%.0f KB',free/1024,total/1024)
      return false
    end
  end
  return true
end

local function log(s)
  s=tostring(s)
  local now=computer.uptime()
  if CFG.logRecentKeys[s] and now-CFG.logRecentKeys[s]<240 then return end
  CFG.logRecentKeys[s]=now
  if #recent>=40 then
    for key,last in pairs(CFG.logRecentKeys) do
      if now-last>300 then CFG.logRecentKeys[key]=nil end
    end
  end
  local line=string.format('[%.0f] %s',now,s)
  recent[#recent+1]=line
  while #recent>70 do table.remove(recent,1) end
  local f=io.open(LOG,'a'); if f then f:write(line,'\n');f:close() end
end
local function notice(s,bad)
