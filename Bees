local function roleName(r)
  if r=='MUT' then return 'МУТАТРОН' elseif r=='IMP' then return 'ИМПРИНТЕР'
  elseif r=='API' then return 'ПАСЕКА' elseif r=='SAM' then return 'ПРОБООТБОР'
  elseif r=='TRN' then return 'ТРАНСПОЗЕР' else return 'НЕ ИСПОЛЬЗ.' end
end
local function roleOf(obj)
  local b=bindings[obj.addr]
  if b then return b.role or 'OFF' end
  if obj.size==15 then return 'API' end
  return 'OFF'
end
local function meIndex(addr)
  for i,m in ipairs(devices.me) do if m.addr==addr then return i end end
  return nil
end
local function deviceIndex(addr)
  for i,v in ipairs(devices.peripherals) do if v.addr==addr then return i,v end end
  return nil,nil
end
local function resolvedMEText(obj)
  local rr=downRoute(obj)
  if rr then
