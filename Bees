local quit=false
local function activeMachine(addr)
  if not addr then return false end
  if apiJobs[addr] or (apiPrep and apiPrep.apiAddr==addr) then return true end
  if (stage=='mutation' or stage=='post_queen') and devices.mut[1] and devices.mut[1].addr==addr then return true end
  if ((stage=='imprint' or stage=='post_queen') or apiPrep) and devices.imp[1] and devices.imp[1].addr==addr then return true end
  return false
end
local function changeRole(addr,newRole)
  local _,obj=deviceIndex(addr)
  if not obj then deviceActionNote='Блок отключился. Вернись в список.';return end
  local previous=roleOf(obj)
  if previous==newRole then
    deviceActionNote='У этого устройства уже роль '..roleName(newRole)
    return
  end
  if activeMachine(addr) then
    deviceActionNote='Этот блок сейчас занят! Дождись завершения его задачи.'
    return
  end
  if obj.size==4 and newRole=='API' or obj.size==15 and newRole~='API' and newRole~='OFF' then
    deviceActionNote='Роль не подходит к количеству слотов.';return
  end
  if newRole=='MUT' or newRole=='IMP' then
    for _,other in ipairs(devices.peripherals) do
      if other.addr~=addr and roleOf(other)==newRole and activeMachine(other.addr) then
        deviceActionNote='Нельзя переназначить работающий '..roleName(newRole)..'.'
        return
      end
    end
  end
  bindings[addr]=bindings[addr] or {}
  bindings[addr].role=newRole
  if newRole=='MUT' or newRole=='IMP' then
    for k,b in pairs(bindings) do
      if k~=addr and b.role==newRole then b.role='OFF' end
    end
  end
  discover();rebuildRoutes();save()
  supplyAt=0
  deviceActionNote='Устройство '..addr:sub(1,8)..' назначено: '..roleName(newRole)..'. Теперь выбери его МЭ.'
  log('Bind '..addr..' '..newRole)
end
local function changeME(addr,meAddr)
  if activeMachine(addr) then
    deviceActionNote='Этот блок занят: во время операции менять МЭ нельзя.'
    return
  end
  local _,obj=deviceIndex(addr)
  if not obj then deviceActionNote='Выбранный блок исчез из сети.';return end
  local exists=false
  for _,m in ipairs(devices.me) do if m.addr==meAddr then exists=true;break end end
  if not exists then deviceActionNote='Этот МЭ-интерфейс не найден.';return end
  for k,b in pairs(bindings) do
    if k~=addr and b.me==meAddr and b.role and b.role~='OFF' then
      deviceActionNote='МЭ уже назначен другому блоку ('..k:sub(1,8)..'). DOWN единственный.'
      return
    end
  end
  bindings[addr]=bindings[addr] or {}
  if not bindings[addr].role then bindings[addr].role=(obj.size==15 and 'API' or 'OFF') end
  bindings[addr].me=meAddr
  rebuildRoutes();save();supplyAt=0
  deviceActionNote='Маршрут сохранён: '..meAddr:sub(1,8)..' → DOWN → '..addr:sub(1,8)
  log('ME route '..meAddr..' DOWN -> '..addr)
end
local function testMachine(addr)
  local _,target=deviceIndex(addr)
  if not target then deviceActionNote='Блок исчез. Обнови список.';return end
  local rr=downRoute(target)
  if not rr then deviceActionNote='Выбери МЭ над этим блоком.';return end
  local ok,has=invoke(rr.me.p,'canExport','DOWN')
  if not ok then deviceActionNote='МЭ не отвечает на canExport: '..tostring(has);return end
  if not has then deviceActionNote='ПРОВАЛ: У выбранного МЭ нет доступного инвентаря снизу.';return end
  if activeMachine(addr) then
    deviceActionNote='DOWN доступен. Передача посуды пока запрещена: блок занят.'
    return
  end
  local r=roleOf(target)
  if r=='API' then
    deviceActionNote='DOWN видит инвентарь. Пасека подтвердит маршрут при загрузке пчёл.'
    return
  end
  local slot=(r=='MUT') and 4 or ((r=='IMP' or r=='SAM' or r=='TRN') and 2 or nil)
  if not slot then deviceActionNote='Сначала выбери назначение этого блока.';return end
  -- Never arm a machine by accident: refuse a physical test with input bees.
  local inputSlots=(r=='MUT' and {1,2}) or (r=='IMP' and {1,3}) or {1,3}
  for _,i in ipairs(inputSlots) do
    if stack(target.p,i) then
      deviceActionNote='DOWN доступен. Физический тест не выполняется: занят входной слот '..i
      return
    end
  end
  local before=stack(target.p,slot)
  if before and not norm(itemid(before)):find('labware',1,true) then
    deviceActionNote='Слот '..slot..' занят не посудой. Проверка отменена.';return
  end
  if qty(before)>=CFG.targetLabware then
    deviceActionNote='DOWN доступен, посуда уже заполнена (64/64).';return
  end
  local res=getResource('labware')
  if not res then deviceActionNote='В МЭ нет лабораторной посуды.';return end
  local was=qty(before)
  local success,msg=exactMeExport(rr,res,1,slot)
  local after=stack(target.p,slot)
  if success and qty(after)>was then
    lastPhysicalRoute[addr]=rr.me.addr
    deviceActionNote='МАРШРУТ ПРОВЕРЕН: +1 посуда, слот '..slot..' ('..rr.me.addr:sub(1,8)..')'
  else
    deviceActionNote='Не подтвердилось: '..tostring(msg)..'. Проверь физическое размещение.'
  end
end
local function refreshEverything(reloadComponents)
  initializing=true;initStatus='Чтение МЭ и генетики'
  if reloadComponents then discover() end
  if primaryME() then meInventory() else error('МЭ-интерфейс не найден') end
  graphScan();scanApiaries();acquireRoute()
  initializing=false
  notice('Инвентаризация завершена. Проверь оборудование.')
end
local function collisionReport()
  rebuildRoutes()
  local seen={}
  local function check(dev,rt)
    if not dev or not rt then return nil end
    local id=rt.me.addr
    if seen[id] and seen[id]~=dev.addr then
      return 'МЭ '..id:sub(1,8)..' назначен двум блокам. DOWN обслуживает только один.'
    end
    seen[id]=dev.addr
  end
  local err=check(devices.mut[1],routes.mut)
  if err then return err end
  err=check(devices.imp[1],routes.imp)
  if err then return err end
  for _,api in ipairs(devices.api) do
    err=check(api,routes['api-'..api.addr]);if err then return err end
  end
  for _,obj in ipairs(devices.other) do
    local b=bindings[obj.addr]
    if b and (b.role=='SAM' or b.role=='TRN') then
      err=check(obj,routes['aux-'..obj.addr]);if err then return err end
    end
  end
end
local function tap(key)
  if key=='pause' then
    if initializing then return end
    if paused then
      if not routes.mut then notice('Назначь обычный мутатрон и его МЭ.',false);return end
      local conflict=collisionReport()
      if conflict then notice(conflict,false);return end
      if #graph==0 then notice('Нет дерева мутаций. Нужна подключённая промышленная пасека.',false);return end
      paused=false;nextPlanAt=0;notice('АВТОМАТИКА ЗАПУЩЕНА')
    else paused=true;notice('ПАУЗА: новые операции не запускаются') end
    save()
  elseif key=='settings' then
    -- Settings are a VIEW. Do not pause machines or network logic.
    page='settings'
  elseif key=='home' then
    page='home'
  elseif key=='logs' then
    page='logs'
  elseif key=='scan' then
    local ok,err=pcall(function() meInventory();scanApiaries() end)
    if not ok then notice('Ошибка сканирования: '..tostring(err),false)
    else notice('Обновлены МЭ и пасеки; автоматизация продолжает работу') end
  elseif key=='discover' then
    -- Re-resolve components but do not reset in-flight tasks.
    discover();rebuildRoutes()
    deviceActionNote='Компоненты обновлены. Привязки сохраняются по адресам.'
  elseif key=='genes' then
    CFG.trustSingleFilledTemplate=not CFG.trustSingleFilledTemplate
    save()
    if CFG.trustSingleFilledTemplate then
      deviceActionNote='Прививка ВКЛ для ВСЕХ пчёл перед пасеками. Шаблон — БЕЗ ГЕНА ВИДА!'
    else deviceActionNote='Прививка ВЫКЛ: если импринтер назначен, новые пасеки ждут разрешения.' end
  elseif key=='meup' then meOffset=math.max(0,meOffset-3)
  elseif key=='medown' then meOffset=meOffset+3
  elseif key=='up' then settingsOffset=math.max(0,settingsOffset-4)
  elseif key=='down' then settingsOffset=settingsOffset+4
  elseif key:sub(1,5)=='edit:' then
    selectedDevice=key:sub(6);meOffset=0
    page='detail'
    deviceActionNote='Назначь одну роль и интерфейс МЭ, стоящий сверху этого блока.'
  elseif key:sub(1,8)=='setrole:' then
    local v=key:sub(9);local addr,r=v:match('^([^:]+):(.+)$')
    if addr then changeRole(addr,r) end
  elseif key:sub(1,6)=='setme:' then
    local v=key:sub(7);local addr,meAddr=v:match('^([^:]+):(.+)$')
    if addr then changeME(addr,meAddr) end
  elseif key:sub(1,5)=='test:' then testMachine(key:sub(6))
  elseif key=='exit' then quit=true end
end
local function startup()
  load();paused=true
  local ok,err=pcall(discover)
  if not ok then notice('Поиск компонентов: '..tostring(err),true) end
  acquireRoute()
  if stage~='idle' or next(apiJobs) or apiPrep then
    notice('Восстановлены незавершённые операции. Проверь машины до пуска.',true)
  end
  log('BeeMaster 9.0 started')
end
startup()
-- First show graphics, then query a large ME network.
local okDraw,whyDraw=pcall(draw)
if not okDraw then print('Ошибка экрана: '..tostring(whyDraw)) end
local okInit,errInit=pcall(refreshEverything,false)
if not okInit then initializing=false;notice('Начальная загрузка: '..tostring(errInit),true) end
local lastDraw,lastCycle,lastApiaryCheck=0,0,0
while not quit do
  local now=computer.uptime()
  -- Catch user input first for good menu responsiveness.
  local ev,a,x,y=event.pull(0.12,'touch')
  if ev=='touch' and x and y then
    local pressed=nil
    for _,b in ipairs(buttons) do
      if y==b.y and x>=b.x and x<b.x+b.w then pressed=b.action;break end
    end
    if pressed then
      local ok,err=pcall(tap,pressed)
      if not ok then notice('Кнопка: '..tostring(err),false) end
      local gd,er=pcall(draw)
      if not gd then print('GUI: '..tostring(er));quit=true end
      lastDraw=computer.uptime()
      lastUIActivity=lastDraw
    end
  end
  now=computer.uptime()
  -- This engine does NOT test the current GUI page: it runs on every screen.
  if not initializing and now-lastCycle>=CFG.tick then
    lastCycle=now
    cycle()
  end
  if not initializing and now-lastApiaryCheck>=CFG.apiaryScan then
    lastApiaryCheck=now
    if #devices.api>0 then
      local ok,err=pcall(scanApiaries)
      if not ok then log('Ошибка проверки пасек: '..tostring(err)) end
    end
  end
  if now-lastDraw>=drawInterval then
    lastDraw=now
    local ok,err=pcall(draw)
    if not ok then print('GUI: '..tostring(err));quit=true end
  end
end
save()
gpu.setResolution(originalW,originalH)
gpu.setForeground(COLOR.fg)
gpu.setBackground(0)
print('BeeMaster stopped; saved '..DATA)
