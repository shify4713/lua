    if initializing then return end
    if paused then
      if not routes.mut then notice('Назначь мутатрон и его МЭ в ОБОРУДОВАНИИ.',true);return end
      local conflict=collisionReport()
      if conflict then notice(conflict,true);return end
      if #graph==0 then notice('Нет дерева мутаций: подключи пасеку с getBeeBreedingData.',true);return end
      paused=false;nextPlanAt=0;notice('АВТОМАТИКА ЗАПУЩЕНА')
    else paused=true;notice('ПАУЗА: новые задачи не выдаются') end
    save()
  elseif key=='settings' then
    paused=true;page='settings';save()
  elseif key=='home' then
    page='home';discover();rebuildRoutes();save()
  elseif key=='scan' then
    paused=true
    local ok,err=pcall(refreshEverything,true)
    initializing=false
    if not ok then notice('Ошибка обновления: '..tostring(err),true) end
  elseif key=='discover' then
    paused=true;discover();rebuildRoutes();notice('Оборудование перечитано')
  elseif key=='genes' then
    if not paused or stage~='idle' then notice('Поставь на паузу и закончи текущую задачу.',true);return end
    CFG.trustSingleFilledTemplate=not CFG.trustSingleFilledTemplate
