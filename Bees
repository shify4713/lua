local function redraw()
  gpu.setBackground(colors.bg)
  gpu.fill(1,1,W,H," ")
  buttons={}
  if page=="diag" then drawDiag() else drawMain() end
end
local function requireReady()
  assert(selectedME(),"МЭ не найдена")
  assert(selectedMut(),"Мутатор не найден")
  assert(selectedSide(),"Выбери направление МЭ кнопкой СТОРОНА >")
end
local function exportOne(which)
  requireReady()
  local index = which=="p" and pIndex or dIndex
  local candidates = which=="p" and beesP or beesD
  local entry=candidates[index]
  assert(entry, "Не выбрана " .. (which=="p" and "принцесса" or "трутень"))
  local target=which=="p" and 1 or 2
  assert(not readSlot(4),"Убери посуду из слота 4 перед тестом")
  assert(not readSlot(3),"Слот результата 3 занят")
  assert(not readSlot(target),"Целевой слот "..target.." уже занят")
  local me,side=selectedME(),selectedSide()
  local ok,result=invoke(me.proxy,"exportItem",entry.fingerprint,side.arg,1,target)
  if not ok then
    local low = side.arg:lower()
    ok,result=invoke(me.proxy,"exportItem",entry.fingerprint,low,1,target)
  end
  if not ok then error("Экспорт МЭ: "..tostring(result)) end
  local moved=readSlot(target)
  assert(moved, "Слот "..target.." пуст. Проверь направление и соседство блоков")
  assert(role(moved.name or moved.id)==which,
    "В слот "..target.." попал другой предмет: "..itemTitle(moved))
  return itemTitle(moved)
end
local function loadAction(mode)
  if mode=="p" or mode=="d" then
    local title=exportOne(mode)
    say("Загружено: "..title,colors.green)
  else
    requireReady()
    assert(not readSlot(1) and not readSlot(2) and not readSlot(3) and not readSlot(4),
      "Перед загрузкой ОБОИХ очисти слоты 1-4")
    local title=exportOne("p")
    local ok,result=pcall(exportOne,"d")
    if ok then
      say("Оба родителя загружены!",colors.green,title.." + "..result)
    else
      say("Принцесса загружена, трутень НЕ загружен!",colors.red,tostring(result))
    end
  end
end
local function startAction()
  requireReady()
  assert(readSlot(1) and readSlot(2),"Нужны принцесса и трутень")
  assert(not readSlot(3),"Слот результата занят")
  assert(not readSlot(4),"Посуда уже в мутаторе")
  local available=0
  for i=5,10 do if readSlot(i) then available=available+1 end end
  assert(available>0,"Нет возможных мутаций: смени пару родителей")
  assert(supplies[1],"В МЭ нет лабораторной посуды Gendustry")
  local me,side=selectedME(),selectedSide()
  local ok,result=invoke(me.proxy,"exportItem",supplies[1].fingerprint,side.arg,1,4)
  if not ok then ok,result=invoke(me.proxy,"exportItem",supplies[1].fingerprint,side.arg:lower(),1,4) end
  assert(ok,"Посуда не подана: "..tostring(result))
  local item=readSlot(4)
  say("Подача посуды: "..(item and "есть в слоте" or "слот пуст (возможно, пошла работа)"),
    colors.yellow,"Мутацию нужно выбрать в интерфейсе мутатрона")
end
local function countQueen(species)
  local m=selectedME()
  if not m then return nil end
  local ok,entries=invoke(m.proxy,"getItemsInNetwork")
  if not ok or type(entries)~="table" then return nil end
  local number=0
  for _,e in pairs(entries) do
    if type(e)=="table" and role(e.name or e.id)=="q" then
      local ind=type(e.individual)=="table" and e.individual or {}
      if ind.ident==species then number=number+(tonumber(e.size or e.qty) or 1) end
    end
  end
  return number
end
local function takeAction()
  requireReady()
  local output=readSlot(3)
  assert(output and role(output.name or output.id)=="q", "В выходном слоте 3 нет матки")
  local side=selectedSide()
  local opposite=reverse[side.name]
  assert(opposite,"Неизвестное направление")
  local species=(output.individual or {}).ident
  local before=countQueen(species)
  local mut=selectedMut()
  local ok,moved=invoke(mut.proxy,"pushItem",opposite,3,1)
  if not ok then ok,moved=invoke(mut.proxy,"pushItem",opposite:lower(),3,1) end
  assert(ok,"Возврат не сработал: "..tostring(moved))
  if readSlot(3) then
    say("Матка всё ещё в слоте 3; перенос не подтверждён",colors.red,
      "Возможно, нужна МЭ-шина импорта или другое направление")
    return
  end
  local after=countQueen(species)
  if before and after and after>before then
    say("Матка возвращена в МЭ! "..before.." -> "..after,colors.green)
  else
    say("Матка вышла из мутатрона, но МЭ её ещё не подтвердила",colors.yellow,
      "Проверь МЭ-интерфейс и саму сеть")
  end
end
local function refreshAll()
  identify()
  refreshBees()
  log("SCAN: ME="..#mes.." MUT="..#muts.." P="..#beesP.." D="..#beesD)
end
local function confirmAction(key)
  if awaiting ~= key then
    awaiting=key
    if key=="start" then
      say("ПОДТВЕРДИ ПУСК: нажми ПУСК ещё раз",colors.yellow,
        "Программа подаст посуду. Мутацию выбираешь в GUI мутатрона.")
    elseif key=="take" then
      say("ПОДТВЕРДИ ВОЗВРАТ: нажми ЗАБРАТЬ ещё раз",colors.yellow)
    else
      say("ПОДТВЕРДИ ПЕРЕНОС ПЧЁЛ: нажми эту же кнопку ещё раз",colors.yellow,
        "Проверим только загрузку. Без посуды скрещивания не будет.")
    end
    return
  end
  awaiting=nil
  local ok,err=pcall(function()
    if key=="load-p" then loadAction("p")
    elseif key=="load-d" then loadAction("d")
    elseif key=="load-both" then loadAction("both")
    elseif key=="start" then startAction()
    elseif key=="take" then takeAction() end
  end)
  if not ok then say("ОШИБКА: "..tostring(err),colors.red,"Подробности: "..logPath) end
end
local function click(key)
  if key=="quit" then quit=true;return end
  if key=="back" then page="main";awaiting=nil;return end
  if key=="diag" then page="diag";awaiting=nil;return end
  if key=="refresh" then
    awaiting=nil
    local ok,err=pcall(refreshAll)
    if not ok then say("Сканирование: "..tostring(err),colors.red) end
    return
  end
  if key=="me" then
    if #mes>0 then meIndex=(meIndex % #mes)+1 end
    local m=selectedME()
    sideIndex=(m and m.confirmed==1) and 1 or 0
    refreshBees()
    awaiting=nil
    return
  end
  if key=="mut" then
    if #muts>0 then mutIndex=(mutIndex % #muts)+1 end
    awaiting=nil
    say("Выбран мутатрон "..(selectedMut() and selectedMut().address:sub(1,8) or "не найден"))
    return
  end
  if key=="side" then
    local m=selectedME()
    if m and #m.sides>0 then sideIndex=(sideIndex % #m.sides)+1 end
    awaiting=nil
    local side=selectedSide()
    say("Направление МЭ: "..(side and names[side.name] or "нет"),colors.yellow,
      "Для экспорта МЭ-интерфейс должен касаться нужного мутатрона")
    return
  end
  if key=="p-prev" then pPage=math.max(1,pPage-1);awaiting=nil;return end
  if key=="p-next" then pPage=math.min(math.max(1,math.ceil(#beesP/5)),pPage+1);awaiting=nil;return end
  if key=="d-prev" then dPage=math.max(1,dPage-1);awaiting=nil;return end
  if key=="d-next" then dPage=math.min(math.max(1,math.ceil(#beesD/5)),dPage+1);awaiting=nil;return end
  confirmAction(key)
end
local function main()
  local f=io.open(logPath,"w")
  if f then f:write("BeeMaster V4 started\n");f:close() end
  local ok,err=pcall(refreshAll)
  if not ok then say("Ошибка поиска: "..tostring(err),colors.red) end
  while not quit do
    local drawn,problem=pcall(redraw)
    if not drawn then
      say("Ошибка экрана: "..tostring(problem),colors.red)
      page="diag"
    end
    local name,_,x,y=event.pull(1)
    if name=="touch" then
      local handled=false
      if page=="main" then
        if y>=7 and y<=11 and x>=2 then
          local n=(pPage-1)*5+y-6
          if beesP[n] then pIndex=n;awaiting=nil;handled=true end
        elseif y>=14 and y<=18 and x>=2 then
          local n=(dPage-1)*5+y-13
          if beesD[n] then dIndex=n;awaiting=nil;handled=true end
        end
      end
      if not handled then
        for _,b in ipairs(buttons) do
          if y==b.y and x>=b.x and x<b.x+b.len then
            local ok2,err2=pcall(click,b.key)
            if not ok2 then say("ОШИБКА: "..tostring(err2),colors.red) end
            handled=true
            break
          end
        end
      end
      if not handled then awaiting=nil end
    elseif name=="key_down" then
      if x==113 or x==81 then quit=true
      elseif x==114 or x==82 then
        local ok2,err2=pcall(refreshAll)
        if not ok2 then say("ОШИБКА: "..tostring(err2),colors.red) end
      end
    end
  end
end
local ok,errorText=pcall(main)
gpu.setForeground(prevFG)
gpu.setBackground(prevBG)
gpu.setResolution(prevW,prevH)
if not ok then io.stderr:write("BeeMaster V4 ERROR: ",tostring(errorText),"\n") end
print("BeeMaster V4 закрыт. Пчёлы не выгружаются автоматически.")
