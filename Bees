local function changeRole(addr)
  if not paused or stage~='idle' or next(apiJobs) then
    notice('Изменять оборудование можно только при остановленных задачах.',true);return
  end
  local obj
  for _,v in ipairs(devices.peripherals) do if v.addr==addr then obj=v;break end end
  if not obj then return end
  local old=roleOf(obj)
  local r
  if obj.size==4 then
    if old=='OFF' then r=(#devices.mut>0 and 'IMP' or 'MUT')
    elseif old=='MUT' then r='IMP'
    elseif old=='IMP' then r='SAM'
    elseif old=='SAM' then r='TRN'
    else r='OFF' end
  elseif obj.size==15 then
    r=old=='API' and 'OFF' or 'API'
  else notice('Только 4- и 15-слотовые устройства поддерживаются',false);return end
  bindings[addr]=bindings[addr] or {}
  if r=='MUT' or r=='IMP' then
    for k,b in pairs(bindings) do if k~=addr and b.role==r then b.role='OFF' end end
  end
  bindings[addr].role=r
  discover();rebuildRoutes();save()
  notice('Роль '..addr:sub(1,8)..' = '..roleName(r))
end
local function changeME(addr)
  if not paused or stage~='idle' or next(apiJobs) then
    notice('Маршрут нельзя менять во время операций.',true);return
  end
  if #devices.me==0 then notice('МЭ-интерфейсы не обнаружены.',true);return end
  bindings[addr]=bindings[addr] or {}
  if not bindings[addr].role then
    for _,v in ipairs(devices.peripherals) do
      if v.addr==addr then bindings[addr].role=(v.size==15 and 'API' or 'OFF');break end
    end
  end
  local i=meIndex(bindings[addr].me) or 0
  i=i+1
  if i>#devices.me then i=0 end
  bindings[addr].me=i==0 and nil or devices.me[i].addr
  rebuildRoutes();save()
  notice('Привязка МЭ: '..(i>0 and tostring(i) or 'АВТО/НЕ ВЫБРАН'))
end
local function testMachine(addr)
  if not paused or stage~='idle' or next(apiJobs) then
    notice('Тест только на паузе без незавершённых операций.',true);return
  end
  local target
  for _,obj in ipairs(devices.peripherals) do if obj.addr==addr then target=obj;break end end
  if not target then notice('Блок исчез. ОБНОВИ оборудование.',false);return end
  rebuildRoutes()
  local rr=downRoute(target)
  if not rr then notice('Не выбрано МЭ над блоком '..addr:sub(1,8),false);return end
  local ok,has=invoke(rr.me.p,'canExport','DOWN')
  if not ok then notice('Не удаётся проверить DOWN: '..tostring(has),false);return end
  if not has then notice('МЭ '..rr.me.addr:sub(1,8)..': НЕТ инвентаря снизу!',false);return end
  local r=roleOf(target)
  if r=='API' then
    notice('DOWN доступен, но нужная пасека подтверждается только при подаче пчелы.');return
  end
  local slot=(r=='MUT') and 4 or ((r=='IMP' or r=='SAM' or r=='TRN') and 2 or nil)
  if not slot then notice('Назначь роль блока прежде чем тестировать.',false);return end
  local before=stack(target.p,slot)
  if before and not norm(itemid(before)):find('labware',1,true) then
    notice('В тестовом слоте '..slot..' уже другой предмет: '..title(before),false);return
  end
  if qty(before)>=CFG.targetLabware then
    notice('Посуды уже 64 в слоте '..slot..'. Для физической проверки освободи 1 место.');return
  end
  local res= getResource('labware')
  if not res then notice('Нет посуды в МЭ для теста.',false);return end
  local old=qty(before)
  local success,msg=exactMeExport(rr,res,1,slot)
  local after=stack(target.p,slot)
  if success and qty(after)>old then
    lastPhysicalRoute[addr]=rr.me.addr
    notice('ПРОВЕРЕНО: МЭ '..rr.me.addr:sub(1,8)..' -> '..roleName(r)..' '..addr:sub(1,8)..' (слот '..slot..')')
  else
    notice('НЕ ПРОВЕРЕНО: '..tostring(msg)..'. Проверь МЭ НАД ЭТИМ блоком.',false)
  end
end
