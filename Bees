local quit=false
local function tap(key)
  if key=='pause' then
    paused=not paused
    if not paused then
      if not routes.mut then
        paused=true
        notice('Нет МЭ-маршрута в мутатрон. Поставь МЭ-интерфейс вплотную.',true)
      elseif #graph==0 then
        paused=true
        notice('Без данных getBeeBreedingData автовыведение не запускается.',true)
      else notice('Автоматика включена') end
    else notice('Пауза: текущие предметы не перемещаются') end
    save()
  elseif key=='scan' then
    paused=true
    local ok,err=pcall(function()
      discover();meInventory();graphScan();scanApiaries();acquireRoute()
    end)
    if ok then nextPlanAt=0;notice('Обновление завершено. Сначала проверь маршрут и пасеки.')
    else notice('Сканирование: '..tostring(err),true) end
  elseif key=='exit' then quit=true
  end
end

local function startup()
  load()
  local ok,err=pcall(function()
    discover()
    if primaryME() then meInventory() end
    graphScan();scanApiaries();acquireRoute()
  end)
  if not ok then notice('Ошибка старта: '..tostring(err),true) end
  if stage~='idle' then
    paused=true
    notice('После рестарта найдена незавершённая задача. Проверь оборудование.',true)
  end
  save()
  log('BeeMaster Factory started')
end

startup()
local lastDraw,lastCycle=0,0
while not quit do
  local now=computer.uptime()
  if now-lastCycle>=CFG.tick then
    lastCycle=now
    cycle()
  end
  if now-lastApiary>=CFG.apiaryScan then
    lastApiary=now
    if #devices.api>0 then
      local ok=pcall(scanApiaries)
      if not ok then log('Apiary read error') end
    end
  end
  if now-lastDraw>=1 then
    lastDraw=now
    local ok,err=pcall(draw)
    if not ok then print('GUI: '..tostring(err));quit=true end
  end
  local _,_,x,y=event.pull(0.35,'touch')
  if x and y then
    for _,b in ipairs(buttons) do
      if y==b.y and x>=b.x and x<b.x+b.len then
        local ok,err=pcall(tap,b.cb)
        if not ok then notice('Кнопка: '..tostring(err),true) end
        break
      end
    end
  end
end
