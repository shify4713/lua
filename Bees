local function beeSpeciesFor(fp,me)
  if not fp then return nil end
  local key=fingerprintKey(fp)
  local detail=detailCache[key]
  if not detail and me then
    local ok,d=invoke(me.p,'getItemDetail',fp,false)
    if ok and type(d)=='table' then
      detail=compactDetail(d); d=nil
      if detail then detailCache[key]=detail end
    end
  end
  return type(detail)=='table' and type(detail.individual)=='table'
     and detail.individual.ident or nil
end
local function liveFingerprint(route,request,n,strict)
  if not route or not route.me then return nil,'Не выбран МЭ-интерфейс' end
  local fp=request and request.fingerprint
  if type(fp)~='table' or not fp.id then return nil,'Некорректный отпечаток предмета' end
  local ok,items=pcall(getList,route.me.p)
  if not ok then return nil,'МЭ интерфейс '..route.me.addr:sub(1,8)..' не отвечает: '..tostring(items) end
  local required=math.max(1,tonumber(n) or 1)
  local key=fingerprintKey(fp)
  local count=0
  for _,item in pairs(items) do
    if type(item)=='table' and type(item.fingerprint)=='table'
       and fingerprintKey(item.fingerprint)==key then
      count=qty(item)
      if count>=required then return item end
    end
  end
  if strict then return nil,'Обработанная в импринтере пчела больше не найдена по точному NBT' end
  local wantedKind=role({id=fp.id})
  local wantedSpecies=beeSpeciesFor(fp)
  if wantedKind and wantedSpecies then
    for _,item in pairs(items) do
      if type(item)=='table' and type(item.fingerprint)=='table' and qty(item)>=required
         and role({id=item.fingerprint.id})==wantedKind then
        local sp=beeSpeciesFor(item.fingerprint,route.me)
        if sp==wantedSpecies then
          log('Fresh fingerprint found for '..wantedKind..' '..sp)
          return item
        end
      end
    end
  end
  return nil,string.format('Пчела/предмет отсутствует в МЭ %s (доступно %d вместо %d). '..
    'Возможно, предмет уже забрали, NBT изменился или интерфейсы подключены к РАЗНЫМ МЭ-сетям.',
    route.me.addr:sub(1,8),count,required)
end
local function physicalSpeciesCount(route,uid,beeRole)
  if not uid then return 0 end
  local ok,items=pcall(getList,route.me.p)
  if not ok then return 0 end
  local total=0
  for _,v in pairs(items) do
    if type(v)=='table' and type(v.fingerprint)=='table' and qty(v)>0
       and role({id=v.fingerprint.id})==beeRole then
      if beeSpeciesFor(v.fingerprint,route.me)==uid then total=total+qty(v) end
    end
  end
  return total
end
local function debitInventory(fp,n)
  local key=fingerprintKey(fp)
  for _,v in pairs(available) do
    if type(v)=='table' and type(v.fingerprint)=='table' and fingerprintKey(v.fingerprint)==key then
      local new=math.max(0,qty(v)-n)
      if v.size~=nil then v.size=new end
      if v.qty~=nil then v.qty=new end
    end
  end
  for _,sp in pairs(catalog) do
    for _,e in ipairs(sp.entries) do
      if fingerprintKey(e.fp)==key then
        local change=math.min(e.count,n)
        e.count=e.count-change
        local k= e.role=='P' and 'p' or (e.role=='D' and 'd' or 'q')
        sp[k]=math.max(0,(sp[k] or 0)-change)
      end
    end
  end
end
local function exactMeExport(route,entry,n,slot,strict)
  if not route or not entry or not entry.fingerprint then
    return false,'Не указан МЭ-интерфейс для этой машины'
  end
  local ok,yes=invoke(route.me.p,'canExport','DOWN')
  if ok and not yes then
    return false,'У выбранного МЭ-интерфейса нет инвентаря СНИЗУ'
  end
  local current,why=liveFingerprint(route,entry,n,strict)
  if not current then
    exportFailureCount=exportFailureCount+1
    stockWarning=tostring(why)
    return false,tostring(why)
  end
  local called,r=invoke(route.me.p,'exportItem',current.fingerprint,'DOWN',n,slot)
  if not called then
    exportFailureCount=exportFailureCount+1
    return false,tostring(r)
  end
  if r==nil or r==false then
    exportFailureCount=exportFailureCount+1
    return false,'МЭ не передала предмет (целевой слот занят, предмет не принимается или сеть недоступна)'
  end
  local amount=type(r)=='table' and tonumber(r.size or r.qty)
  if amount and amount<1 then
    exportFailureCount=exportFailureCount+1
    return false,'Передано 0: машина/слот не принимает предмет или нет запаса'
  end
  local delivered=amount or n
  if delivered<n then return false,'Передано только '..delivered..' из '..n..' предметов' end
  debitInventory(current.fingerprint,delivered)
  stockWarning=''
  return true,r,current.fingerprint
end
local function acquireRoute()
  rebuildRoutes()
  if not routes.mut then log('МУТ: выбери МЭ-интерфейс в настройках') end
  if #devices.imp>0 and not routes.imp then
    log('ИМП: выбери МЭ-интерфейс в настройках')
  end
end
local function refill(machine,route,slot)
  if not machine or not route then return false end
  local current=stack(machine.p,slot)
  if current and not norm(itemid(current)):find('labware',1,true) then return false end
  local have=current and qty(current) or 0
  if have>=CFG.targetLabware then return true end
  local lab=getResource('labware')
  if not lab then return false end
  local count=math.min(CFG.targetLabware-have,qty(lab))
  if count<=0 then return false end
  local ok=exactMeExport(route,lab,count,slot)
  if not ok then return false end
  local after=stack(machine.p,slot)
  return after and norm(itemid(after)):find('labware',1,true)~=nil
end
local function supplyMachine(machine,route,slot,label)
  if not route then
    supplyStatus[label]='МЭ НЕ ВЫБРАН'
    return false
  end
  local before=stack(machine.p,slot)
  local oldqty=qty(before)
  if oldqty>=CFG.targetLabware then
    supplyStatus[label]='64/64'
    return true
  end
  local ok=refill(machine,route,slot)
  local after=stack(machine.p,slot)
  local count=qty(after)
  if ok and count>oldqty then lastPhysicalRoute[machine.addr]=route.me.addr end
  supplyStatus[label]=ok and (tostring(count)..'/64') or ('НЕ ДОСТАВЛЕНО '..tostring(count)..'/64')
  return ok
end
local function supplyAll(now)
  if now<supplyAt then return end
  supplyAt=now+90
  local m=devices.mut[1]
  if m then supplyMachine(m,routes.mut,4,'МУТ') end
  local im=devices.imp[1]
  if im then supplyMachine(im,routes.imp,2,'ИМП') end
  for _,aux in ipairs(devices.other) do
    local b=bindings[aux.addr]
    if b and (b.role=='SAM' or b.role=='TRN') then
      supplyMachine(aux,routes['aux-'..aux.addr],2,b.role..':'..aux.addr:sub(1,5))
    end
  end
end
local function input(machine,route,fp,slot,mayConsume)
  assert(not stack(machine.p,slot),'Слот уже занят: '..slot)
  local ok,r,actual=exactMeExport(route,{fingerprint=fp},1,slot)
  if not ok then error('МЭ -> слот '..slot..': '..tostring(r)) end
  if not mayConsume then
    assert(stack(machine.p,slot),'Предмет не появился в слоте '..slot..'. Проверь назначенный МЭ')
  end
  return actual
end
local function meCount(fp)
  if not fp then return 0 end
  local t=getList();local key=fingerprintKey(fp)
  for _,e in pairs(t) do
    if e.fingerprint and fingerprintKey(e.fingerprint)==key then return qty(e) end
  end
  return 0
end
local function isStoneMutationSource(uid,name)
  local a=norm(uid..' '..tostring(name or ''))
  return a:find('rocky',1,true)~=nil or a:find('stone',1,true)~=nil or
         a:find('камен',1,true)~=nil
end
local function findRecipe()
  local opts={}
  for _,m in ipairs(graph) do
    local aUid=nameToUid[norm(m.a)] or m.a
    local bUid=nameToUid[norm(m.b)] or m.b
    local rUid=nameToUid[norm(m.result)] or m.result
    local dest=catalog[rUid]
    local alreadyGrowing=false
    for _,w in pairs(apiJobs) do
      if w.uid==rUid then alreadyGrowing=true;break end
    end
    if not alreadyGrowing and (not dest or (dest.p+dest.q)==0) then
      for _,pair in ipairs({{aUid,bUid},{bUid,aUid}}) do
        local p,d=catalog[pair[1]],catalog[pair[2]]
        local neededPrincess=CFG.allowLastPrincess and 1 or CFG.minPrincessReserve+1
        local neededDrone=CFG.allowLastDrone and 1 or CFG.minDroneReserve+1
        if p and d and p.p>=neededPrincess and d.d>=neededDrone
           and not (CFG.protectStoneMutations and isStoneMutationSource(pair[1],p.name)) then
          local key=norm(m.a)..'+'..norm(m.b)..'='..norm(m.result)
          if (failures[key] or 0)<CFG.maxFailedPerRecipe then
            local pe,de
            for _,v in ipairs(p.entries) do if v.role=='P' then pe=v;break end end
            for _,v in ipairs(d.entries) do if v.role=='D' then de=v;break end end
            if pe and de then
              opts[#opts+1]={m=m,key=key,p=pe,d=de,wanted=rUid,
                priority=(m.chance or 0)+math.min(p.p,10)}
            end
          end
        end
      end
    end
  end
  table.sort(opts,function(a,b)
    if a.priority==b.priority then return a.key<b.key end
    return a.priority>b.priority
  end)
  return opts[1]
end
local function recipeStockInfo()
  local ready,waiting,examples=0,0,{}
  local seen={}
  for _,m in ipairs(graph) do
    local result=nameToUid[norm(m.result)] or m.result
    local dest=catalog[result]
    if not dest or (dest.p+dest.q)==0 then
      local k=norm(m.a)..'|'..norm(m.b)..'='..norm(m.result)
      if not seen[k] then
        seen[k]=true
        local parentA=nameToUid[norm(m.a)] or m.a
        local parentB=nameToUid[norm(m.b)] or m.b
        local best=99
        local hint=''
        for _,pair in ipairs({{parentA,parentB},{parentB,parentA}}) do
          local p=catalog[pair[1]]
          local d=catalog[pair[2]]
          local pc=p and p.p or 0
          local dc=d and d.d or 0
          local missing=math.max(0,2-pc)+math.max(0,5-dc)
          if p and isStoneMutationSource(pair[1],p.name) then missing=missing+100 end
          if missing<best then
            best=missing
            local pName=p and p.name or tostring(pair[1])
            local dName=d and d.name or tostring(pair[2])
            hint=tostring(m.result)..': '..pName..' П='..pc..'/2, '..dName..' Т='..dc..'/5'
          end
        end
        if best==0 then ready=ready+1 else
          waiting=waiting+1
          if #examples<12 then examples[#examples+1]={n=best,msg=hint} end
        end
      end
    end
  end
  table.sort(examples,function(a,b)return a.n<b.n end)
  graphInfo={ready=ready,waiting=waiting,possible=ready+waiting,example=examples[1] and examples[1].msg or ''}
end
local function planMutation()
  if #graph==0 then notice('Нет дерева мутаций: подключи промышленную пасеку к адаптеру.',true);return end
  local route,m=routes.mut,devices.mut[1]
  if not (route and m) then notice('Нет маршрута МЭ -> обычный мутатрон.',true);return end
  if stack(m.p,1) or stack(m.p,2) or stack(m.p,3) then
    notice('Мутатрон занят. Не загружаю других пчёл.',true);return
  end
  local recipe=findRecipe()
  if not recipe then
    mode='Мутаций пока нет: пасеки растят родителей'
    return
  end
  local allowed={}
  for _,rule in ipairs(graph) do
    if (norm(rule.a)==norm(recipe.m.a) and norm(rule.b)==norm(recipe.m.b)) or
       (norm(rule.b)==norm(recipe.m.a) and norm(rule.a)==norm(recipe.m.b)) then
      allowed[nameToUid[norm(rule.result)] or rule.result]=true
    end
  end
  local liveP,errP=liveFingerprint(route,{fingerprint=recipe.p.fp},1)
  local liveD,errD=liveFingerprint(route,{fingerprint=recipe.d.fp},1)
  if not liveP or not liveD then
    stockWarning='Мутатрон ждёт родителей: '..tostring(errP or errD)
    mode='Ожидание: МЭ обновляется после изменения запасов'
    nextMutationPlanAt=computer.uptime()+45
    pendingApiaryRefresh=true
    return
  end
  local princessSpecies=beeSpeciesFor(liveP.fingerprint,route.me)
  local droneSpecies=beeSpeciesFor(liveD.fingerprint,route.me)
  local princeNeed=CFG.allowLastPrincess and 1 or CFG.minPrincessReserve+1
  local droneNeed=CFG.allowLastDrone and 1 or CFG.minDroneReserve+1
  local princessStock=physicalSpeciesCount(route,princessSpecies,'P')
  local droneStock=physicalSpeciesCount(route,droneSpecies,'D')
  if princessStock<princeNeed or droneStock<droneNeed then
    stockWarning='Не трогаю резерв родителей в МЭ над мутатроном: принцесс '..
      princessStock..'/'..princeNeed..', трутней '..droneStock..'/'..droneNeed
    mode='Жду размножения родителей до безопасного запаса'
    nextMutationPlanAt=computer.uptime()+60
    pendingApiaryRefresh=true
    return
  end
  job={recipe=recipe.key,wanted=recipe.wanted,pfp=liveP.fingerprint,dfp=liveD.fingerprint,
    name=recipe.m.result,started=computer.uptime(),step='mutation',
    allowed=allowed,baseline=queenSnapshot()}
  stage='mutation';save()
  if not supplyMachine(m,route,4,'МУТ') and not stack(m.p,4) then error('Нет посуды в мутатроне: проверь МЭ над ним и DOWN') end
  job.pfp=input(m,route,job.pfp,1) or job.pfp
  job.dfp=input(m,route,job.dfp,2,true) or job.dfp
  mode='Скрещивание: '..job.name
  log('Breeding target '..job.name)
  save()
end
local function nextAfterQueen()
  if job.result==job.wanted then
    known[job.result]=true
    created[job.result]=true
    log('BREED OK '..job.resultTitle)
  else
    failures[job.recipe]=(failures[job.recipe] or 0)+1
    log('OTHER mutation '..job.resultTitle..' (attempt '..failures[job.recipe]..')')
  end
  job.step='post_queen';stage='post_queen'
  save()
end
local function observeNewQueen()
  local matches={}
  for _,m in ipairs(newQueens(job.baseline or {})) do
    if not job.allowed or job.allowed[m.uid] then matches[#matches+1]=m end
  end
  if #matches>1 then
    notice('Несколько новых маток в МЭ одновременно. Нужна ручная проверка.',true)
    return
  end
  if #matches==1 then
    local e=matches[1]
    job.result=e.uid;job.resultTitle=e.name
    job.queenFP=e.entry.fp
    log('Queen imported: '..e.name)
    nextAfterQueen()
  end
end
local function processMutation(now)
  local m=devices.mut[1]
  if not m then notice('Мутатрон исчез из сети.',true);return end
  local output=stack(m.p,3)
  if output and role(output)~='Q' then
    notice('Мутатрон выдал не матку: '..title(output),true);return
  end
  if now-lastME>=CFG.busyScan or pendingRefresh then
    pendingRefresh=false;meInventory();observeNewQueen()
  end
  if stage=='mutation' and now-job.started>CFG.timeout then
    notice('Мутация слишком долгая. Проверь мутаген, питание и шину импорта.',true)
  end
end
local function processImprint(now)
  local imp=devices.imp[1]
  if not imp or not routes.imp then job.step='post_queen';stage='post_queen';return end
  if job.step=='imprint_start' then
    if stack(imp.p,3) or stack(imp.p,4) then
      notice('Импринтер занят (слоты 3/4).',true);return
    end
    if not supplyMachine(imp,routes.imp,2,'ИМП') and not stack(imp.p,2) then
      notice('Нет посуды в импринтере. Проверь его МЭ и DOWN.',true);return
    end
    if not stack(imp.p,1) then
      if not template then
        notice('В импринтере нет шаблона, а в МЭ не найден единственный заполненный шаблон.',true);return
      end
      input(imp,routes.imp,template.fp,1)
    end
    local bee=chooseQueen(job.result)
    if not bee then notice('Матка для импринтера не найдена в МЭ.',true);return end
    job.queenFP=bee.fp
    job.imprintPrevCount=meCount(bee.fp)
    job.baseline=queenSnapshot()
    input(imp,routes.imp,bee.fp,3,true)
    job.step='imprint_wait';job.started=now
    save()
  elseif job.step=='imprint_wait' then
    local out=stack(imp.p,4)
    if out and role(out)~='Q' then
      notice('Импринтер выдал отходы/не матку; возможна гибель пчелы!',true);return
    end
    if now-lastME>=CFG.busyScan or pendingRefresh then
      pendingRefresh=false;meInventory()
      local matches={}
      for _,m in ipairs(newQueens(job.baseline or {})) do
        if m.uid==job.result then matches[#matches+1]=m end
      end
      if #matches==0 and job.queenFP and
          meCount(job.queenFP)>=(job.imprintPrevCount or math.huge) then
        local x=chooseQueen(job.result)
        if x and fingerprintKey(x.fp)==fingerprintKey(job.queenFP) then
          matches[1]={uid=job.result,entry=x,name=job.resultTitle}
        end
      end
      if #matches==1 then
        job.queenFP=matches[1].entry.fp
        job.step='post_queen';stage='post_queen'
        log('Imprinted queen returned: '..matches[1].name)
        save()
      elseif #matches>1 then notice('Несколько маток после импринтера: проверь вручную.',true) end
    end
    if stage=='imprint' and now-job.started>CFG.timeout then
      notice('Импринтер не завершил работу: посуда/энергия/импорт.',true)
    end
  end
end
local function processPostQueen()
  local uid=job and job.result
