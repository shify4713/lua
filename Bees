      if not ok then log('Ошибка проверки пасек') end
    end
  end
  if now-lastDraw>=1 then
    lastDraw=now
    local ok,err=pcall(draw)
    if not ok then print('GUI: '..tostring(err));quit=true end
  end
  local _,_,x,y=event.pull(0.25,'touch')
  if x and y then
    for _,b in ipairs(buttons) do
      if y==b.y and x>=b.x and x<b.x+b.w then
        local ok,err=pcall(tap,b.action)
        if not ok then notice('Кнопка: '..tostring(err),true) end
        break
      end
    end
  end
end
save()
gpu.setResolution(originalW,originalH)
gpu.setForeground(COLOR.fg)
gpu.setBackground(0)
print('BeeMaster stopped; saved '..DATA)
