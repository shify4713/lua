local function log(s)
  local line=string.format('[%.0f] %s',computer.uptime(),tostring(s))
  recent[#recent+1]=line
  while #recent>100 do table.remove(recent,1) end
  local f=io.open(LOG,'a'); if f then f:write(line,'\n');f:close() end
end
local function notice(s,bad)
  alert=tostring(s)
  log((bad and 'ERROR: ' or '')..alert)
  if bad then paused=true end
end
local function save()
  local f=io.open(DATA,'w')
  if f then
    f:write(serialization.serialize({failures=failures,known=known,created=created,stage=stage,job=job,
      trustSingleFilledTemplate=CFG.trustSingleFilledTemplate,
      allowLastPrincess=CFG.allowLastPrincess,
      allowLastDrone=CFG.allowLastDrone,apiStats=apiStats,bindings=bindings,apiJobs=apiJobs,apiPrep=apiPrep}))
    f:close()
  end
end
local function load()
  local f=io.open(DATA,'r')
  local fromOld=false
  if not f then f=io.open(OLD_DATA,'r'); fromOld=(f~=nil) end
  if not f then f=io.open('/home/beemaster_v7.dat','r'); fromOld=(f~=nil) end
  if not f then return end
  local s=f:read('*a');f:close()
  local ok,x=pcall(serialization.unserialize,s)
  if ok and type(x)=='table' then
    failures=x.failures or {}
    known=x.known or {}
    created=x.created or {}
    stage=x.stage or 'idle'
    job=x.job
    CFG.trustSingleFilledTemplate=x.trustSingleFilledTemplate == true
    CFG.allowLastPrincess=x.allowLastPrincess == true
    CFG.allowLastDrone=x.allowLastDrone == true
    apiStats=x.apiStats or apiStats
    bindings=x.bindings or {}
    apiJobs=x.apiJobs or {}
    apiPrep=x.apiPrep
    if fromOld then
      log('Imported v8 settings and active jobs; start remains paused for inspection')
    end
  end
end
local function invoke(proxy,method,...)
  local args={...}
  return pcall(function() return proxy[method](table.unpack(args)) end)
end
local function stack(p,slot)
  local ok,v=invoke(p,'getStackInSlot',slot,false)
  if not ok then return nil end
  if type(v)=='table' and next(v) then return v end
  return nil
end
local function qty(v)
  return tonumber(v and (v.size or v.qty)) or 0
end
local function itemid(v)
  if type(v)~='table' then return '' end
  return tostring(v.name or v.id or (v.fingerprint or {}).id or '')
end
local function role(v)
  local n=itemid(v):lower()
  if n:find('beeprincess',1,true) then return 'P' end
  if n:find('beedrone',1,true) then return 'D' end
  if n:find('beequeen',1,true) then return 'Q' end
  return nil
end
local function title(v)
  if not v then return '—' end
  return tostring((v.individual or {}).displayName or v.label or v.display_name or itemid(v))
end
local function norm(x)
  return tostring(x or ''):lower():gsub('^%s+',''):gsub('%s+$','')
end
local function compList()
  local found={}
  for address,kind in component.list() do
    if kind=='me_interface' or kind=='peripheral' then
      local ok,p=pcall(component.proxy,address)
      if ok then found[#found+1]={addr=address,kind=kind,p=p} end
    end
  end
  table.sort(found,function(a,b)return a.addr<b.addr end)
  return found
end
local function discover()
  local old=devices
  devices={me={},mut={},imp={},api={},other={},peripherals={}}
  for _,obj in ipairs(compList()) do
    local p=obj.p
    if obj.kind=='me_interface' then
      -- Component type alone identifies a ME Interface. Heavy network reads
      -- happen during the inventory cycle, not every GUI/discovery visit.
      devices.me[#devices.me+1]=obj
    else
      local ok,size=invoke(p,'getInventorySize')
      obj.size=ok and tonumber(size) or 0
      if obj.size>0 then
        local yes,n=invoke(p,'getInventoryName')
        obj.name=(yes and tostring(n or '') or 'peripheral')
        devices.peripherals[#devices.peripherals+1]=obj
      end
    end
  end
  -- Only exact size/selected role is trusted. All four-slot machines may
  -- have the identical OC component type 'peripheral'. No guesswork.
  for _,obj in ipairs(devices.peripherals) do
    local b=bindings[obj.addr]
    if b and b.role=='MUT' and obj.size==4 then
      devices.mut[#devices.mut+1]=obj
    elseif b and b.role=='IMP' and obj.size==4 then
      devices.imp[#devices.imp+1]=obj
    elseif ((b and b.role=='API') or (not b and obj.size==15)) and obj.size==15 then
      devices.api[#devices.api+1]=obj
    else devices.other[#devices.other+1]=obj end
  end
  routes={}
  log('Devices: ME='..#devices.me..' MUT='..#devices.mut..' IMP='..#devices.imp..' API='..#devices.api)
end
local function boundME(obj)
  if not obj then return nil end
  local b=bindings[obj.addr]
  if b and b.me then
    for _,me in ipairs(devices.me) do
      if me.addr==b.me then return me end
    end
    return nil
  end
  if #devices.me==1 then return devices.me[1] end
  return nil
end
local function downRoute(obj)
  local me=boundME(obj)
  if not me then return nil end
  return {me=me,dir='DOWN',arg='DOWN'}
end
local function rebuildRoutes()
  routes={}
  if #devices.mut==1 then routes.mut=downRoute(devices.mut[1]) end
  if #devices.imp==1 then routes.imp=downRoute(devices.imp[1]) end
  for _,obj in ipairs(devices.other) do
    local b=bindings[obj.addr]
    if b and (b.role=='SAM' or b.role=='TRN') then routes['aux-'..obj.addr]=downRoute(obj) end
  end
  for _,api in ipairs(devices.api) do routes['api-'..api.addr]=downRoute(api) end
end
local function primaryME()
  return devices.me[1] and devices.me[1].p
end
local function getList(me)
  me=assert(me or primaryME(),'ME not found')
  local ok,a=invoke(me,'getAvailableItems','NONE')
  if not ok or type(a)~='table' then ok,a=invoke(me,'getAvailableItems') end
  assert(ok and type(a)=='table','Нужен getAvailableItems: '..tostring(a))
  return a
end
local function lookDetail(fp)
  local p=primaryME(); if not p or not fp then return nil end
  local ok,a=invoke(p,'getItemDetail',fp,false)
  if ok and type(a)=='table' then return a end
  return nil
end
local function fingerprintKey(fp)
  return tostring(fp.id)..'/'..tostring(fp.dmg)..'/'..tostring(fp.nbt_hash or '-')
end
local function meInventory()
  local entries=getList()
  available=entries
  catalog={}
  -- Avoid retaining thousands of extinct bee NBT variants on a 2 MB OC computer.
  local previousDetails=detailCache
  detailCache={}
  local templates={}
  local newlyRead=0
  for _,v in pairs(entries) do
    if type(v)=='table' and type(v.fingerprint)=='table' and qty(v)>0 then
      local fp=v.fingerprint
      local id=norm(fp.id)
      local r=role({id=fp.id})
      if r then
        local key=fingerprintKey(fp)
        local detail=previousDetails[key]
        if not detail then
          detail=lookDetail(fp)
          if detail then newlyRead=newlyRead+1 end
        end
        if detail then detailCache[key]=detail end
        local ind=detail and detail.individual
        if type(ind)=='table' then
          local sp=ind.ident or (ind.active and ind.active.species and ind.active.species.name)
          if sp and sp~='' then
            local x=catalog[sp] or {p=0,d=0,q=0,entries={},name=ind.displayName or title(detail)}
            x.entries[#x.entries+1]={role=r,count=qty(v),fp=fp,detail=detail}
            if r=='P' then x.p=x.p+qty(v)
            elseif r=='D' then x.d=x.d+qty(v)
            else x.q=x.q+qty(v) end
            catalog[sp]=x
            if (r=='P' or r=='Q') then known[sp]=true end
            if type(ind.active)=='table' and type(ind.active.species)=='table' then
              nameToUid[norm(ind.active.species.name)]=sp
            end
          end
        end
      elseif id:find('genetemplate',1,true) and fp.nbt_hash then
        templates[#templates+1]={fp=fp,entry=v}
      end
    end
  end
  template=(#templates==1) and templates[1] or nil
  lastME=computer.uptime()
  local n=0;for _ in pairs(catalog) do n=n+1 end
  log('ME species='..n..', templates='..#templates..', new details='..newlyRead)
  -- Do not overwrite a meaningful error until a successful export clears it.
end
local function queenSnapshot()
  local out={}
  for _,spec in pairs(catalog) do
    for _,entry in ipairs(spec.entries) do
      if entry.role=='Q' then out[fingerprintKey(entry.fp)]=entry.count end
    end
  end
  return out
end
local function newQueens(before)
  local out={}
  for uid,spec in pairs(catalog) do
    for _,entry in ipairs(spec.entries) do
      if entry.role=='Q' and entry.count>(before[fingerprintKey(entry.fp)] or 0) then
        out[#out+1]={uid=uid,entry=entry,name=spec.name}
      end
    end
  end
  return out
end
local function chooseQueen(uid)
  local spec=catalog[uid]
  if not spec then return nil end
  for _,e in ipairs(spec.entries) do if e.role=='Q' and e.count>=1 then return e end end
  return nil
end
local function getResource(term)
  local matches={}
  for _,v in pairs(available) do
    if type(v)=='table' and qty(v)>0 and type(v.fingerprint)=='table' then
      local id=norm(v.fingerprint.id)
      if id:find(term:lower(),1,true) then matches[#matches+1]=v end
    end
  end
  table.sort(matches,function(a,b)return qty(a)>qty(b) end)
  return matches[1]
end
local function graphScan()
  graph={};targetSpecies={}
  local provider=nil
  for _,api in ipairs(devices.api) do
    if type(api.p.getBeeBreedingData)=='function' or type(api.p.getBeeBreedingData)=='table' then
      provider=api.p;break
    end
  end
  if not provider then log('ERROR: no apiary exposes getBeeBreedingData');return end
  local ok,species=invoke(provider,'listAllSpecies')
  if ok and type(species)=='table' then
    for _,x in pairs(species) do
      if type(x)=='table' and x.name and x.uid then
        nameToUid[norm(x.name)]=x.uid
        targetSpecies[x.uid]=x.name
      end
    end
  end
  local yes,all=invoke(provider,'getBeeBreedingData')
  if yes and type(all)=='table' then
    for _,m in pairs(all) do
      if type(m)=='table' and m.allele1 and m.allele2 and m.result then
        graph[#graph+1]={a=tostring(m.allele1),b=tostring(m.allele2),
          result=tostring(m.result),chance=tonumber(m.chance) or 0,
          conditions=m.specialConditions}
      end
    end
  else log('WARNING: getBeeBreedingData unavailable: '..tostring(all)) end
  log('Recipes='..#graph)
end
