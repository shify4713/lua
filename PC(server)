local component = require("component")
local event = require("event")
local serial = require("serialization")
local os = require("os")
local fs = require("filesystem")
local m = component.modem

m.open(123)
local chatHistory = {}
local visHistory = {}
local lastStatsTime = 0

-- Ищем Chat Box
local cb = component.list("chat_box")()
if cb then cb = component.proxy(cb) end

local function getRealServerTime()
  local tmp = "/tmp/time_check.txt"
  local f = io.open(tmp, "w")
  if f then f:write(" "); f:close()
    -- Коррекция времени +2 часа
    local last = (fs.lastModified(tmp) / 1000) + 7200 
    local t = os.date("*t", last)
    return string.format("%02d:%02d", t.hour, t.min)
  end
  return "00:00"
end

local function formatNum(n)
  if not n or n ~= n then return "0" end
  if n >= 1000000 then return string.format("%.1fM", n/1000000) end
  if n >= 1000 then return string.format("%.1fK", n/1000) end
  return tostring(math.floor(n))
end

print("Server Started | Profile: LiwMorgan | Time: +2h")

while true do
  local ev, _, arg1, arg2, _, arg4 = event.pull(0.5)
  
  -- Чат из игры
  if ev == "chat_message" then
    local isGlobal = arg2:sub(1,1) == "!"
    local chatData = {
      n = arg1, m = isGlobal and arg2:sub(2) or arg2, 
      t = getRealServerTime(), tag = isGlobal and "&6[G]" or "&7[L]"
    }
    table.insert(chatHistory, chatData)
    if #chatHistory > 15 then table.remove(chatHistory, 1) end
    m.broadcast(123, "CHAT_MSG", serial.serialize(chatData))
  
  -- Команды с планшета
  elseif ev == "modem_message" then
    local ok, data = pcall(serial.unserialize, tostring(arg4))
    if ok and type(data) == "table" then
      if data.cmd == "GET_HISTORY" then
        for _, d in ipairs(chatHistory) do
          m.broadcast(123, "CHAT_HIST", serial.serialize(d))
          os.sleep(0.05)
        end
      elseif data.cmd == "SEND_CHAT" and cb then
        cb.setName("§bLiwMorgan§r")
        cb.say(tostring(data.msg))
      end
    end
  end

  -- Статистика (раз в 2 сек)
  if os.time() - lastStatsTime > 2 then
    local stats = {reactors = {}, items = {}}
    
    -- Реакторы
    for addr in component.list("draconic_reactor") do
      local r = component.proxy(addr).getReactorInfo()
      if r then
        table.insert(stats.reactors, {
          rf = formatNum(r.generationRate), t = math.floor(r.temperature),
          f = string.format("%.1f", (r.maxFuelConversion > 0) and (r.fuelConversion / r.maxFuelConversion * 100) or 0),
          crit = (r.temperature > 8000)
        })
      end
    end

    -- МЭ Хранилище
    local me_addr = component.list("me_interface")() or component.list("me_controller")()
    if me_addr then
      local me = component.proxy(me_addr)
      local itms = {{n="dwcity:Vis_materia", l="Vis"}, {n="minecraft:iron_ingot", l="Iron"}, {n="minecraft:gold_ingot", l="Gold"}}
      for _, it in ipairs(itms) do
        local d = me.getItemsInNetwork({name=it.n})
        local count = (d and d[1]) and d[1].size or 0
        local speed = 0
        
        if it.l == "Vis" then
          table.insert(visHistory, count)
          if #visHistory > 10 then table.remove(visHistory, 1) end
          if #visHistory > 1 then 
            speed = math.floor((visHistory[#visHistory] - visHistory[1]) / #visHistory * 10) / 10 
          end
        end
        table.insert(stats.items, {val = formatNum(count), lbl = it.l, s = speed})
      end
    end
    m.broadcast(123, "STATS", serial.serialize(stats))
    lastStatsTime = os.time()
  end
end
