local component = require("component")
local event = require("event")
local serial = require("serialization")
local os = require("os")
local computer = require("computer")
local gpu = component.gpu
local m = component.modem

local function get(n)
  local a = component.list(n)()
  return a and component.proxy(a) or nil
end

local rf = get("draconic_rf_storage")
local gate = get("flux_gate")
local me = get("me_interface")
local ADMIN = "LiwMorgan"
local PORT = 5347
m.open(PORT)

local w, h = gpu.getResolution()
local cfg = { target = 200 * 10^9, maxDiff = 25000, step = 10000 }
local lastE, filVal, lastStats = 0, 0, 0

-- Переменные для стабильного расчета Вис-материи
local lastVisCount = 0
local lastVisTime = computer.uptime()
local visPerSecond = 0
local firstRun = true

local function format(n)
  if not n or n ~= n then return "0" end
  local absN = math.abs(n)
  if absN >= 10^12 then return string.format("%.1ft", n/10^12) end
  if absN >= 10^9 then return string.format("%.1fb", n/10^9) end
  if absN >= 10^6 then return string.format("%.1fm", n/10^6) end
  return tostring(math.floor(n))
end

local function drawServerGUI(data)
  gpu.setBackground(0x000000)
  gpu.fill(1, 1, w, h, " ")
  
  local bH = h - 10
  local maxE = (rf and rf.getMaxEnergyStored() or 1)
  local fill = math.floor((lastE / maxE) * bH)
  gpu.setForeground(0x333333)
  gpu.set(2, 2, "┌──┐")
  for i=0, bH do gpu.set(2, 3+i, "│  │") end
  gpu.set(2, 3+bH+1, "└──┘")
  gpu.setForeground(0x00FF00)
  for i=0, fill do gpu.set(3, 3+bH-i, "██") end
  
  gpu.setForeground(0xFFAA00)
  gpu.set(10, 2, "SYSTEM CORE | ADMIN: "..ADMIN)
  gpu.setForeground(0xFFFFFF)
  gpu.set(10, 4, "ENERGY: " .. format(lastE))
  gpu.setForeground(0xFFFF00)
  gpu.set(10, 6, ">> TARGET: " .. format(cfg.target) .. " <<")
  
  gpu.setBackground(0x444444)
  gpu.set(10, 8, "  [ + ]  ") 
  gpu.set(20, 8, "  [ - ]  ") 
  gpu.setBackground(0x000000)
  gpu.setForeground(0x888888)
  gpu.set(10, 9, "S:100b C:50b Click:1b")

  for i, r in ipairs(data.reactors) do
    gpu.setForeground(r.gen == "OFFLINE" and 0x444444 or 0x00FF00)
    gpu.set(10, 11+i, i..": " .. r.gen .. " (" .. r.fuel .. "%)")
  end

  gpu.setForeground(0x00FFFF)
  gpu.set(40, 2, "NETWORK INFO")
  if data.items and data.items[1] then
    local it = data.items[1]
    gpu.set(40, 4, "Vis: " .. it.val)
    gpu.set(40, 5, "Flow: " .. (it.s>=0 and "+" or "").. string.format("%.1f", it.s) .. "/s")
  end
  gpu.setForeground(0x5555FF)
  gpu.set(40, h-1, "GATE: " .. data.energy.gateOut .. "/t")
end

local function gatherStats()
  local flow = gate and gate.getFlow() or 0
  local st = { reactors = {}, items = {}, energy = {cur=format(lastE), rawTarget=cfg.target, diff=filVal, gateOut=format(flow)} }
  
  for addr in component.list("draconic_reactor") do
    local r = component.proxy(addr).getReactorInfo()
    if r then
      local fuelPerc = (r.fuelConversion / r.maxFuelConversion) * 100
      table.insert(st.reactors, {gen=format(r.generationRate), fuel=math.floor(fuelPerc)})
    end
  end
  while #st.reactors < 5 do table.insert(st.reactors, {gen="OFFLINE", fuel=0}) end
  
  if me then
    local d = me.getItemsInNetwork({label="Vis Materia"})
    if not d or #d == 0 then d = me.getItemsInNetwork({name="dwcity:Vis_materia"}) end
    local countV = (d and d[1]) and d[1].size or 0
    
    if firstRun then lastVisCount = countV; firstRun = false end

    local curTime = computer.uptime()
    if curTime - lastVisTime >= 5 then
      visPerSecond = (countV - lastVisCount) / (curTime - lastVisTime)
      lastVisCount = countV
      lastVisTime = curTime
    end
    table.insert(st.items, {val=format(countV), s=visPerSecond})
  end
  return st
end

gpu.fill(1,1,w,h," ")
while true do
  -- Пауза 1 секунда для снижения нагрузки
  local res = {event.pull(1)}
  local ev = res[1]
  
  if rf and gate then
    local cur = rf.getEnergyStored()
    local flow = gate.getFlow()
    filVal = filVal + ((cur - lastE) - filVal) * 0.3
    if cur > cfg.target then
      if filVal > -cfg.maxDiff then gate.setSignalLowFlow(flow + cfg.step) end
    else
      if filVal < cfg.maxDiff and flow > 10000 then gate.setSignalLowFlow(flow - cfg.step) end
    end
    lastE = cur
  end

  local currentData = gatherStats()

  if ev == "touch" then
    local x, y = res[3], res[4]
    if y == 8 then
      local step = 10^9
      if require("keyboard").isShiftDown() then step = 100*10^9 
      elseif require("keyboard").isControlDown() then step = 50*10^9 end
      if x >= 10 and x <= 18 then cfg.target = cfg.target + step
      elseif x >= 20 and x <= 28 then cfg.target = cfg.target - step end
    end
  elseif ev == "chat_message" then
    local tag = res[4]:sub(1,1) == "!" and "&9[G]" or "&7[L]"
    local msg = {n=res[3], m=res[4], t=os.date("%H:%M"), tag=tag}
    m.broadcast(PORT, "CHAT_MSG", serial.serialize(msg))
  elseif ev == "modem_message" then
    local ok, d = pcall(serial.unserialize, tostring(res[6]))
    if ok and d and d.cmd == "SET_ENERGY" and d.user == ADMIN then cfg.target = d.val end
  end

  -- Обновление GUI и отправка на планшет раз в 2 секунды
  if computer.uptime() - lastStats > 2 then
    drawServerGUI(currentData)
    m.broadcast(PORT, "STATS", serial.serialize(currentData))
    lastStats = computer.uptime()
  end
end
