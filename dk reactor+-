-- [ФОНОВЫЙ КОНТРОЛЬ С НОВОЙ МАТЕМАТИКОЙ]
--------------------------------------------------------------------------------
local function controlReactor(r)
  local okAddr, addr = pcall(function() return r.proxy.address end)
  if not okAddr or not addr then 
    r.online = false; r.state = "ПОИСК..."; return 
  end

  local success, inf = pcall(r.proxy.getReactorInfo)
  if not success or not inf then 
    r.online = false; r.state = "СИНХРОНИЗАЦИЯ..."; return 
  end
  
  r.info, r.online = inf, true
  local status = tostring(inf.status or ""):lower()
  local temp = tonumber(inf.temperature) or 0
  
  -- [ ДИНАМИЧЕСКИЙ РАСЧЕТ ВХОДА (ЩИТ) ]
  if status ~= "off" then
    local drain = tonumber(inf.fieldDrainRate) or 0
    local maxShield = tonumber(inf.maxFieldStrength) or 1
    local shieldP = maxShield > 0 and ((tonumber(inf.fieldStrength) or 0) / maxShield) * 100 or 0
    
    local baseIn = drain / (1 - (cfg.targetShield / 100))
    local targetIn = baseIn
    
    local shieldDeficit = cfg.targetShield - shieldP
    if shieldDeficit > 0 then
        targetIn = baseIn + (baseIn * (shieldDeficit * 0.05))
    end
    pcall(r.gateIn.setSignalLowFlow, status == "charging" and 1000000 or math.ceil(targetIn))
  end

  if r.auto then
    local currentOut = safeNum(r.gateOut)
    
    if status == "running" or status == "online" or status == "starting" or status == "warming_up" then
      local genRate = tonumber(inf.generationRate) or 0
      local maxSat = tonumber(inf.maxEnergySaturation) or 1
      local satP = maxSat > 0 and ((tonumber(inf.energySaturation) or 0) / maxSat) * 100 or 0
      local maxShield = tonumber(inf.maxFieldStrength) or 1
      local shieldP = maxShield > 0 and ((tonumber(inf.fieldStrength) or 0) / maxShield) * 100 or 0
      local maxFuel = tonumber(inf.maxFuelConversion) or 1
      local conversionP = maxFuel > 0 and ((tonumber(inf.fuelConversion) or 0) / maxFuel) * 100 or 0

      local targetTemp = 8000
      local targetOut = currentOut

      -- 1. КРИТИЧЕСКАЯ ЗАЩИТА (АБСОЛЮТНЫЙ ПРИОРИТЕТ)
      if shieldP < 10 or temp > cfg.tempCrit then
        r.state = "АВАРИЯ! СБРОС"
        targetOut = 0 
        
      -- 2. ПРОГРЕВ ПЕРЕД ЗАПУСКОМ
      elseif status == "warming_up" then
        r.state = "ПРОГРЕВ"
        targetOut = 0

      -- 3. АГРЕССИВНЫЙ ФОРСАЖ (ИСТОЩЕНИЕ > 84%) - Держим гену > 2M
      elseif conversionP > 84 then
        r.state = "ФОРСАЖ (>84%)"
        -- Греем реактор почти до критической отметки (7950 °C), чтобы максимизировать генерацию
        if temp > 7950 then
          targetOut = genRate - 10000 -- Остужаем, если подобрались слишком близко к 8000
        else
          if satP > 10 then
            -- Сушим насыщение. Если гена упала ниже 2 лямов - сушим агрессивнее
            if genRate < 2050000 then
              targetOut = genRate + 40000 
            else
              targetOut = genRate + 5000
            end
          else
            targetOut = genRate -- Не даем насыщению упасть ниже 10%
          end
        end
        
      -- 4. ЗОНА ПЕРЕГРЕВА (Свыше 8000 °C)
      elseif temp > targetTemp then
        r.state = "ОХЛАЖДЕНИЕ"
        local overheat = temp - targetTemp
        targetOut = genRate - (overheat * 100) - 2000
        
      -- 5. СТАНДАРТНЫЙ ФОРСАЖ (Ниже 7000 °C)
      elseif temp < 7000 then
        r.state = "РАЗГОН"
        if satP > 15 then
            targetOut = genRate + (satP * 1000)
        else
            targetOut = genRate + 1000
        end
        
      -- 6. ЗОНА ТОЧНОГО БАЛАНСА (7000 - 8000 °C)
      else
        r.state = "АВТО-БАЛАНС"
        local tempDiff = targetTemp - temp
        if satP > 10 then
            targetOut = genRate + (tempDiff * 4)
        else
            targetOut = genRate - 5000
        end
      end

      if targetOut < 0 then targetOut = 0 end

      -- [ СГЛАЖИВАНИЕ СКАЧКОВ (Anti-Oscillation) - Адаптивный шаг ]
      -- Увеличен минимальный шаг до 10000 для быстрой перекалибровки при перестройке гейтов
      local maxStep = math.max(10000, currentOut * 0.1) 
      if math.abs(targetOut - currentOut) > maxStep then
        if targetOut > currentOut then 
            targetOut = currentOut + maxStep
        else 
            targetOut = currentOut - maxStep 
        end
      end

      pcall(r.gateOut.setSignalLowFlow, math.floor(targetOut))
    else 
      r.state = "ОЖИДАНИЕ" 
      if currentOut ~= cfg.initialFlow then pcall(r.gateOut.setSignalLowFlow, cfg.initialFlow) end
    end
  else 
    r.state = "РУЧНОЙ РЕЖИМ" 
  end
end

local function tryAutoRepair()
  local brokenSlot = nil
  for i = 1, MAX_REACTORS do
    if reactors[i] and not reactors[i].online then brokenSlot = i; break end
  end
  if not brokenSlot then return end 

  local used = getUsedAddresses()
  local freeReactors, freeGates = {}, {}
  for addr in component.list("draconic_reactor") do
    if not used[addr] then table.insert(freeReactors, addr) end
  end
  for addr in component.list("flux_gate") do
    if not used[addr] then table.insert(freeGates, addr) end
  end

  if #freeReactors >= 1 and #freeGates >= 2 then
    local newR = component.proxy(freeReactors[1])
    local g1, g2 = component.proxy(freeGates[1]), component.proxy(freeGates[2])
    local f1, f2 = safeNum(g1), safeNum(g2)
    local found, newIn, newOut = false, nil, nil

    if f1 > cfg.detectOutMin and f2 < cfg.detectInMax then
      newOut = g1; newIn = g2; found = true
    elseif f2 > cfg.detectOutMin and f1 < cfg.detectInMax then
      newOut = g2; newIn = g1; found = true
    end

    if found then
       local r = reactors[brokenSlot]
       r.proxy, r.gateIn, r.gateOut = newR, newIn, newOut
       r.online, r.info, r.state = true, {}, "ВОССТАНОВЛЕН"
       r.saved_rAddr, r.saved_inAddr, r.saved_outAddr = newR.address, newIn.address, newOut.address
       computer.beep(800, 0.1)
       saveConfig()
       cleanScreen()
    end
  end
end

local function backgroundTick()
  local uptime = computer.uptime()
  local updated = false
  if uptime - lastUpdateTime >= UPDATE_INTERVAL then
    for i = 1, MAX_REACTORS do
      if reactors[i] then controlReactor(reactors[i]) end
    end
    lastUpdateTime = uptime
    updated = true
  end
  if uptime - lastReconnectTime >= RECONNECT_INTERVAL then
    tryAutoRepair()
    lastReconnectTime = uptime
  end
  return updated
end

