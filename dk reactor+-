local function drawBox(x, y, w, h, title, color)
  gpu.setForeground(color or COLORS.frame)
  gpu.set(x, y, "┌" .. string.rep("─", w-2) .. "┐")
  for iy = y+1, y+h-2 do
    gpu.set(x, iy, "│"); gpu.set(x+w-1, iy, "│")
  end
  gpu.set(x, y+h-1, "└" .. string.rep("─", w-2) .. "┘")
  if title then
    centerText(x, y, w, " " .. title .. " ", COLORS.text)
  end
end

local function drawBtn(id, x, y, w, h, text, color, active)
  buttons[id] = {x=x, y=y, w=w, h=h}
  gpu.setBackground(active and color or COLORS.btn_inactive)
  gpu.setForeground(active and 0xDDDDDD or 0x444444)
  gpu.fill(x, y, w, h, " ")
  centerText(x, y + math.floor(h/2), w, text)
  gpu.setBackground(COLORS.bg)
end

