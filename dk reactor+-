local function interactiveAdd(slotIndex)
  local used = getUsedAddresses()
  local rList, gates = {}, {}
  
  for addr in component.list("draconic_reactor") do
    if not used[addr] then table.insert(rList, addr) end
  end
  for addr in component.list("flux_gate") do
    if not used[addr] then table.insert(gates, addr) end
  end

  local winW, winH = 68, 18
  local winX, winY = math.floor((maxW-winW)/2), math.floor((maxH-winH)/2)

  gpu.setBackground(COLORS.modal); gpu.fill(winX, winY, winW, winH, " ")
  gpu.setBackground(COLORS.modal_inner); gpu.fill(winX+1, winY+1, winW-2, winH-2, " ")
  
  if #rList == 0 or #gates < 2 then
    gpu.setForeground(COLORS.bad); 
    centerText(winX, winY+8, winW, #rList == 0 and "ОШИБКА: НЕТ СВОБОДНЫХ РЕАКТОРОВ" or "ОШИБКА: НУЖНО 2 СВОБОДНЫХ ГЕЙТА")
    local deadline = computer.uptime() + 2
    while computer.uptime() < deadline do
      backgroundTick(); event.pull(0.1, "touch")
    end
    cleanScreen(); return
  end

  local selR = rList[1]
  if #rList > 1 then
    gpu.setForeground(COLORS.text); centerText(winX, winY+2, winW, "ВЫБЕРИТЕ РЕАКТОР:")
    drawBtn("m_close", winX+winW-4, winY+1, 3, 1, "X", COLORS.bad, true)
    for i, a in ipairs(rList) do
      if i <= 10 then gpu.set(winX+5, winY+3+i, i..". "..a) end
    end
    
    local selecting = true
    while selecting do
      backgroundTick() 
      local e, _, x, y = event.pull(0.1, "touch")
      if e == "touch" then
        if x >= winX+winW-4 and x <= winX+winW-1 and y == winY+1 then cleanScreen(); return end
        local idx = y - (winY+3)
        if rList[idx] then selR = rList[idx]; selecting = false end
      end
    end
    gpu.setBackground(COLORS.modal_inner); gpu.fill(winX+2, winY+2, winW-4, winH-4, " ")
  end

  local rProxy = component.proxy(selR)
  local ok, rInfo = pcall(rProxy.getReactorInfo)
  local isRunning = ok and rInfo and (rInfo.status == "online" or rInfo.status == "running" or rInfo.status == "warming_up")
  
  local physG1, physG2 = component.proxy(gates[1]), component.proxy(gates[2])
  local isSwapped = false
  
  local origG1 = safeNum(physG1)
  local origG2 = safeNum(physG2)

  if not isRunning then
    pcall(physG1.setSignalLowFlow, 0)
    pcall(physG2.setSignalLowFlow, 535000)
  end

  gpu.setBackground(COLORS.modal_inner)
  gpu.setForeground(COLORS.text); centerText(winX, winY+3, winW, "КАЛИБРОВКА ГЕЙТОВ (SLOT #"..slotIndex..")")
  
  if isRunning then
    gpu.setForeground(COLORS.warn)
    centerText(winX, winY+5, winW, "РЕАКТОР АКТИВЕН! ФИЗИЧЕСКИЕ ПОТОКИ НЕ ИЗМЕНЕНЫ.")
  end

  drawBtn("t_ok", winX+5, winY+13, 14, 3, "ГОТОВО", COLORS.good, true)
  drawBtn("t_swp", winX+27, winY+13, 14, 3, "SWAP", COLORS.btn_sel, true)
  drawBtn("t_cl", winX+49, winY+13, 14, 3, "ОТМЕНА", COLORS.btn_dec, true)

  local testing = true
  while testing do
    backgroundTick() 

    local flowG1 = safeNum(physG1)
    local flowG2 = safeNum(physG2)
    
    gpu.setBackground(COLORS.modal_inner); gpu.fill(winX+2, winY+7, winW-4, 4, " ")
    
    gpu.setForeground(COLORS.text)
    gpu.set(winX+6, winY+8,  string.format("ФИЗ. ГЕЙТ 1: %6dk -> НАЗНАЧЕН КАК: ", flowG1/1000))
    gpu.set(winX+6, winY+10, string.format("ФИЗ. ГЕЙТ 2: %6dk -> НАЗНАЧЕН КАК: ", flowG2/1000))
    
    gpu.setForeground(isSwapped and COLORS.cold or COLORS.good)
    gpu.set(winX+43, winY+8, isSwapped and "[ ВЫХОД ]" or "[ ВХОД ]")
    
    gpu.setForeground(isSwapped and COLORS.good or COLORS.cold)
    gpu.set(winX+43, winY+10, isSwapped and "[ ВХОД ]" or "[ ВЫХОД ]")

    local e, _, x, y = event.pull(0.1, "touch")
    if e == "touch" then
      if y >= winY+13 and y <= winY+16 then
        if x >= winX+5 and x <= winX+19 then
          reactors[slotIndex] = {
            proxy = rProxy, 
            gateIn = isSwapped and physG2 or physG1, 
            gateOut = isSwapped and physG1 or physG2, 
            auto=true, state="ИНИЦИАЛИЗАЦИЯ", info={}, online=true,
            saved_rAddr=rProxy.address, 
            saved_inAddr=(isSwapped and physG2.address or physG1.address), 
            saved_outAddr=(isSwapped and physG1.address or physG2.address)
          }
          saveConfig(); testing = false
          
        elseif x >= winX+27 and x <= winX+41 then
          isSwapped = not isSwapped
          if not isRunning then 
            local newIn = isSwapped and physG2 or physG1
            local newOut = isSwapped and physG1 or physG2
            pcall(newIn.setSignalLowFlow, 0)
            pcall(newOut.setSignalLowFlow, 535000) 
          end
          
        elseif x >= winX+49 and x <= winX+63 then
          if not isRunning then 
            pcall(physG1.setSignalLowFlow, origG1)
            pcall(physG2.setSignalLowFlow, origG2) 
          end
          testing = false
        end
      end
    end
  end
  cleanScreen()
end

--------------------------------------------------------------------------------
-- [ИНИЦИАЛИЗАЦИЯ И ЗАПУСК]
--------------------------------------------------------------------------------
if filesystem.exists(SAVE_FILE) then
  local f = io.open(SAVE_FILE, "r")
  local ok, data = pcall(serialization.unserialize, f:read("*a"))
  f:close()
  if ok and type(data) == "table" then
    for i = 1, MAX_REACTORS do
      if data[i] then
        local d = data[i]
        local rP, iP, oP = component.proxy(d.rAddr), component.proxy(d.inAddr), component.proxy(d.outAddr)
        reactors[i] = {
          proxy=rP or {address=d.rAddr}, 
          gateIn=iP or {address=d.inAddr}, 
          gateOut=oP or {address=d.outAddr}, 
          auto=d.auto, state="ЗАГРУЗКА", info={}, online=(rP and true or false),
          saved_rAddr=d.rAddr, saved_inAddr=d.inAddr, saved_outAddr=d.outAddr
        }
      end
    end
  end
end

cleanScreen()

while running do
  if backgroundTick() then
    renderMain()
  end
  
  local e, _, x, y = event.pull(0.05, "touch")
  if e == "touch" then
    for id, b in pairs(buttons) do
      if x >= b.x and x < b.x + b.w and y >= b.y and y < b.y + b.h then
        if id == "exit" then running = false 
        else
          local act, idx = id:match("(%a+)_(%d+)")
          idx = tonumber(idx)
          
          if act == "add" then
             interactiveAdd(idx)
          else
            local r = reactors[idx]
            if r and r.online then
              if act == "del" then 
                reactors[idx] = nil; saveConfig(); cleanScreen()
              elseif act == "auto" then r.auto = not r.auto; saveConfig()
              elseif act == "chg" then pcall(r.proxy.chargeReactor)
              elseif act == "pow" then 
                local s = tostring(r.info.status or ""):lower()
                if s == "running" or s == "online" or s == "warming_up" then pcall(r.proxy.stopReactor); r.auto = false
                else pcall(r.proxy.activateReactor) end
              elseif act == "plus" or act == "minus" then
                local c = safeNum(r.gateOut)
                -- Убрано ограничение cfg.initialFlow. Теперь можно вручную скрутить поток до 0
                pcall(r.gateOut.setSignalLowFlow, act=="plus" and c+cfg.manualStep or math.max(0, c-cfg.manualStep))
              end
            elseif r and not r.online and act == "del" then
                reactors[idx] = nil; saveConfig(); cleanScreen()
            end
          end
        end
        renderMain(); break
      end
    end
  end
end

gpu.setBackground(0); gpu.fill(1, 1, maxW, maxH, " ")
