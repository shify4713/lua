local function saveConfig()
  local data = {}
  for i = 1, MAX_REACTORS do
    local r = reactors[i]
    if r then
      local rA = r.proxy and r.proxy.address or r.saved_rAddr
      local iA = r.gateIn and r.gateIn.address or r.saved_inAddr
      local oA = r.gateOut and r.gateOut.address or r.saved_outAddr
      data[i] = {rAddr=rA, inAddr=iA, outAddr=oA, auto=r.auto}
    end
  end
  local f = io.open(SAVE_FILE, "w")
  if f then f:write(serialization.serialize(data)); f:close() end
end

local function safeNum(proxy)
  if type(proxy) ~= "table" then return 0 end
  local ok, val = pcall(proxy.getSignalLowFlow)
  return (ok and tonumber(val)) or 0
end

local function getUsedAddresses()
  local used = {}
  for i = 1, MAX_REACTORS do
    local r = reactors[i]
    if r then
      if r.proxy and r.proxy.address then used[r.proxy.address] = true end
      if r.gateIn and r.gateIn.address then used[r.gateIn.address] = true end
      if r.gateOut and r.gateOut.address then used[r.gateOut.address] = true end
    end
  end
  return used
end

local function centerText(x, y, w, text, color)
  if color then gpu.setForeground(color) end
  local len = unicode.len(text)
  gpu.set(x + math.floor((w - len)/2), y, text)
end

local function cleanScreen()
  buttons = {}
  currentLayoutStates = {}
  headerDrawn = false
  gpu.setBackground(COLORS.bg)
  gpu.fill(1, 1, maxW, maxH, " ")
end

