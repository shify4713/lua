  local startX = math.floor((maxW - (colW * cols + spacing * (cols - 1))) / 2)
  local startY = 6
  local colH = math.min(26, maxH - startY - 2)
  
  local currentTotal = 0

  for i = 1, cols do
    local x = startX + (i - 1) * (colW + spacing)
    local r = reactors[i]
    
    local newState = 0 
    if r then
      if r.online and r.info then newState = 2 else newState = 1 end 
    end
    
    if currentLayoutStates[i] ~= newState then
      gpu.setBackground(COLORS.bg)
      gpu.fill(x, startY, colW, colH, " ") 
      currentLayoutStates[i] = newState
      
      if newState == 2 then
        drawBox(x, startY, colW, colH, "РЕАКТОР #" .. i, COLORS.frame)
        gpu.setForeground(COLORS.label)
        gpu.set(x+2, startY+2, "СТАТУС:")
        gpu.set(x+2, startY+3, "РЕЖИМ:")
        gpu.set(x+2, startY+5, "ТЕМП:")
        gpu.set(x+2, startY+6, "ЩИТ:")
        gpu.set(x+2, startY+7, "НАСЫЩ:")
        gpu.set(x+2, startY+8, "ТОПЛИВО:")
        gpu.setForeground(COLORS.frame); gpu.set(x+1, startY+10, string.rep("─", colW-2))
        gpu.setForeground(COLORS.label)
        gpu.set(x+2, startY+11, "ГЕНЕР:")
        gpu.set(x+2, startY+12, "ВЫХОД:")
        gpu.set(x+2, startY+13, "ДОХОД:")
        local by = startY + colH - 6
        gpu.setForeground(COLORS.frame); gpu.set(x+1, by-1, string.rep("─", colW-2))
        centerText(x+6, by+4, colW-12, "ПОТОК", COLORS.label)
      elseif newState == 1 then
        drawBox(x, startY, colW, colH, "РЕАКТОР #" .. i, COLORS.bad)
        gpu.setForeground(COLORS.bad); centerText(x, startY+6, colW, "СВЯЗЬ ПРЕРВАНА")
        gpu.setForeground(COLORS.label); centerText(x, startY+8, colW, "Ожидание чанка...")
      else
        drawBox(x, startY, colW, colH, "СЛОТ #" .. i, COLORS.btn_inactive)
        gpu.setForeground(COLORS.label); centerText(x, startY + math.floor(colH/2) - 2, colW, "ПУСТАЯ ЯЧЕЙКА")
      end
    end
    
    if newState == 2 then
      local rawStatus = tostring(r.info.status or "invalid"):lower()
      local gen = tonumber(r.info.generationRate) or 0
      local inFlow = safeNum(r.gateIn)
      local outFlow = safeNum(r.gateOut)
      local rProfit = (gen - inFlow)
      currentTotal = currentTotal + rProfit
      local temp = tonumber(r.info.temperature) or 0
      local sP = math.floor(((tonumber(r.info.fieldStrength) or 0)/(tonumber(r.info.maxFieldStrength) or 1))*100)
      local satP = math.floor(((tonumber(r.info.energySaturation) or 0)/(tonumber(r.info.maxEnergySaturation) or 1))*100)
      local fuelPerc = ((tonumber(r.info.fuelConversion) or 0) / (tonumber(r.info.maxFuelConversion) or 1)) * 100

      local valW = colW - 13
      
      gpu.setForeground((rawStatus == "running" or rawStatus == "online") and COLORS.good or COLORS.warn)
      local statusTxt = STATUS_MAP[rawStatus] or rawStatus
      gpu.set(x+11, startY+2, statusTxt .. string.rep(" ", valW - unicode.len(statusTxt)))
      
      gpu.setForeground(r.auto and COLORS.text or COLORS.label)
      local stateTxt = r.state or "---"
      gpu.set(x+11, startY+3, stateTxt .. string.rep(" ", valW - unicode.len(stateTxt)))

      gpu.setForeground(temp > 8000 and COLORS.bad or (temp > 7000 and COLORS.warn or COLORS.text))
      local tempTxt = string.format("%.0f °C", temp)
      gpu.set(x+11, startY+5, tempTxt .. string.rep(" ", valW - unicode.len(tempTxt)))

      gpu.setForeground(sP < 25 and COLORS.bad or COLORS.text)
      local shieldTxt = sP .. "%"
      gpu.set(x+11, startY+6, shieldTxt .. string.rep(" ", valW - unicode.len(shieldTxt)))

      gpu.setForeground(COLORS.text)
      local satTxt = satP .. "%"
      gpu.set(x+11, startY+7, satTxt .. string.rep(" ", valW - unicode.len(satTxt)))

      gpu.setForeground(fuelPerc > 85 and COLORS.bad or COLORS.text)
      local fuelTxt = string.format("%.1f %%", fuelPerc)
      gpu.set(x+11, startY+8, fuelTxt .. string.rep(" ", valW - unicode.len(fuelTxt)))

      gpu.setForeground(COLORS.text)
      local genTxt = math.floor(gen/1000) .. " K"
      gpu.set(x+11, startY+11, genTxt .. string.rep(" ", valW - unicode.len(genTxt)))
      
      gpu.setForeground(COLORS.cold)
      local outTxt = math.floor(outFlow/1000) .. " K"
      gpu.set(x+11, startY+12, outTxt .. string.rep(" ", valW - unicode.len(outTxt)))

      gpu.setForeground(rProfit > 0 and COLORS.good or COLORS.bad)
      local profTxt = string.format("%.1f K", rProfit/1000)
      gpu.set(x+11, startY+13, profTxt .. string.rep(" ", valW - unicode.len(profTxt)))

      local by = startY + colH - 6
      local isActive = (rawStatus == "running" or rawStatus == "online" or rawStatus == "starting" or rawStatus == "warming_up")
      local btnW = math.floor((colW - 5) / 2)
      
      drawBtn("pow_"..i, x+2, by, btnW, 1, isActive and "СТОП" or "ПУСК", isActive and COLORS.bad or COLORS.good, true)
      drawBtn("chg_"..i, x+3+btnW, by, btnW, 1, "ЗАРЯД", COLORS.btn_inactive, (rawStatus=="off"))
      drawBtn("auto_"..i, x+2, by+2, btnW, 1, "АВТО-РЕЖИМ", COLORS.btn_sel, r.auto)
      drawBtn("del_"..i, x+3+btnW, by+2, btnW, 1, "УДАЛИТЬ", COLORS.btn_dec, true)

      drawBtn("minus_"..i, x+2, by+4, 4, 1, "-", COLORS.btn_dec, true)
      drawBtn("plus_"..i, x+colW-5, by+4, 4, 1, "+", COLORS.btn_inc, true)

    elseif newState == 1 then
      drawBtn("del_"..i, x+math.floor((colW-12)/2), startY+12, 12, 1, "УДАЛИТЬ", COLORS.btn_dec, true)
    else
      drawBtn("add_"..i, x + math.floor((colW-14)/2), startY + math.floor(colH/2) + 1, 14, 3, "ДОБАВИТЬ", COLORS.btn_inactive, true)
    end
  end
  
  totalProfit = currentTotal
  drawBtn("exit", maxW-12, maxH-1, 11, 1, "ВЫХОД", COLORS.btn_dec, true)
end

