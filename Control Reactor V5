local component = require("component")
local event = require("event")
local serialization = require("serialization")
local filesystem = require("filesystem")
local computer = require("computer") 
local gpu = component.gpu

--------------------------------------------------------------------------------
-- [КОНФИГУРАЦИЯ]
--------------------------------------------------------------------------------
local ADMIN_NAME = "LiwMorgan"
local SAVE_FILE = "/home/reactors.cfg"
local UPDATE_INTERVAL = 0.5 
local maxW, maxH = gpu.maxResolution()
-- Увеличили ширину до 145 для нормального отображения всех колонок
local W, H = math.min(145, maxW), math.min(38, maxH)
gpu.setResolution(W, H)

local cfg = {
  targetShield = 25,
  forceModeTemp = 7500,
  safeModeTemp = 8000,
  tempCrit = 8100,
  initialFlow = 535000,
  manualStep = 10000,
}

local reactors = {}
local buttons = {}
local running = true
local lastUpdateTime = 0 
local totalProfit = 0

local COLORS = {
  bg = 0x000000, panel = 0x0A0A0A, text = 0xCCCCCC,
  label = 0x555555, good = 0x00FF44, warn = 0xFFCC00,
  bad = 0xFF2222, cold = 0x00CCFF,
  btn_sel = 0x004466, btn_cancel = 0x441111, btn_inc = 0x224422,
  btn_chg_active = 0xFFCC00, 
  btn_inactive = 0x222222
}

--------------------------------------------------------------------------------
-- [ЛОГИКА]
--------------------------------------------------------------------------------
local function safeNum(proxy)
  if not proxy then return 0 end
  local ok, val = pcall(proxy.getSignalLowFlow)
  return (ok and tonumber(val)) or 0
end

local function controlReactor(r)
  local success, inf = pcall(r.proxy.getReactorInfo)
  if not success or not inf then r.online = false return end
  r.info, r.online = inf, true
  local status = tostring(inf.status or ""):lower()
  local temp = tonumber(inf.temperature) or 0
  local currentOut = safeNum(r.gateOut)
  
  if currentOut < cfg.initialFlow then
    pcall(r.gateOut.setSignalLowFlow, cfg.initialFlow)
    currentOut = cfg.initialFlow
  end

  if status ~= "off" then
    local drain = tonumber(inf.fieldDrainRate) or 0
    local targetIn = math.ceil(drain / (1 - (cfg.targetShield / 100)))
    if status == "charging" then pcall(r.gateIn.setSignalLowFlow, 500000)
    else pcall(r.gateIn.setSignalLowFlow, targetIn) end
  end

  if r.auto then
    if status == "running" or status == "online" or status == "starting" then
      local genRate = tonumber(inf.generationRate) or 0
      if temp < cfg.forceModeTemp then
        r.state = "HOLDING_535K"
        if currentOut > cfg.initialFlow then pcall(r.gateOut.setSignalLowFlow, cfg.initialFlow) end
      elseif temp < cfg.safeModeTemp then
        r.state = "STABLE"
        if (currentOut - genRate) < 1000 then pcall(r.gateOut.setSignalLowFlow, currentOut + 500) end
      elseif temp > cfg.tempCrit then
        r.state = "CRITICAL"
        pcall(r.gateOut.setSignalLowFlow, cfg.initialFlow)
      else r.state = "OPTIMAL" end
    else r.state = "WAITING" end
  else r.state = "MANUAL" end
end

--------------------------------------------------------------------------------
-- [ОТРИСОВКА]
--------------------------------------------------------------------------------
local function drawBtn(id, x, y, w, h, text, color, active)
  gpu.setBackground(active and color or COLORS.btn_inactive)
  gpu.setForeground(active and 0xFFFFFF or 0x666666)
  gpu.fill(x, y, w, h, " ")
  gpu.set(x + math.floor((w - #text)/2), y + math.floor(h/2), text)
  buttons[id] = {x=x, y=y, w=w, h=h}
end

local function render()
  buttons = {}
  -- Шапка (рисуем без полной очистки экрана)
  gpu.setBackground(COLORS.panel)
  gpu.fill(1, 1, W, 3, " ")
  gpu.setForeground(COLORS.cold)
  gpu.set(2, 2, "DRACONIC SYSTEM | " .. ADMIN_NAME)
  
  local profitStr = "TOTAL PROFIT: " .. string.format("%.1fK RF/t", totalProfit / 1000)
  gpu.setForeground(totalProfit > 0 and COLORS.good or COLORS.bad)
  gpu.set(W - #profitStr - 2, 2, profitStr)

  local tableStartY = 4
  
  -- Заголовки таблицы
  gpu.setBackground(COLORS.bg)
  gpu.setForeground(COLORS.label)
  gpu.set(2,  tableStartY, "ID")
  gpu.set(6,  tableStartY, "STATUS")
  gpu.set(18, tableStartY, "STATE")
  gpu.set(34, tableStartY, "TEMP")
  gpu.set(44, tableStartY, "SHIELD/SAT")
  gpu.set(58, tableStartY, "FUEL USED")
  gpu.set(70, tableStartY, "PROFIT")
  gpu.set(81, tableStartY, "GEN")
  gpu.set(90, tableStartY, "OUT FLOW")
  gpu.set(102, tableStartY, "CONTROLS")
  gpu.set(1, tableStartY + 1, string.rep("─", W))
  
  local currentTotal = 0
  for i, r in ipairs(reactors) do
    local y = tableStartY + 2 + (i-1)*2
    
    -- АНТИ-МЕРЦАНИЕ: Очищаем только область данных текущего реактора
    gpu.setBackground(COLORS.bg)
    gpu.fill(1, y, 101, 1, " ") 
    
    if r.online and r.info then
      local status = tostring(r.info.status or "???"):upper()
      
      -- ID
      gpu.setForeground(COLORS.text); gpu.set(2, y, "#"..i)
      
      -- STATUS
      gpu.setForeground((status == "RUNNING" or status == "ONLINE") and COLORS.good or COLORS.warn)
      gpu.set(6, y, status:sub(1,11))
      
      -- STATE
      gpu.setForeground(r.auto and COLORS.good or COLORS.text)
      gpu.set(18, y, (r.state or "---"):sub(1,14))
      
      -- TEMP
      local temp = tonumber(r.info.temperature) or 0
      gpu.setForeground(temp > 8000 and COLORS.bad or (temp > 7000 and COLORS.warn or COLORS.good))
      gpu.set(34, y, string.format("%.0fC", temp))
      
      -- SHIELD / SATURATION
      local sP = math.floor(((tonumber(r.info.fieldStrength) or 0)/(tonumber(r.info.maxFieldStrength) or 1))*100)
      local satP = math.floor(((tonumber(r.info.energySaturation) or 0)/(tonumber(r.info.maxEnergySaturation) or 1))*100)
      gpu.setForeground(sP < 25 and COLORS.bad or COLORS.good); gpu.set(44, y, sP.."%/"..satP.."%")
      
      -- FUEL
      local fConv = tonumber(r.info.fuelConversion) or 0
      local fMax = tonumber(r.info.maxFuelConversion) or 1
      local fuelPerc = (fConv / fMax) * 100
      gpu.setForeground(fuelPerc > 85 and COLORS.bad or (fuelPerc > 50 and COLORS.warn or COLORS.text))
      gpu.set(58, y, string.format("%.2f%%", fuelPerc))
      
      -- PROFIT / GEN / FLOW
      local gen = tonumber(r.info.generationRate) or 0
      local rProfit = (gen - safeNum(r.gateIn))
      currentTotal = currentTotal + rProfit
      
      gpu.setForeground(rProfit > 0 and COLORS.good or COLORS.bad); gpu.set(70, y, string.format("%.1fK", rProfit/1000))
      gpu.setForeground(COLORS.warn); gpu.set(81, y, math.floor(gen/1000).."K")
      gpu.setForeground(COLORS.cold); gpu.set(90, y, math.floor(safeNum(r.gateOut)/1000).."K")
      
      -- CONTROLS
      drawBtn("minus_"..i, 102, y, 2, 1, "-", 0x441111, true)
      drawBtn("plus_"..i, 105, y, 2, 1, "+", 0x114411, true)
      
      -- КНОПКА CHG: горит желтым, если реактор выключен, остыл или заряжается
      local canCharge = (status == "COLD" or status == "OFF" or status == "CHARGING" or status == "FAILSAFE" or status == "BEYOND_HOPE")
      drawBtn("chg_"..i, 109, y, 5, 1, "CHG", COLORS.btn_chg_active, canCharge)
      
      drawBtn("auto_"..i, 116, y, 6, 1, "AUTO", COLORS.btn_sel, r.auto)
      
      local isActive = (status == "RUNNING" or status == "ONLINE" or status == "STARTING")
      drawBtn("pow_"..i, 124, y, 5, 1, "PWR", isActive and COLORS.bad or COLORS.good, true)
      
      drawBtn("del_"..i, W-3, y, 2, 1, "X", 0x441111, true)
    else
      gpu.setForeground(COLORS.bad); gpu.set(6, y, "OFFLINE / DISCONNECTED")
      drawBtn("del_"..i, W-3, y, 2, 1, "X", 0x441111, true)
    end
  end
  
  totalProfit = currentTotal
  drawBtn("add", 2, H, 12, 1, "[+] ADD", 0x333333, true)
  drawBtn("exit", W-10, H, 9, 1, "EXIT", 0x441111, true)
end

--------------------------------------------------------------------------------
-- [МАСТЕР УСТАНОВКИ]
--------------------------------------------------------------------------------
local function interactiveAdd()
  local step = 1; local sel = {r=nil, gIn=nil, gOut=nil}
  local titles = {"ВЫБЕРИ РЕАКТОР", "ВЫБЕРИ GATE IN (ЩИТ)", "ВЫБЕРИ GATE OUT (ЭНЕРГИЯ)"}
  
  while step <= 3 do
    local winW, winH = 70, 20
    local winX, winY = math.floor((W-winW)/2), math.floor((H-winH)/2)
    gpu.setBackground(0x111111); gpu.fill(winX, winY, winW, winH, " ")
    gpu.setForeground(0x00CCFF); gpu.set(winX+2, winY+1, titles[step])
    
    local typeF = (step == 1) and "draconic_reactor" or "flux_gate"
    local list = {}
    for addr in component.list(typeF) do
      local used = false
      for _, r in ipairs(reactors) do
        if r.proxy.address == addr or r.gateIn.address == addr or r.gateOut.address == addr then used = true break end
      end
      if addr == sel.r or addr == sel.gIn then used = true end
      if not used then table.insert(list, addr) end
    end
    
    local itemBtns = {}
    for i, addr in ipairs(list) do
      if i > (winH - 5) then break end
      local curY = winY + 2 + i
      gpu.setBackground(0x222222); gpu.setForeground(0xFFFFFF); gpu.fill(winX+2, curY, winW-4, 1, " ")
      gpu.set(winX+3, curY, i..". "..addr:sub(1,16).."...")
      itemBtns[curY] = addr
    end
    
    drawBtn("cancel_add", winX + winW - 12, winY + winH - 2, 10, 1, "CANCEL", 0x441111, true)
    
    local e, _, x, y = event.pull("touch")
    if e == "touch" then
      if x >= (winX + winW - 12) and x <= (winX + winW - 2) and y == (winY + winH - 2) then return end
      if itemBtns[y] and x >= (winX+2) and x <= (winX+winW-2) then
        if step == 1 then sel.r = itemBtns[y] elseif step == 2 then sel.gIn = itemBtns[y] else sel.gOut = itemBtns[y] end
        step = step + 1; computer.beep(800, 0.05)
      end
    end
  end
  
  if sel.r and sel.gIn and sel.gOut then
    table.insert(reactors, {proxy=component.proxy(sel.r), gateIn=component.proxy(sel.gIn), gateOut=component.proxy(sel.gOut), auto=false, state="IDLE", info={}, online=true})
    local data = {}
    for _, r in ipairs(reactors) do table.insert(data, {rAddr=r.proxy.address, inAddr=r.gateIn.address, outAddr=r.gateOut.address, auto=r.auto}) end
    local f = io.open(SAVE_FILE, "w"); f:write(serialization.serialize(data)); f:close()
  end
end

--------------------------------------------------------------------------------
-- [ЗАПУСК]
--------------------------------------------------------------------------------
if filesystem.exists(SAVE_FILE) then
  local f = io.open(SAVE_FILE, "r")
  local data = serialization.unserialize(f:read("*a")); f:close()
  if data then
    for _, d in ipairs(data) do
      local rP, iP, oP = component.proxy(d.rAddr), component.proxy(d.inAddr), component.proxy(d.outAddr)
      if rP and iP and oP then table.insert(reactors, {proxy=rP, gateIn=iP, gateOut=oP, auto=d.auto, state="IDLE", info={}, online=true}) end
    end
  end
end

gpu.setBackground(0); gpu.fill(1, 1, W, H, " ")

while running do
  if computer.uptime() - lastUpdateTime >= UPDATE_INTERVAL then
    for _, r in ipairs(reactors) do controlReactor(r) end
    render()
    lastUpdateTime = computer.uptime()
  end
  
  local e, _, x, y = event.pull(0.1, "touch")
  if e == "touch" then
    for id, b in pairs(buttons) do
      if x >= b.x and x < b.x + b.w and y >= b.y and y < b.y + b.h then
        if id == "exit" then running = false 
        elseif id == "add" then interactiveAdd()
        else
          local act, idx = id:match("(%a+)_(%d+)")
          idx = tonumber(idx)
          if idx and reactors[idx] then
            local r = reactors[idx]
            if act == "del" then 
              table.remove(reactors, idx)
              local data = {}
              for _, rct in ipairs(reactors) do table.insert(data, {rAddr=rct.proxy.address, inAddr=rct.gateIn.address, outAddr=rct.gateOut.address, auto=rct.auto}) end
              local f = io.open(SAVE_FILE, "w"); f:write(serialization.serialize(data)); f:close()
            elseif act == "auto" then r.auto = not r.auto
            elseif act == "chg" then pcall(r.proxy.chargeReactor); pcall(r.gateIn.setSignalLowFlow, 500000)
            elseif act == "pow" then 
              local s = tostring(r.info.status or ""):lower()
              if s == "running" or s == "online" then pcall(r.proxy.stopReactor); r.auto = false
              else pcall(r.proxy.activateReactor) end
            elseif act == "plus" or act == "minus" then
              local c = safeNum(r.gateOut); pcall(r.gateOut.setSignalLowFlow, act=="plus" and c+cfg.manualStep or math.max(cfg.initialFlow, c-cfg.manualStep))
            end
          end
        end
        render()
      end
    end
  end
end

gpu.setBackground(0); gpu.fill(1, 1, W, H, " "); gpu.setResolution(maxW, maxH)
