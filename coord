#pri = 10;
@ghost = false;
#stuck_check_delay = 30;
#stuck_timer = 0;
#ika = 0;
#is_turning = 0;
#border_cooldown = 0; 

if(automine);
    log("&c[Bot] Stopping...");
    unset(automine);
    keyup(forward);
    keyup(sprint);
    keyup(attack);
    cleardir();
    stop();
else;
    log("&a[Bot] Snake Mode Enabled");
    set(automine);

    if(DIRECTION == "N"); #target_yaw = 0;
    elseif(DIRECTION == "S"); #target_yaw = 180;
    elseif(DIRECTION == "W"); #target_yaw = 270;
    elseif(DIRECTION == "E"); #target_yaw = 90;
    endif;
    
    do;
        if(!automine); break; endif;
        key(attack);

        if(#border_cooldown > 0); dec(#border_cooldown); endif;

        if(#stuck_timer > 0);
            looks(%#target_yaw%,60,0.2);
            dec(#stuck_timer);
        else;
            looks(%#target_yaw%,0,0.1);

            if((#is_turning == 0) && (#border_cooldown == 0));
                if((ZPOS > 5975) || (ZPOS < -5975) || (XPOS > 5975) || (XPOS < -5975));
                    // 1. Остановка и подготовка
                    keyup(forward); keyup(sprint);
                    cleardir(); 
                    wait(5t);

                    // 2. Поворот камеры вбок для смещения змейки
                    if((#target_yaw == 0) || (#target_yaw == 270));
                        #side_yaw = %#target_yaw% + 90;
                    else;
                        #side_yaw = %#target_yaw% - 90;
                    endif;

                    looks(%#side_yaw%,0,1);
                    wait(10t);

                    // 3. Проход 7 блоков вбок (новая линия)
                    #start_x = XPOS;
                    #start_z = ZPOS;
                    keydown(forward);
                    do;
                        if(!automine); keyup(forward); break; endif;
                        #dx = XPOS - #start_x;
                        #dz = ZPOS - #start_z;
                        #dist_sq = (#dx * #dx) + (#dz * #dz);
                        key(attack);
                        wait(1t);
                    until(#dist_sq >= 49); 
                    keyup(forward);
                    wait(5t);

                    // 4. Разворот камеры на 180 градусов (смотрим "домой")
                    #target_yaw = %#target_yaw% + 180;
                    if(#target_yaw >= 360); #target_yaw = %#target_yaw% - 360; endif;
                    if(#target_yaw < 0); #target_yaw = %#target_yaw% + 360; endif;
                    
                    looks(%#target_yaw%,0,1);
                    wait(15t); // Даем камере довернуться

                    // 5. ТЕПЕРЬ СЕТХОМ И ХОМ (когда уже смотрим прямо обратно)
                    log("&e[Bot] Фиксация на новой линии...");
                    echo("/sethome"); 
                    wait(25t); 
                    echo("/home");
                    wait(30t); 

                    // 6. Запуск таймеров защиты
                    #border_cooldown = 100; // 5 сек не чекать границы
                    #is_turning = 20; 
                endif;
            else;
                if(#is_turning > 0); dec(#is_turning); endif;
            endif;
        endif;

        // ДВИЖЕНИЕ
        if(automine && #is_turning == 0);
            keydown(forward);
            keydown(sprint);
        endif;

        // АНТИСТАК
        inc(#ika);
        if(#ika > #stuck_check_delay);
            if((#last_x == XPOS) && (#last_z == ZPOS));
                if((#stuck_timer == 0) && (#is_turning == 0) && (#border_cooldown == 0));
                    #stuck_timer = 20;
                endif;
            endif;
            #last_x = XPOS;
            #last_z = ZPOS;
            #ika = 0;
        endif;

        wait(1t);
    while(automine);

    keyup(forward);
    keyup(sprint);
    keyup(attack);
    cleardir();
endif;
