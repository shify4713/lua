local component = require("component")
local event = require("event")
local serial = require("serialization")
local unicode = require("unicode")
local keyboard = require("keyboard")
local gpu = component.gpu
local m = component.modem
local PORT = 5347
local ADMIN = "LiwMorgan"
m.open(PORT)

local w, h = gpu.getResolution()
local splitX = math.floor(w * 0.70)
local last_stats = nil
local old_reactors = {}
local codes = {["0"]=0x000000, ["1"]=0x2244FF, ["2"]=0x00AA00, ["4"]=0xAA0000, ["6"]=0xFFAA00, ["7"]=0xAAAAAA, ["8"]=0x555555, ["9"]=0x5555FF, ["a"]=0x55FF55, ["b"]=0x33DBFF, ["c"]=0xFF5555, ["e"]=0xFFFF55, ["f"]=0xFFFFFF}

local function writeColor(x, y, text)
  local curX, i = x, 1
  gpu.setForeground(0xFFFFFF)
  while i <= unicode.len(text) do
    local char = unicode.sub(text, i, i)
    if char == "&" then
      local c = unicode.sub(text, i+1, i+1)
      if codes[c] then gpu.setForeground(codes[c]); i = i + 2
      else gpu.set(curX, y, char); curX = curX + 1; i = i + 1 end
    else gpu.set(curX, y, char); curX = curX + 1; i = i + 1 end
  end
end

local function wrapChat(text)
  local lines = {}
  while unicode.len(text) > (splitX - 1) do
    table.insert(lines, unicode.sub(text, 1, splitX - 1))
    text = unicode.sub(text, splitX, -1)
  end
  table.insert(lines, text)
  return lines
end

local function drawStatic()
  gpu.setBackground(0x212121)
  gpu.fill(1, 1, splitX, h, " ")
  gpu.setBackground(0x111111)
  gpu.fill(splitX + 1, 1, w - splitX, h, " ")
  gpu.setForeground(0x00FF99)
  for i=1, h do gpu.set(splitX, i, "┃") end
  writeColor(splitX+2, 6, "&6REACTORS")
  writeColor(splitX+2, 13, "&bVIS MATERIA")
end

local function updateUI(data)
  gpu.setBackground(0x111111)
  local e = data.energy
  gpu.fill(splitX+2, 1, w-splitX-1, 5, " ")
  writeColor(splitX+2, 1, "&eE: &f" .. e.cur)
  writeColor(splitX+2, 2, "&8Out: &b" .. e.gateOut .. "/t")
  writeColor(splitX+2, 3, "&8T: &7" .. math.floor(e.rawTarget/10^9) .. "b")
  
  gpu.setBackground(0x333333)
  gpu.set(splitX+2, 4, " [+] ")
  gpu.set(splitX+9, 4, " [-] ")
  gpu.setBackground(0x111111)

  for i=1, 5 do
    local r = data.reactors[i]
    local info = r.gen == "OFFLINE" and "&8OFFLINE" or ("&f"..r.gen.." &e"..r.fuel.."%")
    if old_reactors[i] ~= info then
      gpu.fill(splitX+5, 6+i, w-splitX-5, 1, " ")
      writeColor(splitX+2, 6+i, "&7"..i..": "..info)
      old_reactors[i] = info
    end
  end

  gpu.fill(splitX+2, 14, w-splitX-2, 2, " ")
  if data.items and data.items[1] then
    local it = data.items[1]
    writeColor(splitX+2, 14, "&fC: " .. it.val)
    writeColor(splitX+2, 15, "&7S: " .. (it.s >= 0 and "&a+" or "&c") .. it.s .. "/s")
  end
  last_stats = data
end

drawStatic()
m.broadcast(PORT, serial.serialize({cmd="PING"}))

while true do
  -- Получаем событие. Важно: модемное сообщение на планшете ловится так
  local res = {event.pull()}
  local evType = res[1]

  if evType == "modem_message" then
    -- res[6] - это заголовок (STATS или CHAT_MSG), res[7] - это сериализованные данные
    local header = res[6]
    local ok, data = pcall(serial.unserialize, tostring(res[7]))
    
    if ok and data then
      if header == "STATS" then
        updateUI(data)
      elseif header == "CHAT_MSG" then
        gpu.setBackground(0x212121)
        local full = string.format("&8%s %s &f%s: &7%s", data.t, data.tag, data.n, data.m)
        local wrapped = wrapChat(full)
        for _, line in ipairs(wrapped) do
          gpu.copy(1, 2, splitX-1, h-1, 0, -1)
          gpu.fill(1, h, splitX-1, 1, " ")
          writeColor(1, h, line)
        end
      end
    end

  elseif evType == "touch" then
    local x, y, user = res[3], res[4], res[6] or res[5]
    if x > splitX and y == 4 and last_stats then
      if user == ADMIN then
        local step = 10^9
        if keyboard.isShiftDown() then step = 100 * 10^9 
        elseif keyboard.isControlDown() then step = 50 * 10^9 end
        
        local val = (x < splitX+8) and last_stats.energy.rawTarget + step or last_stats.energy.rawTarget - step
        m.broadcast(PORT, serial.serialize({cmd="SET_ENERGY", val=val, user=user}))
      end
    end
  end
end
