local component = require("component")
local event = require("event")
local serial = require("serialization")
local unicode = require("unicode")
local keyboard = require("keyboard")
local gpu = component.gpu
local m = component.modem
local PORT = 5347
local ADMIN = "LiwMorgan"
m.open(PORT)

-- Настройка под монитор 4x2 (широкий формат)
-- 3 уровень позволяет высокие разрешения, выберем оптимальное для читаемости
local screenW, screenH = 120, 30 
gpu.setResolution(screenW, screenH)
local w, h = gpu.getResolution()

-- Линия раздела (панель управления сверху занимает 8 строк)
local splitY = 8
local last_stats = nil
local old_reactors = {}
local codes = {["0"]=0x000000, ["1"]=0x2244FF, ["2"]=0x00AA00, ["4"]=0xAA0000, ["6"]=0xFFAA00, ["7"]=0xAAAAAA, ["8"]=0x555555, ["9"]=0x5555FF, ["a"]=0x55FF55, ["b"]=0x33DBFF, ["c"]=0xFF5555, ["e"]=0xFFFF55, ["f"]=0xFFFFFF}

local function writeColor(x, y, text)
  local curX, i = x, 1
  gpu.setForeground(0xFFFFFF)
  while i <= unicode.len(text) do
    local char = unicode.sub(text, i, i)
    if char == "&" then
      local c = unicode.sub(text, i+1, i+1)
      if codes[c] then gpu.setForeground(codes[c]); i = i + 2
      else gpu.set(curX, y, char); curX = curX + 1; i = i + 1 end
    else gpu.set(curX, y, char); curX = curX + 1; i = i + 1 end
  end
end

local function wrapChat(text)
  local lines = {}
  -- Оставляем небольшие поля по бокам чата
  local maxW = w - 4
  while unicode.len(text) > maxW do
    table.insert(lines, unicode.sub(text, 1, maxW))
    text = unicode.sub(text, maxW + 1, -1)
  end
  table.insert(lines, text)
  return lines
end

local function drawStatic()
  -- Фон чата
  gpu.setBackground(0x181818)
  gpu.fill(1, splitY + 1, w, h - splitY, " ")
  -- Фон верхней панели
  gpu.setBackground(0x0F0F0F)
  gpu.fill(1, 1, w, splitY, " ")
  -- Тонкая линия-разделитель
  gpu.setForeground(0x333333)
  gpu.set(1, splitY, string.rep("─", w))
  
  writeColor(2, 2, "&6&lСИСТЕМА КОНТРОЛЯ РЕАКТОРОВ")
  writeColor(w - 25, 2, "&bVIS MATERIA STATUS")
end

local function updateUI(data)
  gpu.setBackground(0x0F0F0F)
  local e = data.energy
  
  -- Энергия и управление таргетом
  gpu.fill(2, 4, 70, 1, " ")
  writeColor(2, 4, "&eRF: &f" .. e.cur .. " &8| &7Target: &e" .. math.floor(e.rawTarget/10^9) .. "b")
  
  gpu.setBackground(0x222222)
  gpu.set(2, 5, "  [ + ]  ")
  gpu.set(12, 5, "  [ - ]  ")
  gpu.setBackground(0x0F0F0F)
  writeColor(23, 5, "&8Out: &b" .. e.gateOut .. " RF/t")

  -- Реакторы в одну строку горизонтально
  for i=1, 5 do
    local r = data.reactors[i]
    local status = r.gen == "OFFLINE" and "&8OFF" or ("&a" .. r.fuel .. "%")
    local xPos = 2 + (i-1) * 15
    gpu.fill(xPos, 7, 14, 1, " ")
    writeColor(xPos, 7, "&7R" .. i .. ": " .. status)
  end

  -- Предметы/Vis справа
  if data.items and data.items[1] then
    local it = data.items[1]
    gpu.fill(w - 25, 4, 24, 2, " ")
    writeColor(w - 25, 4, "&fКол-во: &e" .. it.val)
    local sStr = string.format("%.1f", it.s)
    writeColor(w - 25, 5, "&fСкорость: " .. (it.s >= 0 and "&a+" or "&c") .. sStr .. "/s")
  end
  last_stats = data
end

drawStatic()

while true do
  local res = {event.pull()}
  local evType = res[1]

  if evType == "modem_message" then
    local header = res[6]
    local ok, data = pcall(serial.unserialize, tostring(res[7]))
    if ok and data then
      if header == "STATS" then updateUI(data)
      elseif header == "CHAT_MSG" then
        gpu.setBackground(0x181818)
        local full = string.format("&8%s %s &f%s: &7%s", data.t, data.tag, data.n, data.m)
        local wrapped = wrapChat(full)
        for _, line in ipairs(wrapped) do
          -- Скроллинг только нижней зоны
          gpu.copy(1, splitY + 2, w, h - splitY - 1, 0, -1)
          gpu.fill(1, h, w, 1, " ")
          writeColor(3, h, line)
        end
      end
    end
  elseif evType == "touch" then
    local x, y, user = res[3], res[4], res[6] or res[5]
    -- Координаты кнопок + и -
    if y == 5 and x < 22 and last_stats and user == ADMIN then
      local step = 10^9
      if keyboard.isShiftDown() then step = 100 * 10^9 
      elseif keyboard.isControlDown() then step = 50 * 10^9 end
      local val = (x < 11) and last_stats.energy.rawTarget + step or last_stats.energy.rawTarget - step
      m.broadcast(PORT, serial.serialize({cmd="SET_ENERGY", val=val, user=user}))
    end
  end
end
