local component = require("component")
local event = require("event")
local serial = require("serialization")
local unicode = require("unicode")
local computer = require("computer")
local term = require("term")
local gpu = component.gpu

local m = component.modem
m.open(123)
local w, h = gpu.getResolution()
local splitX = math.floor(w * 0.65) 

local codes = {
  ["0"]=0x000000, ["1"]=0x2244FF, ["2"]=0x00AA00, ["3"]=0x008080, 
  ["4"]=0xAA0000, ["5"]=0xAA00AA, ["6"]=0xFFAA00, ["7"]=0xAAAAAA,
  ["8"]=0x555555, ["9"]=0x5555FF, ["a"]=0x55FF55, ["b"]=0x33DBFF, 
  ["c"]=0xFF5555, ["d"]=0xFF55FF, ["e"]=0xFFFF55, ["f"]=0xFFFFFF
}

local bg_color = 0x1A1A1A
local last_stats_data = nil

local function clean(t) return tostring(t or ""):gsub("&.", "") end

local function writeColor(x, y, text)
  local curX, i = x, 1
  gpu.setForeground(0xFFFFFF)
  while i <= unicode.len(text) do
    local char = unicode.sub(text, i, i)
    if char == "&" then
      local c = unicode.sub(text, i+1, i+1)
      if codes[c] then gpu.setForeground(codes[c]); i = i + 2
      else gpu.set(curX, y, char); curX = curX + 1; i = i + 1 end
    else gpu.set(curX, y, char); curX = curX + 1; i = i + 1 end
  end
end

local function drawSeparator()
  gpu.setForeground(0x555555)
  for i=1, h do gpu.set(splitX, i, "┃") end
end

local function drawStats(data)
  if data then last_stats_data = data end
  if not last_stats_data then return end
  gpu.setBackground(bg_color)
  gpu.fill(splitX + 1, 1, w - splitX, h, " ")
  writeColor(splitX + 2, 1, "&6Reactors")
  for i, r in ipairs(last_stats_data.reactors or {}) do
    writeColor(splitX + 2, 1 + i, string.format("&7R%d: &f%s &e%dC &%s%s%%", i, r.rf, r.t, r.crit and "c" or "a", r.f))
  end
  writeColor(splitX + 2, 7, "&bME Storage")
  for i, it in ipairs(last_stats_data.items or {}) do
    local nameClr = (it.lbl == "Vis") and "&d" or "&7"
    local speedStr = ""
    if it.s and it.s ~= 0 then
      local sClr = (it.s > 0) and "&a+" or "&c"
      speedStr = string.format(" &8(%s%s&8)", sClr, tostring(it.s))
    end
    writeColor(splitX + 2, 7 + i, string.format("%s%s: &f%s%s", nameClr, it.lbl, it.val, speedStr))
  end
end

local function pushChat(data, silent)
  local prefix = string.format("&8[%s] %s &a%s: ", data.t, data.tag, clean(data.n))
  local fullMsg = prefix .. "&f" .. data.m
  local words, lines, currentLine = {}, {}, ""
  for word in fullMsg:gmatch("%S+") do table.insert(words, word) end
  for _, word in ipairs(words) do
    local testLine = currentLine == "" and word or (currentLine .. " " .. word)
    if unicode.len(clean(testLine)) <= splitX - 2 then currentLine = testLine
    else table.insert(lines, currentLine); currentLine = word end
  end
  if currentLine ~= "" then table.insert(lines, currentLine) end
  local n = #lines
  gpu.copy(1, n + 1, splitX - 1, h - n, 0, -n)
  gpu.fill(1, h - n + 1, splitX - 1, n, " ")
  for i, line in ipairs(lines) do writeColor(1, h - n + i, line) end
  drawSeparator()
  if not silent then computer.beep(800, 0.05) end
end

gpu.setBackground(bg_color)
gpu.fill(1, 1, w, h, " ")
drawSeparator()
m.broadcast(123, serial.serialize({cmd="GET_HISTORY"}))

while true do
  local res = {event.pull()}
  local ev = res[1]
  
  if ev == "touch" and res[3] < splitX then
    gpu.setBackground(0x333333)
    gpu.fill(1, 1, splitX - 1, 1, " ")
    gpu.set(1, 1, "Chat: ")
    term.setCursor(7, 1)
    local msg = term.read()
    if msg and msg ~= "" then
      m.broadcast(123, serial.serialize({cmd="SEND_CHAT", msg=msg:gsub("\n","")}))
    end
    gpu.setBackground(bg_color)
    gpu.fill(1, 1, splitX - 1, 1, " ")
    drawSeparator()
    drawStats()
    
  elseif ev == "modem_message" then
    local msgType, raw = res[6], res[7]
    local ok, data = pcall(serial.unserialize, tostring(raw))
    if ok and data then
      if msgType == "STATS" then drawStats(data) 
      elseif msgType == "CHAT_MSG" then pushChat(data, false)
      elseif msgType == "CHAT_HIST" then pushChat(data, true) end
    end
  end
end
