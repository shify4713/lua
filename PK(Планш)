local component = require("component")
local event = require("event")
local serial = require("serialization")
local unicode = require("unicode")
local keyboard = require("keyboard")
local computer = require("computer")
local fs = require("filesystem")
local gpu = component.gpu
local m = component.modem

local PORT = 5347
local ADMIN = "LiwMorgan"
m.open(PORT)

local screenW, screenH = 120, 30 
gpu.setResolution(screenW, screenH)
local w, h = gpu.getResolution()

local splitY = 8
local last_stats = nil
local codes = {["0"]=0x000000, ["1"]=0x2244FF, ["2"]=0x00AA00, ["4"]=0xAA0000, ["6"]=0xFFAA00, ["7"]=0xAAAAAA, ["8"]=0x555555, ["9"]=0x5555FF, ["a"]=0x55FF55, ["b"]=0x33DBFF, ["c"]=0xFF5555, ["e"]=0xFFFF55, ["f"]=0xFFFFFF}

-- Таймер
local timer = { rem = 0, setH = 12, setM = 0, active = false, x = 82 }

-- [[ ЛОГИКА TPS ]]
local tpsHistory = {}
local tSlot = 1
local avgTPS = 20.0
for i=1, 10 do tpsHistory[i] = 20.0 end

local function getRealTimeMS()
  local f = fs.open("/tmp/timeFile","w")
  f:write("t")
  f:close()
  return fs.lastModified("/tmp/timeFile")
end

local lastRealTime = getRealTimeMS()
local lastUptime = computer.uptime()

local function updateTPS()
  local currentReal = getRealTimeMS()
  local currentUptime = computer.uptime()
  local deltaReal = currentReal - lastRealTime
  local deltaUptime = (currentUptime - lastUptime) * 1000
  if deltaReal > 0 then
    local currentTPS = (20000 * (deltaUptime / 1000)) / deltaReal
    if currentTPS > 20 then currentTPS = 20 end
    tpsHistory[tSlot] = currentTPS
    tSlot = (tSlot % 10) + 1
    local sum = 0
    for i=1, 10 do sum = sum + tpsHistory[i] end
    avgTPS = sum / 10
  end
  lastRealTime = currentReal
  lastUptime = currentUptime
end

-- [[ ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ]]

local function writeColor(x, y, text)
  local curX, i = x, 1
  gpu.setForeground(0xFFFFFF)
  while i <= unicode.len(text) do
    local char = unicode.sub(text, i, i)
    if char == "&" then
      local c = unicode.sub(text, i+1, i+1)
      if codes[c] then gpu.setForeground(codes[c]); i = i + 2
      else gpu.set(curX, y, char); curX = curX + 1; i = i + 1 end
    else gpu.set(curX, y, char); curX = curX + 1; i = i + 1 end
  end
end

local function writeSmart(x, y, text, limit)
  local clean = text:gsub("&.", "")
  local len = unicode.len(clean)
  writeColor(x, y, text)
  if limit and limit > len then
    gpu.set(x + len, y, string.rep(" ", limit - len))
  end
end

local function formatTimer(seconds)
  local hours = math.floor(seconds / 3600)
  local mins = math.floor((seconds % 3600) / 60)
  local secs = math.floor(seconds % 60)
  return string.format("%02d:%02d:%02d", hours, mins, secs)
end

local function drawBox(x, y, width, height, title, color)
  gpu.setForeground(color or 0x444444)
  gpu.set(x, y, "╔" .. string.rep("═", width-2) .. "╗")
  for i=1, height-2 do 
    gpu.set(x, y+i, "║") 
    gpu.set(x+width-1, y+i, "║") 
  end
  gpu.set(x, y+height-1, "╚" .. string.rep("═", width-2) .. "╝")
  if title then writeColor(x+2, y, "&7[ &f" .. title .. " &7]") end
end

local function wrapChat(text)
  local maxW = w - 8
  local lines = {}
  while unicode.len(text) > maxW do
    table.insert(lines, unicode.sub(text, 1, maxW))
    text = unicode.sub(text, maxW + 1, -1)
  end
  table.insert(lines, text)
  return lines
end

local function drawTimerUI()
  gpu.setBackground(0x0F0F0F)
  drawBox(timer.x, 2, 38, 6, "ТАЙМЕР ОБРАТНОГО ОТСЧЕТА", 0xFFAA00)
  if not timer.active then
    writeColor(timer.x+4, 3, "&e▲ ЧАСЫ  &b▲ МИН")
    writeSmart(timer.x+4, 4, string.format("&f   %02d    :    %02d", timer.setH, timer.setM), 20)
    writeColor(timer.x+4, 5, "&e▼       &b▼")
    gpu.setBackground(0x22AA22)
    gpu.setForeground(0xFFFFFF)
    gpu.set(timer.x+26, 4, " START ")
  else
    writeSmart(timer.x+4, 3, "&aСТАТУС: АКТИВЕН", 20)
    writeSmart(timer.x+4, 5, "&fОСТАЛОСЬ: &6" .. formatTimer(timer.rem), 20)
    gpu.setBackground(0xAA2222)
    gpu.setForeground(0xFFFFFF)
    gpu.set(timer.x+26, 4, "  STOP ")
  end
  gpu.setBackground(0x0F0F0F)
end

local function drawStatic()
  gpu.setBackground(0x111111)
  gpu.fill(1, 1, w, h, " ")
  
  -- Верхняя панель (без версии)
  gpu.setBackground(0x3366FF)
  gpu.fill(1, 1, w, 1, " ")
  gpu.setForeground(0xFFFFFF)
  gpu.set(2, 1, "REACTOR CONTROL SYSTEM | ADMIN: " .. ADMIN)

  gpu.setBackground(0x0F0F0F)
  drawBox(1, 2, 80, 6, "МОНИТОРИНГ СИСТЕМ", 0x3366FF)
  
  gpu.setForeground(0x3366FF)
  gpu.set(1, splitY, string.rep("━", w))
  drawTimerUI()
end

local function updateUI(data)
  gpu.setBackground(0x0F0F0F)
  local e = data.energy
  
  -- Реакторы (убрал #)
  for i=1, 5 do
    local r = data.reactors[i]
    local xOff = 3 + (i-1)*15
    local status = r.gen == "OFFLINE" and "&8OFFLINE" or ("&a" .. r.fuel .. "%")
    writeSmart(xOff, 3, "&bR" .. i .. ": " .. status, 14)
  end
  
  -- TPS
  local tpsColor = (avgTPS < 15 and "&c" or "&a")
  writeSmart(3, 4, string.format("&7SERVER: %s[%.2f TPS] &8| &7AVG: &f%.2f", tpsColor, tpsHistory[(tSlot-2)%10+1], avgTPS), 50)
  
  -- Энергия (убрал ?)
  writeSmart(3, 5, "&e⚡ ENERGY: &f" .. e.cur .. " &7/ &e" .. math.floor(e.rawTarget/10^9) .. "b RF", 50)
  
  -- Кнопки
  gpu.setBackground(0x333333)
  gpu.setForeground(0x55FF55)
  gpu.set(3, 6, " [ + ] ") 
  gpu.setForeground(0xFF5555)
  gpu.set(12, 6, " [ - ] ")
  
  gpu.setBackground(0x0F0F0F)
  writeSmart(24, 6, "&8GATE OUTPUT: &b" .. e.gateOut .. " RF/t", 30)

  last_stats = data
end

drawStatic()

-- [[ ГЛАВНЫЙ ЦИКЛ ]]
while true do
  local startLoop = computer.uptime()
  local res = {event.pull(0.5)} 
  updateTPS()

  local now = computer.uptime()
  local diff = now - startLoop

  if timer.active then
    timer.rem = timer.rem - diff
    if timer.rem <= 0 then 
      timer.rem = 0 timer.active = false computer.beep(1000, 0.2)
    end
    drawTimerUI()
  end

  local evType = res[1]
  if evType == "modem_message" then
    local header = res[6]
    local ok, data = pcall(serial.unserialize, tostring(res[7]))
    if ok and data then
      if header == "STATS" then 
        updateUI(data)
      elseif header == "CHAT_MSG" then
        gpu.setBackground(0x111111)
        local message = tostring(data.m)
        -- Удаляем знак "!" из начала
        if unicode.sub(message, 1, 1) == "!" then message = unicode.sub(message, 2) end
        
        local full = string.format("&b[%s] &f%s &8» &7%s", data.tag, data.n, message)
        local wrapped = wrapChat(full)
        for _, line in ipairs(wrapped) do
          gpu.copy(1, splitY + 1, w, h - splitY, 0, -1)
          gpu.fill(1, h, w, 1, " ")
          writeColor(5, h, line)
        end
      end
    end
  elseif evType == "touch" then
    local x, y, user = res[3], res[4], res[6] or res[5]
    if user == ADMIN then
      if x >= timer.x and x <= timer.x + 38 and y >= 2 and y <= 7 then
        if not timer.active then
          if y == 3 then
            if x < timer.x + 12 then timer.setH = (timer.setH + 1) % 25
            else timer.setM = (timer.setM + 5) % 60 end
          elseif y == 5 then
            if x < timer.x + 12 then timer.setH = (timer.setH - 1) % 25
            else timer.setM = (timer.setM - 5) % 60 end
          elseif y == 4 and x >= timer.x + 24 then
            timer.rem = (timer.setH * 3600) + (timer.setM * 60)
            if timer.rem > 0 then timer.active = true end
          end
        elseif y == 4 and x >= timer.x + 24 then timer.active = false end
        drawTimerUI()
      end
      if y == 6 and x < 25 and last_stats then
        local step = keyboard.isShiftDown() and 100 * 10^9 or 10^9
        local val = (x < 10) and last_stats.energy.rawTarget + step or last_stats.energy.rawTarget - step
        m.broadcast(PORT, serial.serialize({cmd="SET_ENERGY", val=val, user=user}))
      end
    end
  end
  
  if not evType and last_stats then updateUI(last_stats) end
end
