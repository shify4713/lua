local component = require("component")
local event = require("event")
local serial = require("serialization")
local unicode = require("unicode")
local computer = require("computer")
local gpu = component.gpu
local m = component.modem

-- [[ НАСТРОЙКИ ]]
local PORT = 5347
local ADMIN = "LiwMorgan"
local MAX_TIME = 86400
local chat_history, log_history = {}, {}
local max_chat_lines = 19
local splitY = 10
local last_ui_update = 0

local sensor = component.isAvailable("openperipheral_sensor") and component.openperipheral_sensor 
              or (component.isAvailable("sensor") and component.sensor or nil)

m.open(PORT)
gpu.setResolution(120, 30)
local w, h = gpu.getResolution()

local timer = { rem = MAX_TIME, set = MAX_TIME, active = false, x = 98, y = 3 }
local known_players = {}
local last_stats = nil
local codes = {["0"]=0x000000, ["1"]=0x2244FF, ["2"]=0x00AA00, ["4"]=0xAA0000, ["6"]=0xFFAA00, ["7"]=0xAAAAAA, ["8"]=0x555555, ["9"]=0x5555FF, ["a"]=0x55FF55, ["b"]=0x33DBFF, ["c"]=0xFF5555, ["e"]=0xFFFF55, ["f"]=0xFFFFFF}

-- [[ СЛУЖЕБНЫЕ ФУНКЦИИ ]]
local function writeColor(x, y, text)
  local curX, i = x, 1
  while i <= unicode.len(text) do
    local char = unicode.sub(text, i, i)
    if char == "&" then
      local c = unicode.sub(text, i+1, i+1)
      if codes[c] then gpu.setForeground(codes[c]); i = i + 2
      else gpu.set(curX, y, char); curX = curX + 1; i = i + 1 end
    else gpu.set(curX, y, char); curX = curX + 1; i = i + 1 end
  end
end

local function addLog(name, status)
  local color = status == "IN" and "&a+" or "&c-"
  table.insert(log_history, 1, string.format("%s &f%s", color, unicode.sub(name, 1, 10)))
  if #log_history > 5 then table.remove(log_history) end
end

local function addChat(msg)
  table.insert(chat_history, msg)
  if #chat_history > max_chat_lines then table.remove(chat_history, 1) end
  gpu.setBackground(0x111111)
  gpu.fill(2, splitY + 1, w - 2, h - splitY, " ")
  local startY = h - 1
  for i = #chat_history, 1, -1 do
    if startY > splitY then writeColor(3, startY, chat_history[i]); startY = startY - 1 end
  end
end

-- [[ GUI ]]
local function drawStatic()
  gpu.setBackground(0x111111); gpu.fill(1, 1, w, h, " ")
  gpu.setBackground(0x3366FF); gpu.fill(1, 1, w, 1, " ")
  gpu.setForeground(0xFFFFFF); gpu.set(2, 1, "CORE SYSTEM v3.3 | ADMIN: " .. ADMIN)
  
  gpu.setBackground(0x0F0F0F)
  gpu.setForeground(0x3366FF)
  gpu.set(1, 2, "╔" .. string.rep("═", w-2) .. "╗")
  for i=3, 9 do gpu.set(1, i, "║"); gpu.set(w, i, "║") end
  gpu.set(1, 10, "╚" .. string.rep("═", w-2) .. "╝")
  
  for i=3, 8 do gpu.set(78, i, "│"); gpu.set(96, i, "│") end
  
  writeColor(83, 2, "&7[ &fЛОГИ &7]")
  writeColor(101, 2, "&7[ &fТАЙМЕР &7]")
end

local function updateTimerUI()
  local tx, ty = timer.x, timer.y
  gpu.setBackground(0x0F0F0F)
  gpu.setBackground(0x333333)
  writeColor(tx, ty, " &a+ &0") 
  writeColor(tx+4, ty, " &c- &0")
  
  if not timer.active then
    gpu.setBackground(0x22AA22)
    gpu.set(tx+9, ty, " START ")
    gpu.setBackground(0x0F0F0F)
    local h, m = math.floor(timer.set/3600), math.floor((timer.set%3600)/60)
    writeColor(tx + 1, ty + 2, "&7ЗАДАНО:") 
    writeColor(tx + 3, ty + 3, string.format("&e%02d:%02d", h, m))
  else
    gpu.setBackground(0xAA2222)
    gpu.set(tx+9, ty, " STOP  ") 
    gpu.setBackground(0x0F0F0F)
    local h, m = math.floor(timer.rem/3600), math.floor((timer.rem%3600)/60)
    writeColor(tx + 1, ty + 2, "&6ВРЕМЯ:") 
    writeColor(tx + 3, ty + 3, string.format("&f%02d:%02d", h, m))
  end
end

local function updateSensorsUI()
  gpu.setBackground(0x0F0F0F)
  local current, players_str = {}, ""
  if sensor then
    local ok, raw = pcall(function() return sensor.getPlayers() or sensor.scan(16) end)
    if ok and raw then
      for _, p in ipairs(raw) do
        current[p.name] = true
        players_str = players_str .. p.name .. ", "
        if not known_players[p.name] then addLog(p.name, "IN") end
      end
      for name, _ in pairs(known_players) do
        if not current[name] then addLog(name, "OUT") end
      end
      known_players = current
    end
  end
  for i=1, 5 do
    gpu.set(80, 3+i, string.rep(" ", 15))
    if log_history[i] then writeColor(80, 3+i, log_history[i]) end
  end
  players_str = players_str ~= "" and players_str:sub(1, -3) or "Никого"
  writeColor(3, 9, "&bРЯДОМ: &f" .. unicode.sub(players_str, 1, 70) .. string.rep(" ", 10))
end

local function updateStatsUI(data)
  if not data then return end
  gpu.setBackground(0x0F0F0F)
  local rStr = ""
  for i=1, 5 do
    local r = data.reactors[i]
    if r then
      local col = (r.gen == "OFFLINE" and "&8" or "&a")
      rStr = rStr .. string.format("&7R%d:%s%s  ", i, col, (r.gen == "OFFLINE" and "OFF" or (tonumber(r.fuel) or 0).."%"))
    end
  end
  writeColor(3, 4, rStr .. string.rep(" ", 5))
  writeColor(3, 6, string.format("&eENERGY: &f%s &7/ &e%sb RF", data.energy.cur or 0, math.floor((data.energy.rawTarget or 1)/10^9)) .. string.rep(" ", 5))
  local visStr = "&7VIS: &8НЕТ ДАННЫХ"
  if data.items then
    for _, it in ipairs(data.items) do
      if it.id and it.id:find("Vis_materia") then
        visStr = string.format("&7VIS: &b%s &8(&f%.1f/s&8)", it.count, it.itemsPerSecond or 0)
        break
      end
    end
  end
  writeColor(3, 7, visStr .. string.rep(" ", 15))
  writeColor(45, 7, "&8GATE: &b" .. (data.energy.gateOut or 0) .. " RF/t")
end

-- [[ ЦИКЛ ]]
drawStatic()
updateTimerUI()

while true do
  local startLoop = computer.uptime()
  local res = {event.pull(0.1)}

  if timer.active then
    timer.rem = timer.rem - (computer.uptime() - startLoop)
    if timer.rem <= 0 then 
      timer.rem = 0; timer.active = false; computer.beep(1200, 0.5)
      addChat("&7[SYSTEM] &eТаймер завершен!")
    end
    updateTimerUI()
  end

  if res[1] == "modem_message" then
    local ok, data = pcall(serial.unserialize, tostring(res[7]))
    if ok and data then
      if res[6] == "STATS" then 
        updateStatsUI(data)
        last_stats = data
      elseif res[6] == "CHAT_MSG" then
        local rawMsg = tostring(data.m or "")
        -- ПРОВЕРКА: Если сообщение начинается с !, то это Глобал
        local isGlobal = (rawMsg:sub(1,1) == "!")
        local tag = isGlobal and "&6[G]" or "&7[L]"
        
        -- Убираем ! из текста для красоты, если он там был
        local cleanMsg = isGlobal and rawMsg:sub(2) or rawMsg
        
        addChat(string.format("%s &b%s&8: &7%s", tag, data.n or "User", cleanMsg))
      end
    end
  elseif res[1] == "touch" then
    local x, y = res[3], res[4]
    if y == timer.y then
      if x >= timer.x and x <= timer.x+3 then 
        timer.set = math.min(MAX_TIME, timer.set + 3600)
        if timer.active then timer.rem = timer.rem + 3600 end
      elseif x >= timer.x+4 and x <= timer.x+7 then 
        timer.set = math.max(0, timer.set - 3600)
        if timer.active then timer.rem = math.max(0, timer.rem - 3600) end
      elseif x >= timer.x+9 and x <= timer.x+16 then 
        timer.active = not timer.active
        if timer.active then timer.rem = timer.set end
      end
    end
    updateTimerUI()
  end

  if computer.uptime() - last_ui_update > 1 then
    updateSensorsUI()
    if last_stats then updateStatsUI(last_stats) end
    last_ui_update = computer.uptime()
  end
end
